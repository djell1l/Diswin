<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:DiscordNative.App.Services">

    <services:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <services:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" />
    <services:InvertedBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
    <services:StringToImageSourceConverter x:Key="StringToImageSourceConverter" />
    <services:ChannelTypeToGlyphConverter x:Key="ChannelTypeToGlyphConverter" />

    <!-- Style de carte translucide utilisé pour la page Paramètres et les panneaux flottants,
         cohérent avec l'effet "fond custom" façon Files -->
    <Style x:Key="GlassCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ToolTip style Discord authentique (fond sombre #111214, texte blanc, coins arrondis, bordure discrète) -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#111214" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#2B2D31" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
