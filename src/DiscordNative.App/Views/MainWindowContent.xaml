                                <ComboBoxItem Tag="online">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="10" Height="10" Fill="#23A55A" VerticalAlignment="Center" />
                                        <TextBlock Text="En ligne" VerticalAlignment="Center" />
