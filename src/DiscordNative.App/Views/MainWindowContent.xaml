                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#35373C" Margin="0,0,14,0">
                                            <FontIcon Glyph="&#xE77B;" FontSize="18" Foreground="#5865F2" HorizontalAlignment="Center" VerticalAlignment="Center" />
