                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Retour" FontSize="13" Padding="14,8" CornerRadius="6"
                                        Background="Transparent" BorderThickness="0" Foreground="White"
                                        Click="OnBackToTemplatesStageClicked" />
                                <Button x:Name="JoinServerSubmitBtn" Grid.Column="1" Content="Rejoindre le serveur" FontSize="13" FontWeight="Bold"
                                        HorizontalAlignment="Right" Padding="20,8" CornerRadius="6"
                                        Background="#5865F2" Foreground="White" BorderThickness="0"
                                        Click="OnSubmitJoinServerClicked" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

