<UserControl
    x:Class="DiscordNative.App.Views.MainWindowContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DiscordNative.Protocol.Models"
    xmlns:vm="using:DiscordNative.App.ViewModels"
    xmlns:controls="using:DiscordNative.App.Controls">

    <Grid x:Name="RootLayoutGrid">
        <controls:BackgroundImageHost x:Name="BackgroundHost" />

        <!-- Ancrage pour le grand sélecteur d'émojis de réactions -->
        <Border x:Name="ReactionFlyoutAnchor" Visibility="Collapsed">
            <FlyoutBase.AttachedFlyout>
                <Flyout x:Name="ReactionFullEmojiFlyout" Placement="RightEdgeAlignedTop">
                    <Flyout.FlyoutPresenterStyle>
                        <Style TargetType="FlyoutPresenter">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="CornerRadius" Value="12" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="MaxWidth" Value="440" />
                            <Setter Property="MaxHeight" Value="480" />
                        </Style>
                    </Flyout.FlyoutPresenterStyle>
                    <controls:DiscordEmojiPickerControl x:Name="ReactionFullEmojiPicker"
                                                       EmojiSelected="OnReactionFullEmojiSelected" />
                </Flyout>
            </FlyoutBase.AttachedFlyout>
        </Border>

        <!-- Ancrage pour les résultats de recherche de messages dans le salon -->
        <Border x:Name="ChannelSearchFlyoutAnchor" Visibility="Collapsed">
            <FlyoutBase.AttachedFlyout>
                <Flyout x:Name="ChannelSearchResultsFlyout" Placement="BottomEdgeAlignedRight">
                    <Border Width="380" Background="#1E1F22" BorderBrush="#2B2D31" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Résultats de recherche" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ChannelSearchResultsCountText, Mode=OneWay}"
                                           FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                            </Grid>
                            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsSearchingChannel, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.ChannelSearchResults, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:DiscordMessage">
                                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                    Background="#2B2D31" BorderBrush="#383A40" BorderThickness="1"
                                                    Padding="10" CornerRadius="6" Tag="{x:Bind}" Click="OnJumpToSearchResultClicked" Margin="0,0,0,6">
                                                <Grid RowSpacing="4">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{x:Bind Author.DisplayName}" FontWeight="SemiBold" FontSize="12" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind ShortTime}" FontSize="10" Opacity="0.5" />
                                                    </Grid>
                                                    <TextBlock Grid.Row="1" Text="{x:Bind Content}" FontSize="12" TextWrapping="Wrap" Opacity="0.9" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Flyout>
            </FlyoutBase.AttachedFlyout>
        </Border>


        <!-- Splash Screen animé au démarrage façon Discord -->
        <Grid x:Name="StartupSplash" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              Canvas.ZIndex="1000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                <Border x:Name="SplashLogoBorder" Width="96" Height="96" CornerRadius="28">
                    <Border.Background>
                        <ImageBrush ImageSource="ms-appx:///Assets/AppIcon.png" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="Diswin" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="SplashStatusText" Text="Vérification des mises à jour..." FontSize="13" Opacity="0.7" HorizontalAlignment="Center" />
                </StackPanel>
                <ProgressBar IsIndeterminate="True" Width="200" HorizontalAlignment="Center" CornerRadius="4" />
            </StackPanel>
        </Grid>

        <Grid Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" x:Name="AppTitleBar" Background="Transparent" />

            <!-- Bannière de notification et mise à jour automatique WinUI 3 InfoBar -->
            <InfoBar Grid.Row="1" x:Name="UpdateInfoBar"
                     IsOpen="False"
                     Severity="Informational"
                     Title="Mise à jour disponible"
                     Message="Une nouvelle version de Diswin est disponible."
                     CornerRadius="8"
                     Margin="12,0,12,8">
                <InfoBar.ActionButton>
                    <Button x:Name="ApplyUpdateButton" Content="Mettre à jour maintenant" Click="OnApplyUpdateClicked" Style="{StaticResource AccentButtonStyle}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 0. Liste des serveurs -->
                <Grid Grid.Column="0" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="0">
                        <!-- Bouton de mise à jour en haut à gauche façon Discord (affiché uniquement si une MàJ est disponible) -->
                        <Button x:Name="TopLeftUpdateButton"
                                Visibility="Collapsed"
                                Margin="12,12,12,0" Width="48" Height="48" CornerRadius="24" Padding="0"
                                Background="#23A55A" Foreground="White" BorderThickness="0"
                                Click="OnTopLeftUpdateClicked"
                                ToolTipService.ToolTip="Mise à jour disponible ! Cliquez pour mettre à jour et redémarrer">
                            <FontIcon Glyph="&#xE896;" FontSize="20" Foreground="White" />
                        </Button>

                        <Button Margin="12,12,12,4" Width="48" Height="48" CornerRadius="16" Padding="0"
                                Click="OnFriendsClicked" ToolTipService.ToolTip="Amis et messages privés">
                            <Grid Width="48" Height="48">
                                <Border Width="48" Height="48" CornerRadius="16">
                                    <Border.Background>
                                        <ImageBrush ImageSource="ms-appx:///Assets/AppIcon.png" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <!-- Badge de notification DMs non lus en bas à droite -->
                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,-4,-4"
                                        Background="#DA373C"
                                        BorderBrush="#1E1F22" BorderThickness="3"
                                        CornerRadius="9" MinWidth="18" Height="18" Padding="4,0"
                                        Visibility="{x:Bind ViewModel.HasDmMentions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{x:Bind ViewModel.DmMentionCountText, Mode=OneWay}"
                                               Foreground="White" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <ListView Grid.Row="1" x:Name="GuildList"
                              ItemsSource="{x:Bind ViewModel.DisplayGuilds, Mode=OneWay}"
                              SelectionMode="Single"
                              SelectionChanged="OnGuildSelected"
                              Padding="0,4,0,0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="MinHeight" Value="48" />
                                <Setter Property="MinWidth" Value="72" />
                                <Setter Property="Width" Value="72" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Center"
                                                              Margin="0"
                                                              Padding="0" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DiscordGuild">
                                <Grid Height="48">
                                    <!-- 1. CAS DOSSIER DE SERVEURS (IsFolder == true) -->
                                    <Grid Visibility="{x:Bind IsFolder, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                          ToolTipService.ToolTip="{x:Bind FolderTooltip, Mode=OneWay}">
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Marquer tout le dossier comme lu" Tag="{x:Bind}" Click="OnMarkFolderReadClicked">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FB;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Développer / Réduire le dossier" Tag="{x:Bind}" Click="OnToggleFolderFromMenuClicked">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xED43;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Dissoudre le dossier" Tag="{x:Bind}" Click="OnDissolveFolderClicked">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Copier l'identifiant du dossier" Tag="{x:Bind}" Click="OnCopyFolderIdClicked">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>

                                        <!-- Pilule blanche sur le bord gauche si le dossier contient des non-lus -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Width="8" Height="8" Margin="-4,0,0,0" CornerRadius="0,4,4,0" Background="White"
                                                Visibility="{x:Bind FolderHasUnread, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <!-- Conteneur d'icône 48x48 du dossier -->
                                        <Grid Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              PointerEntered="OnAvatarPointerEntered" PointerExited="OnAvatarPointerExited">
                                            <Rectangle RadiusX="16" RadiusY="16">
                                                <Rectangle.Fill>
                                                    <SolidColorBrush Color="#2B2D31" />
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <FontIcon Glyph="{x:Bind FolderIconGlyph, Mode=OneWay}" FontSize="22" Foreground="#5865F2"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />

                                            <!-- Badge décompte serveurs en haut à droite -->
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,-3,-3,0" Background="#111214" BorderBrush="#1E1F22" BorderThickness="1.5"
                                                    CornerRadius="7" MinWidth="16" Height="16" Padding="3,0">
                                                <TextBlock Text="{x:Bind FolderChildCountText, Mode=OneWay}" FontSize="9" FontWeight="Bold" Foreground="#DBDEE1"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Badge Rouge de MENTION sur le dossier si des mentions sont présentes -->
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Margin="0,0,-4,-4" Background="#DA373C" BorderBrush="#1E1F22" BorderThickness="3"
                                                    CornerRadius="9" MinWidth="18" Height="18" Padding="4,0"
                                                    Visibility="{x:Bind FolderHasMentions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{x:Bind FolderMentionCountText, Mode=OneWay}"
                                                           Foreground="White" FontSize="11" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <!-- 2. CAS SERVEUR ORDINAIRE (IsNotFolder == true) -->
                                    <Grid Visibility="{x:Bind IsNotFolder, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                          ToolTipService.ToolTip="{x:Bind Name}"
                                          PointerEntered="OnAvatarPointerEntered" PointerExited="OnAvatarPointerExited">
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Marquer comme lu" Click="OnMarkGuildReadClicked">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FB;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Créer un dossier de serveurs" Tag="{x:Bind}" Click="OnCreateFolderFromGuildMenuClicked">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xED43;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Inviter des personnes" Click="OnInvitePeopleFromGuildMenuClicked">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72D;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSubItem Text="Mettre en sourdine le serveur">
                                                    <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE74F;" /></MenuFlyoutSubItem.Icon>
                                                    <MenuFlyoutItem Text="Pendant 15 minutes" Tag="15m" Click="OnMuteDurationClicked" />
                                                    <MenuFlyoutItem Text="Pendant 1 heure" Tag="1h" Click="OnMuteDurationClicked" />
                                                    <MenuFlyoutItem Text="Pendant 3 heures" Tag="3h" Click="OnMuteDurationClicked" />
                                                    <MenuFlyoutItem Text="Pendant 8 heures" Tag="8h" Click="OnMuteDurationClicked" />
                                                    <MenuFlyoutItem Text="Pendant 24 heures" Tag="24h" Click="OnMuteDurationClicked" />
                                                    <MenuFlyoutItem Text="Jusqu'à réactivation" Tag="forever" Click="OnMuteDurationClicked" />
                                                </MenuFlyoutSubItem>
                                                <MenuFlyoutSubItem Text="Paramètres de notification">
                                                    <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xEA8F;" /></MenuFlyoutSubItem.Icon>
                                                    <MenuFlyoutItem Text="Tous les messages" Tag="all" Click="OnNotificationSettingClicked" />
                                                    <MenuFlyoutItem Text="Seulement les mentions @everyone et @here" Tag="mentions" Click="OnNotificationSettingClicked" />
                                                    <MenuFlyoutItem Text="Rien" Tag="nothing" Click="OnNotificationSettingClicked" />
                                                </MenuFlyoutSubItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Copier le nom" Click="OnCopyGuildNameClicked">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Copier l'identifiant" Click="OnCopyGuildIdClicked">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Quitter le serveur" Click="OnLeaveGuildClicked" Foreground="#FF453A">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE89B;" Foreground="#FF453A" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>

                                        <!-- Connecteur visuel discret si le serveur est dans un dossier ouvert -->
                                        <Border HorizontalAlignment="Left" Width="2" Height="36" Background="#383A40" Margin="4,0,0,0" CornerRadius="1"
                                                Visibility="{x:Bind IsInFolder, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <!-- Pilule blanche sur le bord gauche (Non lu = petit point 8px, Survol = 20px, Sélectionné = barre 40px) -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Width="8" Height="{x:Bind IndicatorHeight, Mode=OneWay}"
                                                Margin="-4,0,0,0"
                                                CornerRadius="0,4,4,0" Background="White"
                                                Visibility="{x:Bind HasUnreadOrSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <!-- Conteneur d'icône du serveur centré 48x48 -->
                                        <Grid Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Rectangle Fill="{ThemeResource ControlFillColorSecondaryBrush}" RadiusX="16" RadiusY="16" />
                                            <Rectangle RadiusX="16" RadiusY="16" Visibility="{x:Bind HasIcon, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Rectangle.Fill>
                                                    <ImageBrush ImageSource="{x:Bind IconUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <TextBlock Text="{x:Bind Initials}" HorizontalAlignment="Center"
                                                       Visibility="{x:Bind ShowInitials, Converter={StaticResource BoolToVisibilityConverter}}"
                                                       VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" />

                                            <!-- Badge Vocal en haut à droite (haut-parleur sur fond noir) -->
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,-3,-3,0"
                                                    Background="#111214"
                                                    BorderBrush="#1E1F22" BorderThickness="2"
                                                    CornerRadius="9" Width="18" Height="18"
                                                    Visibility="{x:Bind HasVoiceBadge, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    ToolTipService.ToolTip="Membres connectés en vocal">
                                                <FontIcon Glyph="&#xE767;" FontSize="9" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Badge Stream en haut à droite (écran sur fond noir si stream en cours) -->
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,-3,-3,0"
                                                    Background="#111214"
                                                    BorderBrush="#1E1F22" BorderThickness="2"
                                                    CornerRadius="9" Width="18" Height="18"
                                                    Visibility="{x:Bind HasStreamBadge, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    ToolTipService.ToolTip="Partage d'écran / Stream en cours">
                                                <FontIcon Glyph="&#xE7F4;" FontSize="9" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Badge Rouge de MENTION en bas à droite (exactement comme Discord officiel) -->
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Margin="0,0,-4,-4"
                                                    Background="#DA373C"
                                                    BorderBrush="#1E1F22" BorderThickness="3"
                                                    CornerRadius="9" MinWidth="18" Height="18" Padding="4,0"
                                                    Visibility="{x:Bind HasMentions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    ToolTipService.ToolTip="{x:Bind MentionTooltip, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind MentionCountText, Mode=OneWay}"
                                                           Foreground="White" FontSize="11" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Bouton Ajouter un serveur (+) -->
                    <Button Grid.Row="2" Margin="12,4,12,0" Width="48" Height="48" CornerRadius="24"
                            Click="OnAddServerClicked" ToolTipService.ToolTip="Ajouter un serveur">
                        <FontIcon Glyph="&#xE710;" FontSize="18" Foreground="#23A55A" />
                    </Button>

                    <!-- Bouton Découverte de serveurs publics (Boussole Discord) -->
                    <Grid Grid.Row="3" Margin="0,4,0,0">
                        <!-- Pilule indicatrice blanche sur le bord gauche -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                                Width="8" Height="40" Margin="-4,0,0,0" CornerRadius="0,4,4,0" Background="White"
                                Visibility="{x:Bind ViewModel.DiscoveryPillVisibility, Mode=OneWay}" />

                        <Button Margin="12,0,12,0" Width="48" Height="48" CornerRadius="16"
                                Background="{x:Bind ViewModel.DiscoveryCompassBackground, Mode=OneWay}"
                                Click="OnOpenDiscoveryClicked" ToolTipService.ToolTip="Découvrir des serveurs publics">
                            <FontIcon Glyph="&#xE774;" FontSize="18"
                                      Foreground="{x:Bind ViewModel.DiscoveryCompassForeground, Mode=OneWay}" />
                        </Button>
                    </Grid>

                    <Button Grid.Row="4" Margin="12" Width="48" Height="48" CornerRadius="16"
                            Click="OnSettingsClicked" ToolTipService.ToolTip="Paramètres">
                        <FontIcon Glyph="&#xE713;" />
                    </Button>
                </Grid>

                <!-- 1. Salons & DM -->
                <Grid Grid.Column="1" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Haut gauche : Titre de serveur & Recherche de salons (Quick Switcher) -->
                    <StackPanel Grid.Row="0" Margin="8,6,8,8" Spacing="6">
                        <!-- En-tête de Serveur Interactif avec Menu Déroulant officiel Discord -->
                        <Button x:Name="ServerHeaderButton"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Padding="12,10" CornerRadius="8" Background="Transparent" BorderThickness="0"
                                Visibility="{x:Bind ViewModel.ShowingGuildChannels, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.SelectedGuildName, Mode=OneWay}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <!-- Badge Boost du serveur si présent -->
                                    <Border Background="#33F47FFF" CornerRadius="4" Padding="4,1" VerticalAlignment="Center"
                                            Visibility="{x:Bind ViewModel.HasSelectedGuildBoosts, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE735;" FontSize="10" Foreground="#F47FFF" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedGuildBoostBadge, Mode=OneWay}" FontSize="9" FontWeight="Bold" Foreground="#F47FFF" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedGuildName, Mode=OneWay}"
                                               FontWeight="Bold" FontSize="15" Foreground="#F2F3F5"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Chevron vers le bas comme sur Discord officiel -->
                                <FontIcon Grid.Column="1" Glyph="&#xE70D;" FontSize="12" Foreground="#949BA4" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Menu d'actions du serveur officiel Discord -->
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuFlyoutItem Text="Booster le serveur" Foreground="#F47FFF" Click="OnServerBoostClicked">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE735;" Foreground="#F47FFF" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Inviter des personnes" Foreground="#5865F2" Click="OnCreateChannelInviteFromMenuClicked">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72D;" Foreground="#5865F2" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Paramètres du serveur" Click="OnServerSettingsClicked">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Créer un salon" Click="OnCreateChannelHeaderClicked">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Créer une catégorie" Click="OnCreateCategoryHeaderClicked">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutSubItem Text="Paramètres de notification">
                                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xEA8F;" /></MenuFlyoutSubItem.Icon>
                                        <MenuFlyoutItem Text="Tous les messages" Tag="all" Click="OnNotificationSettingClicked" />
                                        <MenuFlyoutItem Text="Seulement les mentions" Tag="mentions" Click="OnNotificationSettingClicked" />
                                        <MenuFlyoutItem Text="Rien" Tag="nothing" Click="OnNotificationSettingClicked" />
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutItem Text="Paramètres de confidentialité" Click="OnPrivacySettingsClicked">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEA18;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Modifier le profil de serveur" Click="OnEditServerProfileClicked">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Copier l'identifiant du serveur" Click="OnCopyServerIdClicked">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Quitter le serveur" Foreground="#FF453A" Click="OnLeaveServerClicked">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7E8;" Foreground="#FF453A" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <!-- En-tête Amis & Messages Privés quand aucun serveur n'est sélectionné -->
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="12,10" CornerRadius="8" Background="Transparent" BorderThickness="0"
                                Visibility="{x:Bind ViewModel.ShowingFriendsView, Mode=OneWay}"
                                Click="OnFriendsHeaderClicked">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE77B;" FontSize="15" Foreground="#5865F2" VerticalAlignment="Center" />
                                <TextBlock Text="Amis &amp; Messages Privés" FontWeight="Bold" FontSize="14" Foreground="#F2F3F5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBox x:Name="ChannelSearchBox"
                                 PlaceholderText="Rechercher un salon..."
                                 CornerRadius="8"
                                 FontSize="12"
                                 Height="32"
                                 Padding="10,4"
                                 BorderThickness="0"
                                 Background="{ThemeResource ControlFillColorDefaultBrush}"
                                 TextChanged="OnChannelSearchChanged"
                                 Visibility="{x:Bind ViewModel.ShowingGuildChannels, Mode=OneWay}" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <ListView x:Name="ChannelList"
                                  ItemsSource="{x:Bind ViewModel.FilteredChannels, Mode=OneWay}"
                                  SelectionMode="Single"
                                  SelectionChanged="OnChannelSelected"
                                  Visibility="{x:Bind ViewModel.ShowingGuildChannels, Mode=OneWay}"
                                  Padding="8,0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,1" />
                                    <Setter Property="MinHeight" Value="28" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:DiscordChannel">
                                    <Grid HorizontalAlignment="Stretch">
                                        <!-- En-tête de Catégorie (Discord 1:1) -->
                                        <Grid Visibility="{x:Bind IsCategory, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                              Padding="4,8,4,2" HorizontalAlignment="Stretch" Background="Transparent"
                                              Tapped="OnCategoryHeaderTapped">
                                            <Grid.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="Créer un salon" Tag="{x:Bind}" Click="OnCreateChannelInCategoryClicked">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Modifier la catégorie" Tag="{x:Bind}" Click="OnEditCategoryClicked">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Copier l'identifiant" Tag="{x:Bind}" Click="OnCopyCategoryIdClicked">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Supprimer la catégorie" Foreground="#FF453A" Tag="{x:Bind}" Click="OnDeleteCategoryClicked">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" Foreground="#FF453A" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Grid.ContextFlyout>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Chevron de repli/dépli -->
                                            <FontIcon Grid.Column="0" Glyph="{x:Bind CategoryChevronGlyph, Mode=OneWay}"
                                                      FontSize="9" Foreground="#949BA4" Margin="0,0,6,0" VerticalAlignment="Center" />

                                            <!-- Nom de la catégorie en majuscules -->
                                            <TextBlock Grid.Column="1" Text="{x:Bind CategoryNameUpper, Mode=OneWay}"
                                                       FontSize="11" FontWeight="Bold" Foreground="#949BA4"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                            <!-- Bouton création rapide de salon dans la catégorie -->
                                            <Button Grid.Column="2" Background="Transparent" BorderThickness="0"
                                                    Padding="4,2" MinWidth="22" MinHeight="22"
                                                    Tag="{x:Bind}" Click="OnCreateChannelInCategoryClicked"
                                                    ToolTipService.ToolTip="Créer un salon">
                                                <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="#949BA4" />
                                            </Button>
                                        </Grid>

                                        <!-- Salon Ordinaire (Texte / Vocal) -->
                                        <StackPanel Visibility="{x:Bind IsNotCategory, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Margin="{x:Bind ChannelRowMargin, Mode=OneWay}"
                                                    Spacing="2" Padding="0,2">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Padding="8,4">
                                            <StackPanel.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="Marquer comme lu" Click="OnMarkChannelReadClicked">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FB;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSubItem Text="Mettre en sourdine le salon">
                                                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE74F;" /></MenuFlyoutSubItem.Icon>
                                                        <MenuFlyoutItem Text="Pendant 15 minutes" Tag="15m" Click="OnMuteDurationClicked" />
                                                        <MenuFlyoutItem Text="Pendant 1 heure" Tag="1h" Click="OnMuteDurationClicked" />
                                                        <MenuFlyoutItem Text="Pendant 3 heures" Tag="3h" Click="OnMuteDurationClicked" />
                                                        <MenuFlyoutItem Text="Pendant 8 heures" Tag="8h" Click="OnMuteDurationClicked" />
                                                        <MenuFlyoutItem Text="Pendant 24 heures" Tag="24h" Click="OnMuteDurationClicked" />
                                                        <MenuFlyoutItem Text="Jusqu'à réactivation" Tag="forever" Click="OnMuteDurationClicked" />
                                                    </MenuFlyoutSubItem>
                                                    <MenuFlyoutSubItem Text="Paramètres de notification">
                                                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xEA8F;" /></MenuFlyoutSubItem.Icon>
                                                        <MenuFlyoutItem Text="Utiliser les paramètres de la catégorie" Tag="default" Click="OnNotificationSettingClicked" />
                                                        <MenuFlyoutItem Text="Tous les messages" Tag="all" Click="OnNotificationSettingClicked" />
                                                        <MenuFlyoutItem Text="Seulement les mentions" Tag="mentions" Click="OnNotificationSettingClicked" />
                                                        <MenuFlyoutItem Text="Rien" Tag="nothing" Click="OnNotificationSettingClicked" />
                                                    </MenuFlyoutSubItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Créer une invitation" Click="OnCreateChannelInviteFromMenuClicked">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72D;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Copier le lien du salon" Click="OnCopyChannelLinkClicked">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Copier le nom" Click="OnCopyChannelNameClicked">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Copier l'identifiant" Click="OnCopyChannelIdClicked">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Modifier le salon" Click="OnEditChannelFromMenuClicked">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Supprimer le salon" Foreground="#FF453A" Click="OnDeleteChannelFromMenuClicked">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" Foreground="#FF453A" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </StackPanel.ContextFlyout>
                                            <!-- Icône Salon Texte (#) ou Salon Vocal (Haut-parleur ou Cadenas si verrouillé) -->
                                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                                <!-- Cadenas si salon vocal verrouillé -->
                                                <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="#949BA4"
                                                          Visibility="{x:Bind IsLocked, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                          ToolTipService.ToolTip="Salon verrouillé" />
                                                <!-- Haut-parleur si salon vocal accessible -->
                                                <FontIcon Glyph="&#xE767;" FontSize="13"
                                                          Foreground="{x:Bind VoiceSpeakerColorBrush, Mode=OneWay}"
                                                          Visibility="{x:Bind ShowVoiceSpeakerIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <!-- Icône Salon Forum -->
                                                <FontIcon Glyph="&#xE8BD;" FontSize="13" Foreground="#949BA4"
                                                          Visibility="{x:Bind IsForumChannel, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                          ToolTipService.ToolTip="Salon Forum" />
                                                <!-- Dièse si salon texte -->
                                                <TextBlock Text="#" FontSize="15" FontWeight="Bold" Foreground="#949BA4"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"
                                                           Visibility="{x:Bind ShowHashIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </Grid>

                                            <TextBlock Text="{x:Bind DisplayName}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" />

                                            <!-- Badge du nombre d'utilisateurs connectés en vocal (ex: 02 / 99) -->
                                            <Border Background="#2B2D31" CornerRadius="8" Padding="6,1" VerticalAlignment="Center" Margin="6,0,0,0"
                                                    Visibility="{x:Bind HasConnectedVoiceMembers, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{x:Bind VoiceLimitText, Mode=OneWay}" FontSize="10" Foreground="#DBDEE1" FontWeight="SemiBold" />
                                            </Border>

                                            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Margin="6,0,0,0"
                                                    Background="#DA373C"
                                                    CornerRadius="8" MinWidth="16" Height="16" Padding="4,0"
                                                    Visibility="{x:Bind HasMentions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{x:Bind MentionCountText, Mode=OneWay}"
                                                           Foreground="White" FontSize="10" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Utilisateurs connectés dans ce salon vocal -->
                                        <ItemsControl ItemsSource="{x:Bind ConnectedVoiceMembers, Mode=OneWay}"
                                                      Visibility="{x:Bind HasConnectedVoiceMembers, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                      Margin="24,0,0,2">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:DiscordUser">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" Padding="4,2">
                                                        <Grid Width="22" Height="22" VerticalAlignment="Center">
                                                            <PersonPicture Width="18" Height="18"
                                                                           ProfilePicture="{x:Bind AvatarUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                                           DisplayName="{x:Bind DisplayName, Mode=OneWay}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Ellipse Width="22" Height="22" Stroke="#23A55A" StrokeThickness="2" Fill="Transparent"
                                                                     Opacity="{x:Bind SpeakingRingOpacity, Mode=OneWay}"
                                                                     IsHitTestVisible="False"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Grid>
                                                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                                                   Foreground="{x:Bind RoleColorHex, Mode=OneWay}"
                                                                   FontSize="12" Opacity="0.85" VerticalAlignment="Center" />

                                                        <FontIcon Glyph="&#xE720;" FontSize="10" Foreground="#F23F43" VerticalAlignment="Center"
                                                                  Visibility="{x:Bind IsVoiceMuted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                  ToolTipService.ToolTip="Muet" />
                                                        <FontIcon Glyph="&#xE7F6;" FontSize="10" Foreground="#F23F43" VerticalAlignment="Center"
                                                                  Visibility="{x:Bind IsVoiceDeafened, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                  ToolTipService.ToolTip="Sourdine" />
                                                        <Border Background="#F23F43" CornerRadius="3" Padding="4,1" VerticalAlignment="Center"
                                                                Visibility="{x:Bind IsStreaming, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="LIVE" FontSize="9" FontWeight="Bold" Foreground="White" />
                                                        </Border>

                                                        <!-- Icône du Jeu / Activité en cours comme sur Discord officiel -->
                                                        <Border Width="16" Height="16" CornerRadius="3" VerticalAlignment="Center"
                                                                Visibility="{x:Bind HasGameActivity, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                ToolTipService.ToolTip="{x:Bind GameTooltipText, Mode=OneWay}">
                                                            <Grid>
                                                                <!-- Image officielle du jeu (Hollow Knight, LoL, etc.) -->
                                                                <Image Source="{x:Bind CurrentGameIconUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                                       Stretch="UniformToFill"
                                                                       Visibility="{x:Bind HasCurrentGameIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                <!-- Icône Manette de jeu par défaut si l'image n'est pas fournie -->
                                                                <FontIcon Glyph="&#xE7FC;" FontSize="11" Foreground="#949BA4" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                          Visibility="{x:Bind HasCurrentGameIcon, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                                                            </Grid>
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <ScrollViewer Visibility="{x:Bind ViewModel.ShowingFriendsView, Mode=OneWay}">
                            <StackPanel>
                                <TextBlock Text="Messages privés" Margin="12,8,12,4" Opacity="0.6" FontSize="12" FontWeight="SemiBold" />
                                <ListView x:Name="PrivateChannelList"
                                          ItemsSource="{x:Bind ViewModel.PrivateChannels, Mode=OneWay}"
                                          SelectionMode="Single"
                                          SelectionChanged="OnChannelSelected"
                                          Padding="8,0">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:DiscordChannel">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Padding="8,6">
                                                <StackPanel.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="Ouvrir le salon" Click="OnOpenDmChannelClicked">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8BD;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Marquer comme lu" Click="OnMarkChannelReadClicked">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FB;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSubItem Text="Mettre en sourdine">
                                                            <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE74F;" /></MenuFlyoutSubItem.Icon>
                                                            <MenuFlyoutItem Text="Pendant 15 minutes" Tag="15m" Click="OnMuteDurationClicked" />
                                                            <MenuFlyoutItem Text="Pendant 1 heure" Tag="1h" Click="OnMuteDurationClicked" />
                                                            <MenuFlyoutItem Text="Pendant 3 heures" Tag="3h" Click="OnMuteDurationClicked" />
                                                            <MenuFlyoutItem Text="Pendant 8 heures" Tag="8h" Click="OnMuteDurationClicked" />
                                                            <MenuFlyoutItem Text="Pendant 24 heures" Tag="24h" Click="OnMuteDurationClicked" />
                                                            <MenuFlyoutItem Text="Jusqu'à réactivation" Tag="forever" Click="OnMuteDurationClicked" />
                                                        </MenuFlyoutSubItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="Copier le nom" Click="OnCopyChannelNameClicked">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Copier l'identifiant" Click="OnCopyChannelIdClicked">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="Fermer le message privé" Click="OnCloseDmChannelClicked" Foreground="#FF453A">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;" Foreground="#FF453A" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </StackPanel.ContextFlyout>
                                                <Grid Width="28" Height="28" PointerEntered="OnAvatarPointerEntered" PointerExited="OnAvatarPointerExited">
                                                    <Ellipse Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                                                    <Ellipse>
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{x:Bind IconUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                </Grid>
                                                <TextBlock Text="{x:Bind DisplayName}" VerticalAlignment="Center" />
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Margin="8,0,0,0"
                                                        Background="#DA373C"
                                                        CornerRadius="8" MinWidth="16" Height="16" Padding="4,0"
                                                        Visibility="{x:Bind HasMentions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{x:Bind MentionCountText, Mode=OneWay}"
                                                               Foreground="White" FontSize="10" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <!-- Section Amis avec filtres et Ajout d'ami façon SakuraCord -->
                                <Grid Margin="12,16,12,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Amis" Opacity="0.6" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="+ Ajouter" FontSize="11" Padding="8,3" CornerRadius="6"
                                            Style="{StaticResource AccentButtonStyle}" Click="OnAddFriendClicked" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="12,0,12,6">
                                    <Button Content="Tous" FontSize="11" Padding="8,3" CornerRadius="6" Click="OnFilterAllFriendsClicked" />
                                    <Button Content="En attente" FontSize="11" Padding="8,3" CornerRadius="6" Click="OnFilterPendingFriendsClicked" />
                                    <Button Content="Bloqués" FontSize="11" Padding="8,3" CornerRadius="6" Click="OnFilterBlockedFriendsClicked" />
                                </StackPanel>

                                <ListView x:Name="FriendList"
                                          ItemsSource="{x:Bind ViewModel.FilteredFriends, Mode=OneWay}"
                                          SelectionMode="None"
                                          Padding="8,0">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:DiscordRelationship">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Padding="8,6">
                                                <StackPanel.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="Envoyer un message privé" Click="OnFriendProfileClicked">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8BD;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Accepter la demande" Click="OnAcceptFriendClicked"
                                                                        Visibility="{x:Bind IsPendingIncoming, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FB;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="Copier le pseudo" Click="OnCopyFriendUsernameClicked">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Copier l'identifiant" Click="OnCopyFriendIdClicked">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="Bloquer l'utilisateur" Click="OnBlockFriendClicked">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F8;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Retirer / Refuser" Click="OnRemoveFriendClicked" Foreground="#FF453A">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" Foreground="#FF453A" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </StackPanel.ContextFlyout>
                                                <Grid Width="30" Height="30" PointerEntered="OnAvatarPointerEntered" PointerExited="OnAvatarPointerExited">
                                                    <Ellipse Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                                                    <Ellipse>
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{x:Bind User.AvatarUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <Ellipse Width="10" Height="10" Fill="{x:Bind User.StatusColor, Mode=OneWay}"
                                                             Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="2"
                                                             HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                                </Grid>
                                                <StackPanel VerticalAlignment="Center" MaxWidth="165">
                                                    <TextBlock Text="{x:Bind User.DisplayName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind SubtitleText, Mode=OneWay}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Bas gauche : Panneau Vocal & Profil -->
                    <StackPanel Grid.Row="2" Background="Transparent">
                        <!-- Statut de connexion vocal actif + Partage d'écran / Caméra / Krisp -->
                        <StackPanel Padding="10,8" Background="#1B7A43" CornerRadius="12" Margin="8,0,8,6" Spacing="6"
                                    Visibility="{x:Bind ViewModel.IsVoiceConnected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE803;" FontSize="17" Foreground="White" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Voix connectée" FontWeight="Bold" FontSize="12" Foreground="White" />
                                        <TextBlock Text="{x:Bind ViewModel.ConnectedVoiceChannelName, Mode=OneWay}" FontSize="11" Foreground="White" Opacity="0.85" TextTrimming="CharacterEllipsis" MaxWidth="135" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <!-- Bouton Suppression de bruit Krisp (100% Gratuit) -->
                                    <Button Height="26" CornerRadius="13" Padding="7,0" Background="#33FFFFFF" BorderThickness="0"
                                            Click="OnToggleKrispClicked"
                                            Opacity="{x:Bind ViewModel.KrispOpacity, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.KrispTooltipText, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE9F5;" FontSize="11" Foreground="White" />
                                            <TextBlock Text="Krisp" FontSize="10" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Width="26" Height="26" CornerRadius="13" Padding="0" Background="#33FFFFFF" BorderThickness="0" Click="OnDisconnectVoiceClicked" ToolTipService.ToolTip="Se déconnecter">
                                        <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="White" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Boutons Caméra, Partager l'écran, et Soundboard comme sur Discord -->
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" HorizontalAlignment="Stretch" Height="30" CornerRadius="8" Padding="4,0"
                                        Background="#26FFFFFF" BorderThickness="0"
                                        Click="OnToggleCameraClicked"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.CameraTooltipText, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE714;" FontSize="11" Foreground="{x:Bind ViewModel.CameraIconBrush, Mode=OneWay}" />
                                        <TextBlock Text="Vidéo" FontSize="10" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" HorizontalAlignment="Stretch" Height="30" CornerRadius="8" Padding="4,0"
                                        Background="#26FFFFFF" BorderThickness="0"
                                        Click="OnScreenShareClicked"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.ScreenShareTooltipText, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE7F4;" FontSize="11" Foreground="{x:Bind ViewModel.ScreenShareIconBrush, Mode=OneWay}" />
                                        <TextBlock Text="Écran" FontSize="10" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" HorizontalAlignment="Stretch" Height="30" CornerRadius="8" Padding="4,0"
                                        Background="#26FFFFFF" BorderThickness="0"
                                        ToolTipService.ToolTip="Ouvrir le Soundboard">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE74F;" FontSize="11" Foreground="#5865F2" />
                                        <TextBlock Text="Sons" FontSize="10" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout x:Name="MiniVoiceSoundboardFlyout" Placement="Top" Opening="OnMiniVoiceSoundboardFlyoutOpening">
                                            <Flyout.FlyoutPresenterStyle>
                                                <Style TargetType="FlyoutPresenter">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="CornerRadius" Value="12" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="MaxWidth" Value="390" />
                                                    <Setter Property="MaxHeight" Value="460" />
                                                </Style>
                                            </Flyout.FlyoutPresenterStyle>
                                            <controls:DiscordSoundboardPickerControl x:Name="MiniVoiceSoundboardPicker"
                                                                                     SoundSelected="OnSoundboardPickerSoundSelected" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>

                        </StackPanel>

                        <!-- Barre Profil Utilisateur & Contrôles Audio Mute/Deafen/Settings -->
                        <Grid Height="56" Padding="8,4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Margin="8,0,8,8" CornerRadius="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Profil & Statut Sélecteur avec Popout Discord complet -->
                            <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" CornerRadius="8">
                                <Button.Flyout>
                                    <Flyout Placement="TopEdgeAlignedLeft">
                                        <Flyout.FlyoutPresenterStyle>
                                            <Style TargetType="FlyoutPresenter">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="CornerRadius" Value="16" />
                                                <Setter Property="MaxWidth" Value="340" />
                                            </Style>
                                        </Flyout.FlyoutPresenterStyle>
                                        <Grid Width="320" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                            <!-- Bannière utilisateur (120px de haut, calée en haut, coins arrondis clippés) -->
                                            <Border Height="120" VerticalAlignment="Top" Background="#5865F2" CornerRadius="16,16,0,0">
                                                <Border CornerRadius="16,16,0,0"
                                                        Visibility="{x:Bind ViewModel.CurrentUserHasBanner, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{x:Bind ViewModel.CurrentUserBannerUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                                    Stretch="UniformToFill" AlignmentY="Center" AlignmentX="Center" />
                                                    </Border.Background>
                                                </Border>
                                            </Border>

                                            <!-- Avatar rond qui chevauche la bannière (cliquable pour ouvrir la vue complète) -->
                                            <Button Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="40"
                                                    Margin="16,76,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    ToolTipService.ToolTip="Afficher le profil complet"
                                                    Tag="{x:Bind ViewModel.CurrentUser, Mode=OneWay}"
                                                    Click="OnOpenFullUserProfileFromPopoutClicked">
                                                <Ellipse Width="80" Height="80"
                                                         StrokeThickness="5" Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{x:Bind ViewModel.CurrentUserAvatarUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Button>

                                            <!-- Pastille d'état sur l'avatar -->
                                            <Ellipse Width="18" Height="18" Margin="74,136,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                     Fill="{x:Bind ViewModel.StatusDotBrush, Mode=OneWay}"
                                                     Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="3" />

                                            <!-- Contenu du profil positionné proprement sous la bannière -->
                                            <StackPanel Margin="16,164,16,16" Spacing="8">
                                                <TextBlock Text="{x:Bind ViewModel.CurrentUserName, Mode=OneWay}" FontWeight="Bold" FontSize="18" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind ViewModel.CurrentUserTag, Mode=OneWay}" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                                                    <TextBlock Text="•" Opacity="0.4" FontSize="12" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.CurrentUserPronounsVisibility, Mode=OneWay}" />
                                                    <TextBlock Text="{x:Bind ViewModel.CurrentUserPronouns, Mode=OneWay}" Opacity="0.7" FontSize="12" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.CurrentUserPronounsVisibility, Mode=OneWay}" />

                                                    <!-- Tag de Clan / Serveur Principal -->
                                                    <Button Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6"
                                                            Visibility="{x:Bind ViewModel.CurrentUserClanVisibility, Mode=OneWay}"
                                                            Tag="{x:Bind ViewModel.CurrentUser, Mode=OneWay}"
                                                            Click="OnClanTagPillClicked"
                                                            ToolTipService.ToolTip="Afficher le profil du clan">
                                                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <Image Width="14" Height="14" Source="{x:Bind ViewModel.CurrentUserClanBadgeUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="Uniform" />
                                                                <TextBlock Text="{x:Bind ViewModel.CurrentUserClanTag, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Button>
                                                </StackPanel>

                                                <!-- Badges officiels du profil Discord -->
                                                <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentUserBadges, Mode=OneWay}"
                                                              Visibility="{x:Bind ViewModel.CurrentUserBadgesVisibility, Mode=OneWay}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:DiscordBadge">
                                                            <Image Width="20" Height="20"
                                                                   Source="{x:Bind IconUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                                                   ToolTipService.ToolTip="{x:Bind Description}"
                                                                   Stretch="Uniform" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Bio / À propos de moi -->
                                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="2,0,0,0" Padding="8,0,0,0" Margin="0,2,0,0">
                                                    <TextBlock Text="{x:Bind ViewModel.CurrentUserBio, Mode=OneWay}" FontSize="12" FontStyle="Italic" TextWrapping="Wrap" Opacity="0.85" />
                                                </Border>

                                                <!-- Carte Rich Presence (RPC) Actif sur notre propre profil -->
                                                <Border Visibility="{x:Bind ViewModel.CurrentUserRichPresenceVisibility, Mode=OneWay}"
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="10" Padding="10">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="{x:Bind ViewModel.CurrentUserRpcHeader, Mode=OneWay}" FontSize="10" FontWeight="Bold" Opacity="0.65" />
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid Grid.Column="0" Width="56" Height="56" VerticalAlignment="Top"
                                                                  Visibility="{x:Bind ViewModel.CurrentUserRpcLargeImageVisibility, Mode=OneWay}">
                                                                <Border Width="56" Height="56" CornerRadius="8">
                                                                    <Border.Background>
                                                                        <ImageBrush ImageSource="{x:Bind ViewModel.CurrentUserRpcLargeImageUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                    </Border.Background>
                                                                </Border>
                                                                <Ellipse Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"
                                                                         Stroke="{ThemeResource CardBackgroundFillColorDefaultBrush}" StrokeThickness="2"
                                                                         Visibility="{x:Bind ViewModel.CurrentUserRpcSmallImageVisibility, Mode=OneWay}">
                                                                    <Ellipse.Fill>
                                                                        <ImageBrush ImageSource="{x:Bind ViewModel.CurrentUserRpcSmallImageUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                    </Ellipse.Fill>
                                                                </Ellipse>
                                                            </Grid>
                                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind ViewModel.CurrentUserRpcName, Mode=OneWay}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{x:Bind ViewModel.CurrentUserRpcDetails, Mode=OneWay}" FontSize="11" Opacity="0.85" TextTrimming="CharacterEllipsis"
                                                                           Visibility="{x:Bind ViewModel.CurrentUserRpcDetailsVisibility, Mode=OneWay}" />
                                                                <TextBlock Text="{x:Bind ViewModel.CurrentUserRpcState, Mode=OneWay}" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis"
                                                                           Visibility="{x:Bind ViewModel.CurrentUserRpcStateVisibility, Mode=OneWay}" />
                                                                <TextBlock Text="{x:Bind ViewModel.CurrentUserRpcElapsed, Mode=OneWay}" FontSize="11" Foreground="#23A55A" FontWeight="SemiBold"
                                                                           Visibility="{x:Bind ViewModel.CurrentUserRpcElapsedVisibility, Mode=OneWay}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Widget : Game Collection (comme sur Discord) -->
                                                <Border Visibility="{x:Bind ViewModel.CurrentUserGameWidgetsVisibility, Mode=OneWay}"
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="10" Padding="10,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Game Collection" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.CurrentUserGameWidgets, Mode=OneWay}" VerticalAlignment="Center">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:DiscordWidgetGame">
                                                                    <Border Width="28" Height="28" CornerRadius="6" ToolTipService.ToolTip="{x:Bind TooltipText}">
                                                                        <Border.Background>
                                                                            <ImageBrush ImageSource="{x:Bind IconUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                        </Border.Background>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Border>

                                                <!-- Comptes reliés et liens affichés sur le profil (ex: GitHub, Steam, jay-space.com...) -->
                                                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.CurrentUserConnectedAccountsVisibility, Mode=OneWay}">
                                                    <TextBlock Text="COMPTES ET LIENS RELIÉS" FontSize="10" FontWeight="Bold" Opacity="0.65" />
                                                    <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentUserConnectedAccounts, Mode=OneWay}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Spacing="4" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:DiscordConnectedAccount">
                                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                        BorderThickness="1" CornerRadius="8" Padding="10,7"
                                                                        Tag="{x:Bind}"
                                                                        Click="OnConnectedAccountClicked"
                                                                        ToolTipService.ToolTip="{x:Bind TooltipText}">
                                                                    <Grid ColumnSpacing="8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Grid.Column="0" Width="30" Height="30" Background="#1E1F22"
                                                                                BorderBrush="#383A40" BorderThickness="1"
                                                                                CornerRadius="8" VerticalAlignment="Center"
                                                                                ToolTipService.ToolTip="{x:Bind PlatformBubbleName}">
                                                                            <FontIcon Glyph="{x:Bind PlatformGlyph}" FontSize="15" Foreground="#DBDEE1"
                                                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                                <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="165" />
                                                                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="#23A55A" VerticalAlignment="Center"
                                                                                          Visibility="{x:Bind Verified, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                          ToolTipService.ToolTip="Compte vérifié" />
                                                                            </StackPanel>
                                                                            <TextBlock Text="{x:Bind PlatformDisplayName}" FontSize="10" Opacity="0.6" />
                                                                        </StackPanel>
                                                                        <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="12" Opacity="0.65" VerticalAlignment="Center"
                                                                                  Visibility="{x:Bind HasUrl, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <MenuFlyoutSeparator Margin="0,2" />

                                                <!-- Menu d'actions style Discord (Modifier le profil + Rich Presence + Menu déroulant de statut + Copier l'ID) -->
                                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="10" Padding="4">
                                                    <StackPanel Spacing="2">
                                                        <!-- Modifier le profil -->
                                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                Background="Transparent" BorderThickness="0" Padding="10,8" CornerRadius="6"
                                                                Click="OnEditProfileClicked">
                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                <FontIcon Glyph="&#xE70F;" FontSize="14" Opacity="0.85" />
                                                                 <TextBlock Text="Modifier le profil" FontSize="13" FontWeight="Medium" />
                                                            </StackPanel>
                                                        </Button>

                                                        <!-- Définir un statut personnalisé (style Discord officiel) -->
                                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                Background="Transparent" BorderThickness="0" Padding="10,8" CornerRadius="6"
                                                                Click="OnOpenCustomStatusModalClicked">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <FontIcon Grid.Column="0" Glyph="&#xE76E;" FontSize="14" Opacity="0.85" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind ViewModel.CustomStatusButtonText, Mode=OneWay}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{x:Bind ViewModel.CurrentUserCustomStatusSubtitle, Mode=OneWay}" FontSize="11" Opacity="0.6"
                                                                               Visibility="{x:Bind ViewModel.HasCustomStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <Button Grid.Column="2" Width="24" Height="24" Padding="0" CornerRadius="12" Background="Transparent" BorderThickness="0"
                                                                        Click="OnClearCustomStatusClicked" ToolTipService.ToolTip="Effacer le statut personnalisé"
                                                                        Visibility="{x:Bind ViewModel.HasCustomStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <FontIcon Glyph="&#xE711;" FontSize="10" Opacity="0.7" />
                                                                </Button>
                                                            </Grid>
                                                        </Button>


                                                        <!-- Sélecteur de statut avec sous-menu déroulant latéral comme sur Discord -->
                                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                Background="Transparent" BorderThickness="0" Padding="10,8" CornerRadius="6">
                                                            <Button.Flyout>
                                                                <Flyout Placement="RightEdgeAlignedTop">
                                                                    <StackPanel Width="240" Spacing="2">
                                                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                                Background="Transparent" BorderThickness="0" Padding="10,8" CornerRadius="6"
                                                                                Click="OnStatusOnlineClicked">
                                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                                <Ellipse Width="10" Height="10" Fill="#23A55A" VerticalAlignment="Center" />
                                                                                <TextBlock Text="En ligne" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Button>
                                                                        <MenuFlyoutSeparator Margin="4,2" />
                                                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                                Background="Transparent" BorderThickness="0" Padding="10,8" CornerRadius="6"
                                                                                Click="OnStatusIdleClicked">
                                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                                <Ellipse Width="10" Height="10" Fill="#F0B232" VerticalAlignment="Center" />
                                                                                <TextBlock Text="Inactif" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Button>
                                                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                                Background="Transparent" BorderThickness="0" Padding="10,8" CornerRadius="6"
                                                                                Click="OnStatusDndClicked">
                                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                                <Ellipse Width="10" Height="10" Fill="#F23F43" VerticalAlignment="Top" Margin="0,4,0,0" />
                                                                                <StackPanel Spacing="2">
                                                                                    <TextBlock Text="Ne pas déranger" FontSize="13" FontWeight="SemiBold" />
                                                                                    <TextBlock Text="Vous ne recevrez aucune notification de bureau" FontSize="11" Opacity="0.6" TextWrapping="Wrap" Width="185" />
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </Button>
                                                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                                Background="Transparent" BorderThickness="0" Padding="10,8" CornerRadius="6"
                                                                                Click="OnStatusInvisibleClicked">
                                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                                <Ellipse Width="10" Height="10" Stroke="#80848E" StrokeThickness="2.5" Fill="Transparent" VerticalAlignment="Top" Margin="0,4,0,0" />
                                                                                <StackPanel Spacing="2">
                                                                                    <TextBlock Text="Invisible" FontSize="13" FontWeight="SemiBold" />
                                                                                    <TextBlock Text="Vous apparaîtrez hors ligne" FontSize="11" Opacity="0.6" TextWrapping="Wrap" Width="185" />
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Flyout>
                                                            </Button.Flyout>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{x:Bind ViewModel.StatusDotBrush, Mode=OneWay}" VerticalAlignment="Center" Margin="2,0,10,0" />
                                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentStatusDisplayName, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Button>

                                                        <MenuFlyoutSeparator Margin="4,2" />

                                                        <!-- Copier l'identifiant utilisateur -->
                                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                Background="Transparent" BorderThickness="0" Padding="10,8" CornerRadius="6"
                                                                Click="OnCopyCurrentUserIdClicked">
                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                <FontIcon Glyph="&#xE8C8;" FontSize="14" Opacity="0.85" />
                                                                <TextBlock Text="Copier l'identifiant" FontSize="13" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Flyout>
                                </Button.Flyout>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Grid Width="34" Height="34" PointerEntered="OnAvatarPointerEntered" PointerExited="OnAvatarPointerExited"
                                          DoubleTapped="OnCurrentUserAvatarDoubleTapped" ToolTipService.ToolTip="Double-cliquez pour afficher votre profil complet">
                                        <Ellipse Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{x:Bind ViewModel.CurrentUserAvatarUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <!-- Cercle vert quand notre micro détecte le son en appel vocal -->
                                        <Ellipse Width="34" Height="34" Stroke="#23A55A" StrokeThickness="2.5" Fill="Transparent"
                                                 Opacity="{x:Bind ViewModel.CurrentUserSpeakingRingOpacity, Mode=OneWay}"
                                                 IsHitTestVisible="False" />
                                        <Ellipse Width="10" Height="10" Fill="{x:Bind ViewModel.StatusDotBrush, Mode=OneWay}"
                                                 Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="2"
                                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentUserName, Mode=OneWay}"
                                                   FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="105" />
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE767;" FontSize="11" Foreground="#23A55A" VerticalAlignment="Center"
                                                      Visibility="{x:Bind ViewModel.CurrentUserIsInVoice, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBlock Text="{x:Bind ViewModel.CurrentUserSubStatusText, Mode=OneWay}"
                                                       FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" MaxWidth="115" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <!-- Boutons Audio Krisp / Mute / Deafen -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <Button Width="32" Height="32" CornerRadius="16" Padding="0" Background="Transparent" BorderThickness="0"
                                        Click="OnToggleKrispClicked" ToolTipService.ToolTip="{x:Bind ViewModel.KrispTooltipText, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE9F5;" FontSize="14" Foreground="{x:Bind ViewModel.KrispIconBrush, Mode=OneWay}" Opacity="{x:Bind ViewModel.KrispOpacity, Mode=OneWay}" />
                                </Button>
                                <Button Width="32" Height="32" CornerRadius="16" Padding="0" Background="Transparent" BorderThickness="0"
                                        Click="OnToggleMuteClicked" ToolTipService.ToolTip="Couper/Activer le micro">
                                    <FontIcon Glyph="&#xE720;" FontSize="14" Opacity="{x:Bind ViewModel.MuteOpacity, Mode=OneWay}" />
                                </Button>
                                <Button Width="32" Height="32" CornerRadius="16" Padding="0" Background="Transparent" BorderThickness="0"
                                        Click="OnToggleDeafenClicked" ToolTipService.ToolTip="Mettre en sourdine">
                                    <FontIcon Glyph="&#xE7F6;" FontSize="14" Opacity="{x:Bind ViewModel.DeafenOpacity, Mode=OneWay}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- 2. Zone principale : En-tête + Chat/Vocal + Liste des membres -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- En-tête de salon avec Actions (Inviter, Épinglés, Mentions, Membres) -->
                    <Border Grid.Row="0" Grid.ColumnSpan="3" Background="Transparent"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <!-- EN-TÊTE DU HUB D'AMIS (Discord Desktop 1:1) -->
                        <Grid Margin="16,0" Visibility="{x:Bind ViewModel.FriendsMainStageVisibility, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <!-- Titre Amis avec icône -->
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <FontIcon Glyph="&#xE77B;" FontSize="18" Foreground="#80848E" VerticalAlignment="Center" />
                                    <TextBlock Text="Amis" FontWeight="Bold" FontSize="15" Foreground="#F2F3F5" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Séparateur vertical discret -->
                                <Border Width="1" Height="20" Background="#35373C" VerticalAlignment="Center" Margin="4,0" />

                                <!-- Onglet "En ligne" -->
                                <Button Tag="Online" Click="OnFriendsTabClicked"
                                        Padding="12,5" CornerRadius="6" BorderThickness="0"
                                        Background="{x:Bind ViewModel.FriendsTabOnlineBackground, Mode=OneWay}">
                                    <TextBlock Text="En ligne" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{x:Bind ViewModel.FriendsTabOnlineForeground, Mode=OneWay}" />
                                </Button>

                                <!-- Onglet "Tous" -->
                                <Button Tag="All" Click="OnFriendsTabClicked"
                                        Padding="12,5" CornerRadius="6" BorderThickness="0"
                                        Background="{x:Bind ViewModel.FriendsTabAllBackground, Mode=OneWay}">
                                    <TextBlock Text="Tous" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{x:Bind ViewModel.FriendsTabAllForeground, Mode=OneWay}" />
                                </Button>

                                <!-- Onglet "En attente" avec Badge rouge -->
                                <Button Tag="Pending" Click="OnFriendsTabClicked"
                                        Padding="12,5" CornerRadius="6" BorderThickness="0"
                                        Background="{x:Bind ViewModel.FriendsTabPendingBackground, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="En attente" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{x:Bind ViewModel.FriendsTabPendingForeground, Mode=OneWay}" />
                                        <Border Background="#DA373C" CornerRadius="8" MinWidth="16" Height="16" Padding="4,0"
                                                Visibility="{x:Bind ViewModel.HasPendingFriends, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{x:Bind ViewModel.PendingBadgeText, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Button>

                                <!-- Onglet "Bloqués" -->
                                <Button Tag="Blocked" Click="OnFriendsTabClicked"
                                        Padding="12,5" CornerRadius="6" BorderThickness="0"
                                        Background="{x:Bind ViewModel.FriendsTabBlockedBackground, Mode=OneWay}">
                                    <TextBlock Text="Bloqués" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{x:Bind ViewModel.FriendsTabBlockedForeground, Mode=OneWay}" />
                                </Button>

                                <!-- Bouton vert "Ajouter un ami" -->
                                <Button Tag="AddFriend" Click="OnFriendsTabClicked"
                                        Margin="8,0,0,0" Padding="12,5" CornerRadius="6" BorderThickness="0"
                                        Background="{x:Bind ViewModel.FriendsTabAddFriendBackground, Mode=OneWay}">
                                    <TextBlock Text="Ajouter un ami" FontSize="13" FontWeight="Bold"
                                               Foreground="{x:Bind ViewModel.FriendsTabAddFriendForeground, Mode=OneWay}" />
                                </Button>
                            </StackPanel>

                            <!-- Actions à droite de l'en-tête (Boîte de réception) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Width="34" Height="34" Padding="0" CornerRadius="8" Background="Transparent" BorderThickness="0"
                                        Click="OnOpenInboxFlyoutClicked" ToolTipService.ToolTip="Boîte de réception">
                                    <Grid>
                                        <FontIcon Glyph="&#xE715;" FontSize="15" Foreground="#DBDEE1" />
                                        <Border Width="8" Height="8" CornerRadius="4" Background="#DA373C"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                                                Visibility="{x:Bind ViewModel.HasUnreadChannels, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- EN-TÊTE DE SALON RÉGULIER (Canal textuel, vocal, DM) -->
                        <Grid Margin="16,0" Visibility="{x:Bind ViewModel.ShowingFriendsMainStage, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE803;" FontSize="16" Opacity="0.6" Visibility="{x:Bind ViewModel.VoiceViewVisibility, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedChannelName, Mode=OneWay}"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="|" Opacity="0.3" VerticalAlignment="Center"
                                           Visibility="{x:Bind ViewModel.TopicVisibility, Mode=OneWay}" />
                                <Button Background="Transparent" BorderThickness="0" Padding="4,2" CornerRadius="6"
                                        Visibility="{x:Bind ViewModel.TopicVisibility, Mode=OneWay}"
                                        ToolTipService.ToolTip="Afficher le sujet complet du salon">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedChannelTopic, Mode=OneWay}"
                                               FontSize="12" Opacity="0.65" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                    <Button.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedLeft">
                                            <Border Width="380" Background="#1E1F22" BorderBrush="#2B2D31" BorderThickness="1" CornerRadius="8" Padding="14">
                                                <StackPanel Spacing="10">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <TextBlock Text="#" FontSize="18" FontWeight="Bold" Foreground="#5865F2" />
                                                        <TextBlock Text="{x:Bind ViewModel.SelectedChannelName, Mode=OneWay}" FontSize="15" FontWeight="Bold" />
                                                    </StackPanel>
                                                    <Border Height="1" Background="#2B2D31" />
                                                    <TextBlock Text="SUJET DU SALON" FontSize="11" FontWeight="Bold" Opacity="0.6" />
                                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                                        <TextBlock Text="{x:Bind ViewModel.SelectedChannelTopic, Mode=OneWay}"
                                                                   TextWrapping="Wrap" FontSize="13" IsTextSelectionEnabled="True" LineHeight="18" />
                                                    </ScrollViewer>
                                                </StackPanel>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <!-- Démarrer / Rejoindre un appel vocal -->
                                <Button Width="34" Height="34" Padding="0" CornerRadius="8" Background="Transparent" BorderThickness="0"
                                        Click="OnStartCallClicked" ToolTipService.ToolTip="Démarrer ou rejoindre l'appel vocal">
                                    <FontIcon Glyph="&#xE717;" FontSize="15" />
                                </Button>

                                <!-- Créer une invitation -->
                                <Button Width="34" Height="34" Padding="0" CornerRadius="8" Background="Transparent" BorderThickness="0"
                                        Click="OnCreateChannelInviteClicked" ToolTipService.ToolTip="Créer un lien d'invitation">
                                    <FontIcon Glyph="&#xE72D;" FontSize="15" />
                                </Button>

                                <!-- Messages Épinglés -->
                                <Button Width="34" Height="34" Padding="0" CornerRadius="8" Background="Transparent" BorderThickness="0"
                                        Click="OnOpenPinsFlyoutClicked" ToolTipService.ToolTip="Messages épinglés">
                                    <FontIcon Glyph="&#xE718;" FontSize="15" />
                                    <Button.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedRight">
                                            <Border Width="380" Background="#1E1F22" BorderBrush="#2B2D31" BorderThickness="1" CornerRadius="8" Padding="12">
                                                <StackPanel Spacing="10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <FontIcon Glyph="&#xE718;" FontSize="15" Foreground="#5865F2" VerticalAlignment="Center" />
                                                            <TextBlock Text="{x:Bind ViewModel.PinnedMessagesCountText, Mode=OneWay}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                    
                                                    <!-- État vide (aucun message épinglé) -->
                                                    <StackPanel Visibility="{x:Bind ViewModel.HasPinnedMessages, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                                                                Spacing="10" Padding="16" HorizontalAlignment="Center">
                                                        <Border Width="48" Height="48" CornerRadius="24" Background="#2B2D31" HorizontalAlignment="Center">
                                                            <FontIcon Glyph="&#xE718;" FontSize="20" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Text="Ce salon n'a aucun message épinglé... pour l'instant."
                                                                   FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                                        <TextBlock Text="Astuce : vous pouvez épingler un message depuis son menu contextuel."
                                                                   FontSize="11" Opacity="0.55" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <!-- Liste des messages épinglés -->
                                                    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto"
                                                                  Visibility="{x:Bind ViewModel.HasPinnedMessages, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <ItemsControl ItemsSource="{x:Bind ViewModel.PinnedMessages, Mode=OneWay}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:DiscordMessage">
                                                                    <Border Background="#2B2D31" BorderBrush="#383A40"
                                                                            BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                                        <Grid RowSpacing="6">
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                            </Grid.RowDefinitions>
                                                                            <Grid Grid.Row="0">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Margin="0,0,8,0">
                                                                                    <Ellipse>
                                                                                        <Ellipse.Fill>
                                                                                            <ImageBrush ImageSource="{x:Bind Author.AvatarUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                                        </Ellipse.Fill>
                                                                                    </Ellipse>
                                                                                </Border>
                                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                                    <TextBlock Text="{x:Bind Author.DisplayName}" FontWeight="SemiBold" FontSize="12" />
                                                                                    <TextBlock Text="{x:Bind TimeText}" FontSize="10" Opacity="0.5" />
                                                                                </StackPanel>
                                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                                                                    <Button Content="Aller au message" FontSize="10" Padding="6,2" CornerRadius="4"
                                                                                            Background="#1E1F22" BorderThickness="0"
                                                                                            Tag="{x:Bind}" Click="OnJumpToPinnedMessageClicked"
                                                                                            ToolTipService.ToolTip="Afficher ce message dans la conversation" />
                                                                                    <Button Content="&#xE711;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="9" Padding="4,2" CornerRadius="4"
                                                                                            Background="Transparent" BorderThickness="0" Opacity="0.7"
                                                                                            Tag="{x:Bind}" Click="OnUnpinFromFlyoutClicked"
                                                                                            ToolTipService.ToolTip="Désépingler ce message" />
                                                                                </StackPanel>
                                                                            </Grid>
                                                                            <TextBlock Grid.Row="1" Text="{x:Bind Content}" TextWrapping="Wrap" FontSize="12" Opacity="0.95" Margin="36,0,0,0"
                                                                                       Visibility="{x:Bind HasContent, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                            <ItemsControl Grid.Row="2" ItemsSource="{x:Bind ImageAttachments}" Margin="36,2,0,0"
                                                                                          Visibility="{x:Bind HasImages, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="models:DiscordAttachment">
                                                                                        <Border CornerRadius="6" Margin="0,2,0,2">
                                                                                            <Image Source="{x:Bind Url, Converter={StaticResource StringToImageSourceConverter}}"
                                                                                                   MaxHeight="100" MaxWidth="180" Stretch="UniformToFill" />
                                                                                        </Border>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>

                                                                            </ItemsControl>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </StackPanel>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>

                                <!-- Boîte de réception Discord (Non lus, Mentions, Favoris) -->
                                <Button Width="34" Height="34" Padding="0" CornerRadius="8" Background="Transparent" BorderThickness="0"
                                        Click="OnOpenInboxFlyoutClicked" ToolTipService.ToolTip="Boîte de réception">
                                    <Grid>
                                        <FontIcon Glyph="&#xE715;" FontSize="15" />
                                        <!-- Badge rouge si mentions globales ou salons non lus -->
                                        <Border Width="8" Height="8" CornerRadius="4" Background="#DA373C"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                                                Visibility="{x:Bind ViewModel.HasUnreadChannels, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>
                                    <Button.Flyout>
                                        <Flyout x:Name="InboxFlyout" Placement="BottomEdgeAlignedRight">
                                            <Flyout.FlyoutPresenterStyle>
                                                <Style TargetType="FlyoutPresenter">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="CornerRadius" Value="12" />
                                                    <Setter Property="Background" Value="#1E1F22" />
                                                    <Setter Property="BorderBrush" Value="#2B2D31" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="MaxWidth" Value="460" />
                                                    <Setter Property="MaxHeight" Value="560" />
                                                </Style>
                                            </Flyout.FlyoutPresenterStyle>
                                            <Grid Width="440" Height="500">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <!-- 1. En-tête : Titre + Bouton Tout marquer comme lu -->
                                                <Grid Grid.Row="0" Padding="14,12,14,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE715;" FontSize="16" Foreground="#5865F2" VerticalAlignment="Center" />
                                                        <TextBlock Text="Boîte de réception" FontWeight="Bold" FontSize="14" Foreground="#F2F3F5" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Padding="8,4" CornerRadius="6" Background="#2B2D31" BorderThickness="0"
                                                            Click="OnInboxMarkAllReadClicked" ToolTipService.ToolTip="Tout marquer comme lu">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="&#xE8FB;" FontSize="11" Foreground="#949BA4" />
                                                            <TextBlock Text="Tout marquer comme lu" FontSize="11" Foreground="#949BA4" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>

                                                <!-- 2. Barre d'onglets : Non lus / Mentions / Favoris -->
                                                <Border Grid.Row="1" Background="#111214" Margin="12,0,12,8" CornerRadius="8" Padding="3">
                                                    <Grid ColumnSpacing="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Onglet Non lus -->
                                                        <Button Grid.Column="0" HorizontalAlignment="Stretch" Padding="6,4" CornerRadius="6"
                                                                Background="{x:Bind ViewModel.InboxTabUnreadsBackground, Mode=OneWay}"
                                                                BorderThickness="0" Tag="0" Click="OnInboxTabClicked">
                                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                                <TextBlock Text="Non lus" FontSize="12" FontWeight="SemiBold" />
                                                                <Border Background="#DA373C" CornerRadius="8" MinWidth="16" Height="16" Padding="4,0"
                                                                        Visibility="{x:Bind ViewModel.HasUnreadChannels, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <TextBlock Text="{x:Bind ViewModel.UnreadChannelsCountText, Mode=OneWay}"
                                                                               Foreground="White" FontSize="10" FontWeight="Bold"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </StackPanel>
                                                        </Button>

                                                        <!-- Onglet Mentions -->
                                                        <Button Grid.Column="1" HorizontalAlignment="Stretch" Padding="6,4" CornerRadius="6"
                                                                Background="{x:Bind ViewModel.InboxTabMentionsBackground, Mode=OneWay}"
                                                                BorderThickness="0" Tag="1" Click="OnInboxTabClicked">
                                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                                <TextBlock Text="Mentions" FontSize="12" FontWeight="SemiBold" />
                                                            </StackPanel>
                                                        </Button>

                                                        <!-- Onglet Favoris -->
                                                        <Button Grid.Column="2" HorizontalAlignment="Stretch" Padding="6,4" CornerRadius="6"
                                                                Background="{x:Bind ViewModel.InboxTabBookmarksBackground, Mode=OneWay}"
                                                                BorderThickness="0" Tag="2" Click="OnInboxTabClicked">
                                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                                <TextBlock Text="Favoris" FontSize="12" FontWeight="SemiBold" />
                                                                <Border Background="#5865F2" CornerRadius="8" MinWidth="16" Height="16" Padding="4,0"
                                                                        Visibility="{x:Bind ViewModel.HasBookmarks, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <TextBlock Text="{x:Bind ViewModel.BookmarksCountText, Mode=OneWay}"
                                                                               Foreground="White" FontSize="10" FontWeight="Bold"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </Border>

                                                <!-- 3. Contenu de la Boîte de réception -->
                                                <Grid Grid.Row="2">
                                                    <!-- Vue 1 : Salons non lus -->
                                                    <Grid Visibility="{x:Bind ViewModel.InboxUnreadsVisibility, Mode=OneWay}">
                                                        <!-- État vide : à jour -->
                                                        <StackPanel Visibility="{x:Bind ViewModel.HasUnreadChannels, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                                                                    Spacing="8" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Border Width="48" Height="48" CornerRadius="24" Background="#2B2D31" HorizontalAlignment="Center">
                                                                <FontIcon Glyph="&#xE715;" FontSize="20" Foreground="#5865F2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <TextBlock Text="Vous êtes à jour !" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" />
                                                            <TextBlock Text="Aucun salon non lu pour le moment." FontSize="12" Opacity="0.6" HorizontalAlignment="Center" />
                                                        </StackPanel>

                                                        <!-- Liste des salons non lus -->
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                      Visibility="{x:Bind ViewModel.HasUnreadChannels, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <ItemsControl ItemsSource="{x:Bind ViewModel.UnreadChannels, Mode=OneWay}" Padding="10,0,10,10">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:DiscordChannel">
                                                                        <Border Background="#2B2D31" BorderBrush="#383A40" BorderThickness="1"
                                                                                CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <!-- Icône du serveur ou avatar DM -->
                                                                                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Background="#1E1F22" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                                    <Image Source="{x:Bind IconUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                                </Border>
                                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                                    <TextBlock Text="{x:Bind HeaderContextText}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                                                    <TextBlock Text="{x:Bind Topic}" FontSize="10" Opacity="0.55" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                                                                </StackPanel>
                                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                                    <!-- Badge mention si présent -->
                                                                                    <Border Background="#DA373C" CornerRadius="8" MinWidth="16" Height="16" Padding="4,0" Margin="0,0,4,0"
                                                                                            Visibility="{x:Bind HasMentions, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                        <TextBlock Text="{x:Bind MentionCountText}" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                    </Border>
                                                                                    <Button Content="Aller" FontSize="10" Padding="8,3" CornerRadius="4"
                                                                                            Style="{StaticResource AccentButtonStyle}"
                                                                                            Tag="{x:Bind}" Click="OnInboxJumpToChannelClicked"
                                                                                            ToolTipService.ToolTip="Ouvrir ce salon" />
                                                                                    <Button Content="&#xE8FB;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="10" Padding="6,3" CornerRadius="4"
                                                                                            Background="#1E1F22" BorderThickness="0"
                                                                                            Tag="{x:Bind}" Click="OnInboxMarkChannelReadClicked"
                                                                                            ToolTipService.ToolTip="Marquer comme lu" />
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </Grid>

                                                    <!-- Vue 2 : Mentions récentes -->
                                                    <Grid Visibility="{x:Bind ViewModel.InboxMentionsVisibility, Mode=OneWay}">
                                                        <!-- État vide : aucune mention -->
                                                        <StackPanel Visibility="{x:Bind ViewModel.HasNoMentionsInInbox, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                    Spacing="8" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Border Width="48" Height="48" CornerRadius="24" Background="#2B2D31" HorizontalAlignment="Center">
                                                                <FontIcon Glyph="&#xE715;" FontSize="20" Foreground="#5865F2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <TextBlock Text="Aucune mention récente" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" />
                                                            <TextBlock Text="Personne ne vous a mentionné récemment." FontSize="12" Opacity="0.6" HorizontalAlignment="Center" />
                                                        </StackPanel>

                                                        <!-- Liste des mentions -->
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                      Visibility="{x:Bind ViewModel.HasMentionsInInbox, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <ItemsControl ItemsSource="{x:Bind ViewModel.RecentMentions, Mode=OneWay}" Padding="10,0,10,10">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:DiscordMessage">
                                                                        <Border Background="#2B2D31" BorderBrush="#383A40" BorderThickness="1"
                                                                                CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                                            <Grid RowSpacing="6">
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                </Grid.RowDefinitions>
                                                                                <!-- En-tête : Serveur/Salon + Auteur + Date + Bouton Aller -->
                                                                                <Grid Grid.Row="0">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Margin="0,0,8,0">
                                                                                        <Ellipse>
                                                                                            <Ellipse.Fill>
                                                                                                <ImageBrush ImageSource="{x:Bind Author.AvatarUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                                            </Ellipse.Fill>
                                                                                        </Ellipse>
                                                                                    </Border>
                                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                            <TextBlock Text="{x:Bind Author.DisplayName}" FontWeight="SemiBold" FontSize="12" />
                                                                                            <TextBlock Text="{x:Bind HeaderContextText}" FontSize="10" Foreground="#5865F2" FontWeight="SemiBold" />
                                                                                        </StackPanel>
                                                                                        <TextBlock Text="{x:Bind TimeText}" FontSize="10" Opacity="0.5" />
                                                                                    </StackPanel>
                                                                                    <Button Grid.Column="2" Content="Aller au message" FontSize="10" Padding="8,3" CornerRadius="4"
                                                                                            Style="{StaticResource AccentButtonStyle}"
                                                                                            Tag="{x:Bind}" Click="OnInboxJumpToMessageClicked"
                                                                                            ToolTipService.ToolTip="Afficher ce message dans la conversation" />
                                                                                </Grid>
                                                                                <!-- Contenu texte du message -->
                                                                                <TextBlock Grid.Row="1" Text="{x:Bind Content}" TextWrapping="Wrap" FontSize="12" Opacity="0.95" Margin="36,0,0,0"
                                                                                           Visibility="{x:Bind HasContent, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                                <!-- Pièces jointes si présentes -->
                                                                                <ItemsControl Grid.Row="2" ItemsSource="{x:Bind ImageAttachments}" Margin="36,2,0,0"
                                                                                              Visibility="{x:Bind HasImages, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate x:DataType="models:DiscordAttachment">
                                                                                            <Border CornerRadius="6" Margin="0,2,0,2">
                                                                                                <Image Source="{x:Bind Url, Converter={StaticResource StringToImageSourceConverter}}"
                                                                                                       MaxHeight="100" MaxWidth="180" Stretch="UniformToFill" />
                                                                                            </Border>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </Grid>

                                                    <!-- Vue 3 : Favoris (Signets / Bookmarks) -->
                                                    <Grid Visibility="{x:Bind ViewModel.InboxBookmarksVisibility, Mode=OneWay}">
                                                        <!-- État vide : aucun favori -->
                                                        <StackPanel Visibility="{x:Bind ViewModel.HasBookmarks, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                                                                    Spacing="8" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Border Width="48" Height="48" CornerRadius="24" Background="#2B2D31" HorizontalAlignment="Center">
                                                                <FontIcon Glyph="&#xE8A4;" FontSize="20" Foreground="#FEE75C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <TextBlock Text="Aucun favori enregistré" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" />
                                                            <TextBlock Text="Faites un clic droit sur un message pour l'enregistrer dans vos favoris." FontSize="12" Opacity="0.6" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="280" />
                                                        </StackPanel>

                                                        <!-- Liste des favoris -->
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                      Visibility="{x:Bind ViewModel.HasBookmarks, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <ItemsControl ItemsSource="{x:Bind ViewModel.Bookmarks, Mode=OneWay}" Padding="10,0,10,10">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:DiscordMessage">
                                                                        <Border Background="#2B2D31" BorderBrush="#383A40" BorderThickness="1"
                                                                                CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                                            <Grid RowSpacing="6">
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                </Grid.RowDefinitions>
                                                                                <!-- En-tête : Auteur + Date + Boutons -->
                                                                                <Grid Grid.Row="0">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Margin="0,0,8,0">
                                                                                        <Ellipse>
                                                                                            <Ellipse.Fill>
                                                                                                <ImageBrush ImageSource="{x:Bind Author.AvatarUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                                            </Ellipse.Fill>
                                                                                        </Ellipse>
                                                                                    </Border>
                                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                                        <TextBlock Text="{x:Bind Author.DisplayName}" FontWeight="SemiBold" FontSize="12" />
                                                                                        <TextBlock Text="{x:Bind TimeText}" FontSize="10" Opacity="0.5" />
                                                                                    </StackPanel>
                                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                                                                        <Button Content="Aller" FontSize="10" Padding="8,3" CornerRadius="4"
                                                                                                Style="{StaticResource AccentButtonStyle}"
                                                                                                Tag="{x:Bind}" Click="OnInboxJumpToMessageClicked"
                                                                                                ToolTipService.ToolTip="Afficher dans la conversation" />
                                                                                        <Button Content="&#xE74D;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="10" Padding="6,3" CornerRadius="4"
                                                                                                Background="#1E1F22" BorderThickness="0" Foreground="#FF453A"
                                                                                                Tag="{x:Bind}" Click="OnInboxRemoveBookmarkClicked"
                                                                                                ToolTipService.ToolTip="Retirer des favoris" />
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                                <TextBlock Grid.Row="1" Text="{x:Bind Content}" TextWrapping="Wrap" FontSize="12" Opacity="0.95" Margin="36,0,0,0"
                                                                                           Visibility="{x:Bind HasContent, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                                <ItemsControl Grid.Row="2" ItemsSource="{x:Bind ImageAttachments}" Margin="36,2,0,0"
                                                                                              Visibility="{x:Bind HasImages, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate x:DataType="models:DiscordAttachment">
                                                                                            <Border CornerRadius="6" Margin="0,2,0,2">
                                                                                                <Image Source="{x:Bind Url, Converter={StaticResource StringToImageSourceConverter}}"
                                                                                                       MaxHeight="100" MaxWidth="180" Stretch="UniformToFill" />
                                                                                            </Border>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>

                                <!-- Barre de Recherche dans le salon (Ctrl+F) -->
                                <AutoSuggestBox x:Name="InChannelSearchBox" Width="145" PlaceholderText="Rechercher"
                                                QueryIcon="Find" CornerRadius="6" VerticalAlignment="Center"
                                                TextChanged="OnChannelSearchTextChanged"
                                                QuerySubmitted="OnChannelSearchQuerySubmitted"
                                                ToolTipService.ToolTip="Rechercher dans ce salon (Ctrl+F)" />


                                <!-- Bouton Fils de discussion (Threads) avec Flyout des fils actifs et création -->
                                <Button Width="34" Height="34" Padding="0" CornerRadius="8" Background="Transparent" BorderThickness="0"
                                        ToolTipService.ToolTip="Fils de discussion" Click="OnThreadsButtonClicked">
                                    <FontIcon Glyph="&#xE8BD;" FontSize="15" />
                                    <Button.Flyout>
                                        <Flyout x:Name="ChannelThreadsFlyout" Placement="BottomEdgeAlignedRight">
                                            <Flyout.FlyoutPresenterStyle>
                                                <Style TargetType="FlyoutPresenter">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="CornerRadius" Value="12" />
                                                    <Setter Property="Background" Value="#1E1F22" />
                                                    <Setter Property="BorderBrush" Value="#2B2D31" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="MaxWidth" Value="380" />
                                                    <Setter Property="MaxHeight" Value="480" />
                                                </Style>
                                            </Flyout.FlyoutPresenterStyle>
                                            <Grid Width="360" Height="420">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- En-tête -->
                                                <Grid Grid.Row="0" Padding="14,12,14,8">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE8BD;" FontSize="16" Foreground="#5865F2" VerticalAlignment="Center" />
                                                        <TextBlock Text="Fils de discussion" FontWeight="Bold" FontSize="14" Foreground="#F2F3F5" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Liste des fils actifs -->
                                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                    <StackPanel Padding="10,0,10,10" Spacing="6">
                                                        <!-- Message si aucun fil -->
                                                        <StackPanel Visibility="{x:Bind ViewModel.HasChannelActiveThreads, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                                                                    Spacing="8" Padding="20" HorizontalAlignment="Center">
                                                            <Border Width="44" Height="44" CornerRadius="22" Background="#2B2D31" HorizontalAlignment="Center">
                                                                <FontIcon Glyph="&#xE8BD;" FontSize="18" Foreground="#949BA4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <TextBlock Text="Aucun fil actif dans ce salon." FontSize="12" Opacity="0.6" HorizontalAlignment="Center" />
                                                        </StackPanel>

                                                        <!-- Items des fils -->
                                                        <ItemsControl ItemsSource="{x:Bind ViewModel.ChannelActiveThreads, Mode=OneWay}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:DiscordChannel">
                                                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                            Background="#2B2D31" BorderBrush="#383A40" BorderThickness="1"
                                                                            CornerRadius="8" Padding="10,8" Margin="0,0,0,6"
                                                                            Tag="{x:Bind}" Click="OnSelectThreadFromFlyoutClicked">
                                                                        <Grid ColumnSpacing="8">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <FontIcon Grid.Column="0" Glyph="&#xE8BD;" FontSize="14" Foreground="#5865F2" VerticalAlignment="Center" />
                                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                                <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                                                <TextBlock Text="{x:Bind ThreadMessageCountText}" FontSize="10" Opacity="0.6" />
                                                                            </StackPanel>
                                                                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
                                                                        </Grid>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </ScrollViewer>

                                                <!-- Bouton Créer un nouveau fil -->
                                                <Border Grid.Row="2" Padding="12,8" Background="#111214" CornerRadius="0,0,12,12">
                                                    <Button HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                                                            CornerRadius="6" Padding="10,6" Click="OnCreateNewThreadDialogClicked">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                                                            <TextBlock Text="Nouveau fil de discussion" FontSize="12" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </Button>
                                                </Border>
                                            </Grid>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>

                                <!-- Afficher / Masquer la liste des membres -->
                                <Button Width="34" Height="34" Padding="0" CornerRadius="8" Background="Transparent" BorderThickness="0"
                                        Click="OnToggleMemberListClicked" ToolTipService.ToolTip="Afficher / Masquer les participants">
                                    <FontIcon Glyph="&#xE716;" FontSize="15" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        </Grid>
                    </Border>

                    <!-- VUE PRINCIPALE DES AMIS & EN COURS (FRIENDS MAIN STAGE & ACTIVE NOW) -->
                    <Grid Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="3"
                          Visibility="{x:Bind ViewModel.FriendsMainStageVisibility, Mode=OneWay}"
                          Background="#313338">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="340" />
                        </Grid.ColumnDefinitions>

                        <!-- COLONNE GAUCHE / CENTRALE : Liste des Amis ou Vue Ajouter un ami -->
                        <Grid Grid.Column="0" Margin="24,16,16,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 1. CAS ONGLET LISTE D'AMIS (Online, All, Pending, Blocked) -->
                            <!-- Barre de recherche -->
                            <Grid Grid.Row="0" Visibility="{x:Bind ViewModel.FriendsListVisibility, Mode=OneWay}" Margin="0,0,0,16">
                                <TextBox PlaceholderText="Rechercher"
                                         Text="{x:Bind ViewModel.FriendsSearchQuery, Mode=TwoWay}"
                                         TextChanged="OnFriendsSearchTextChanged"
                                         Height="36" CornerRadius="6"
                                         Padding="12,6,36,6"
                                         Background="#1E1F22" Foreground="#F2F3F5" BorderBrush="#2B2D31" BorderThickness="1"
                                         FontSize="13" />
                                <FontIcon Glyph="&#xE721;" FontSize="13" Foreground="#949BA4"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False" />
                            </Grid>

                            <!-- Titre de section (ex: EN LIGNE — 5) -->
                            <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.FriendsSectionTitleText, Mode=OneWay}"
                                       FontSize="12" FontWeight="Bold" Foreground="#949BA4" Margin="4,0,0,10"
                                       Visibility="{x:Bind ViewModel.FriendsListVisibility, Mode=OneWay}" />

                            <!-- Liste des Amis avec Cartes 1:1 Discord -->
                            <ListView Grid.Row="2"
                                      ItemsSource="{x:Bind ViewModel.FilteredFriends, Mode=OneWay}"
                                      SelectionMode="None"
                                      Padding="0"
                                      Visibility="{x:Bind ViewModel.FriendsListVisibility, Mode=OneWay}">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,2" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:DiscordRelationship">
                                        <Border Height="62" CornerRadius="8" Background="Transparent"
                                                BorderBrush="#1F2023" BorderThickness="0,1,0,0" Padding="10,0"
                                                PointerEntered="OnFriendCardPointerEntered" PointerExited="OnFriendCardPointerExited">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Avatar 40x40 avec pastille de statut en bas à droite -->
                                                <Grid Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <Border CornerRadius="20" Background="#2B2D31">
                                                        <Border CornerRadius="20" Visibility="{x:Bind User.HasAvatar, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{x:Bind User.AvatarUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                            </Border.Background>
                                                        </Border>
                                                    </Border>
                                                    <!-- Pastille de présence -->
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                            Margin="0,0,-2,-2" Width="14" Height="14" CornerRadius="7"
                                                            Background="#1E1F22" BorderBrush="#1E1F22" BorderThickness="2">
                                                        <Ellipse Fill="{x:Bind User.StatusColor, Mode=OneWay}" />
                                                    </Border>
                                                </Grid>

                                                <!-- Noms et Statut / Activité -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind User.DisplayName}" FontWeight="Bold" FontSize="14" Foreground="#F2F3F5" />
                                                        <TextBlock Text="{x:Bind User.UserTag}" FontSize="12" Foreground="#949BA4" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind SubtitleDisplay, Mode=OneWay}" FontSize="12" Foreground="#949BA4" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                </StackPanel>

                                                <!-- Boutons d'Action Rapides à Droite -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <!-- Bouton Message (si Ami) -->
                                                    <Button Width="36" Height="36" CornerRadius="18" Padding="0"
                                                            Background="#2B2D31" BorderThickness="0"
                                                            Tag="{x:Bind}" Click="OnFriendMessageClicked"
                                                            Visibility="{x:Bind IsFriend, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            ToolTipService.ToolTip="Envoyer un message">
                                                        <FontIcon Glyph="&#xE8BD;" FontSize="15" Foreground="#DBDEE1" />
                                                    </Button>

                                                    <!-- Bouton Appel Vocal (si Ami) -->
                                                    <Button Width="36" Height="36" CornerRadius="18" Padding="0"
                                                            Background="#2B2D31" BorderThickness="0"
                                                            Tag="{x:Bind}" Click="OnFriendCallClicked"
                                                            Visibility="{x:Bind IsFriend, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            ToolTipService.ToolTip="Démarrer un appel vocal">
                                                        <FontIcon Glyph="&#xE717;" FontSize="14" Foreground="#DBDEE1" />
                                                    </Button>

                                                    <!-- Bouton Accepter (si Demande Reçue) -->
                                                    <Button Width="36" Height="36" CornerRadius="18" Padding="0"
                                                            Background="#23A55A" BorderThickness="0"
                                                            Tag="{x:Bind}" Click="OnAcceptFriendRequestClicked"
                                                            Visibility="{x:Bind IsPendingIncoming, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            ToolTipService.ToolTip="Accepter la demande d'ami">
                                                        <FontIcon Glyph="&#xE8FB;" FontSize="15" Foreground="White" />
                                                    </Button>

                                                    <!-- Bouton Refuser / Annuler (si En attente) -->
                                                    <Button Width="36" Height="36" CornerRadius="18" Padding="0"
                                                            Background="#DA373C" BorderThickness="0"
                                                            Tag="{x:Bind}" Click="OnDeclineFriendRequestClicked"
                                                            Visibility="{x:Bind IsPending, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            ToolTipService.ToolTip="Refuser / Annuler la demande">
                                                        <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="White" />
                                                    </Button>

                                                    <!-- Bouton Débloquer (si Bloqué) -->
                                                    <Button Width="36" Height="36" CornerRadius="18" Padding="0"
                                                            Background="#2B2D31" BorderThickness="0"
                                                            Tag="{x:Bind}" Click="OnUnblockFriendClicked"
                                                            Visibility="{x:Bind IsBlocked, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            ToolTipService.ToolTip="Débloquer l'utilisateur">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#F23F43" />
                                                    </Button>

                                                    <!-- Menu Plus d'options (...) -->
                                                    <Button Width="36" Height="36" CornerRadius="18" Padding="0"
                                                            Background="#2B2D31" BorderThickness="0"
                                                            Visibility="{x:Bind IsFriend, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            ToolTipService.ToolTip="Plus d'options">
                                                        <FontIcon Glyph="&#xE712;" FontSize="14" Foreground="#DBDEE1" />
                                                        <Button.Flyout>
                                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                <MenuFlyoutItem Text="Démarrer un appel vidéo" Tag="{x:Bind}" Click="OnFriendVideoCallClicked">
                                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE714;" /></MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem Text="Afficher le profil" Tag="{x:Bind}" Click="OnFriendProfileClicked">
                                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77B;" /></MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutSeparator />
                                                                <MenuFlyoutItem Text="Bloquer" Tag="{x:Bind}" Click="OnBlockFriendFromMenuClicked">
                                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F8;" /></MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem Text="Retirer de la liste d'amis" Tag="{x:Bind}" Click="OnRemoveFriendFromMenuClicked" Foreground="#F23F43">
                                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" Foreground="#F23F43" /></MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- 2. CAS ONGLET AJOUTER UN AMI -->
                            <StackPanel Grid.Row="0" Grid.RowSpan="3"
                                        Visibility="{x:Bind ViewModel.AddFriendStageVisibility, Mode=OneWay}"
                                        Spacing="16" Margin="8,8,8,0">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="AJOUTER UN AMI" FontSize="16" FontWeight="Bold" Foreground="#F2F3F5" />
                                    <TextBlock Text="Tu peux ajouter des amis avec leur nom d'utilisateur Discord." FontSize="13" Foreground="#949BA4" />
                                </StackPanel>

                                <Grid MaxWidth="600" HorizontalAlignment="Left">
                                    <TextBox x:Name="AddFriendInputBox"
                                             PlaceholderText="Tu peux ajouter des amis avec leur nom d'utilisateur Discord"
                                             Text="{x:Bind ViewModel.AddFriendInput, Mode=TwoWay}"
                                             KeyDown="OnAddFriendInputKeyDown"
                                             Height="48" Width="560" CornerRadius="8"
                                             Padding="16,10,180,10"
                                             Background="#1E1F22" Foreground="#F2F3F5" BorderBrush="#2B2D31" BorderThickness="1"
                                             FontSize="14" />
                                    <Button Content="Envoyer une demande"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                                            Height="36" Padding="14,0" CornerRadius="6"
                                            Background="#5865F2" Foreground="White" FontWeight="SemiBold" FontSize="13"
                                            Click="OnSubmitAddFriendClicked" />
                                </Grid>

                                <!-- Message de feedback après envoi -->
                                <Border Visibility="{x:Bind ViewModel.HasAddFriendFeedback, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{x:Bind ViewModel.AddFriendFeedbackBackground, Mode=OneWay}"
                                        CornerRadius="8" Padding="14,10" MaxWidth="560" HorizontalAlignment="Left">
                                    <TextBlock Text="{x:Bind ViewModel.AddFriendFeedbackMessage, Mode=OneWay}"
                                               Foreground="{x:Bind ViewModel.AddFriendFeedbackForeground, Mode=OneWay}" FontSize="13" />
                                </Border>

                                <!-- Illustration décorative Wumpus -->
                                <StackPanel HorizontalAlignment="Center" Margin="0,48,0,0" Spacing="12">
                                    <Border Width="80" Height="80" CornerRadius="40" Background="#2B2D31" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE77B;" FontSize="36" Foreground="#5865F2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Wumpus attend des amis !" FontSize="15" FontWeight="Bold" Foreground="#DBDEE1" HorizontalAlignment="Center" />
                                    <TextBlock Text="Invite tes amis sur Diswin pour discuter, jouer et partager en direct." FontSize="13" Foreground="#949BA4" HorizontalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Séparateur vertical -->
                        <Border Grid.Column="1" Width="1" Background="#1F2023" />

                        <!-- COLONNE DROITE : "En cours" (Active Now) -->
                        <Grid Grid.Column="2" Padding="20,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="En cours" FontSize="18" FontWeight="Bold" Foreground="#F2F3F5" Margin="0,0,0,16" />

                            <!-- Liste des activités en cours des amis -->
                            <ListView Grid.Row="1"
                                      ItemsSource="{x:Bind ViewModel.ActiveNowFriends, Mode=OneWay}"
                                      SelectionMode="None"
                                      Padding="0"
                                      Visibility="{x:Bind ViewModel.HasActiveNowFriends, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,10" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:DiscordRelationship">
                                        <Border Background="#2B2D31" BorderBrush="#1E1F22" BorderThickness="1" CornerRadius="8" Padding="12">
                                            <StackPanel Spacing="8">
                                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                    <Grid Width="32" Height="32">
                                                        <Border CornerRadius="16" Background="#1E1F22">
                                                            <Border CornerRadius="16" Visibility="{x:Bind User.HasAvatar, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{x:Bind User.AvatarUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                </Border.Background>
                                                            </Border>
                                                        </Border>
                                                        <Ellipse Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                 Fill="{x:Bind User.StatusColor, Mode=OneWay}" Stroke="#2B2D31" StrokeThickness="1.5" />
                                                    </Grid>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind User.DisplayName}" FontWeight="Bold" FontSize="13" Foreground="#F2F3F5" />
                                                        <TextBlock Text="{x:Bind User.UserTag}" FontSize="11" Foreground="#949BA4" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Détail du Jeu / Activité -->
                                                <Border Background="#1E1F22" CornerRadius="6" Padding="10,8">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Border Width="24" Height="24" CornerRadius="4" Background="#111214" VerticalAlignment="Center">
                                                            <Image Source="{x:Bind User.CurrentGameIconUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                                   Stretch="UniformToFill"
                                                                   Visibility="{x:Bind User.HasCurrentGameIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind User.CurrentGameName, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" Foreground="#F2F3F5" />
                                                            <TextBlock Text="{x:Bind User.ActivitySummaryText, Mode=OneWay}" FontSize="11" Foreground="#949BA4" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- État vide si aucune activité en cours -->
                            <StackPanel Grid.Row="1"
                                        Visibility="{x:Bind ViewModel.HasActiveNowFriends, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="0,30,0,0">
                                <FontIcon Glyph="&#xE7FC;" FontSize="36" Foreground="#4E5058" HorizontalAlignment="Center" />
                                <TextBlock Text="C'est bien calme par ici..." FontSize="14" FontWeight="Bold" Foreground="#DBDEE1" HorizontalAlignment="Center" />
                                <TextBlock Text="Quand tes amis jouent à des jeux ou écoutent de la musique, leur activité apparaîtra ici !"
                                           FontSize="12" Foreground="#949BA4" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="240" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- VUE VOCALE (Scène de partage d'écran Go Live + Grille de participants avec encadrement vert + Barre de contrôle complète) -->
                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Visibility="{x:Bind ViewModel.VoiceViewVisibility, Mode=OneWay}" Padding="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Scène de Partage d'Écran en Direct (Go Live Stage) -->
                        <Border Grid.Row="0" Height="340" Margin="10,0,10,14" CornerRadius="16"
                                Background="#111214" BorderBrush="#23A55A" BorderThickness="2"
                                Visibility="{x:Bind ViewModel.ScreenShareStageVisibility, Mode=OneWay}">
                            <Grid>
                                <Image x:Name="LiveScreenShareImage" Stretch="Uniform" />

                                <!-- Bandeau supérieur : EN DIRECT + Résolution/FPS + Titre de la source -->
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,12">
                                    <Border Background="#DA373C" CornerRadius="6" Padding="8,3">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="White" VerticalAlignment="Center" />
                                            <TextBlock Text="EN DIRECT" Foreground="White" FontWeight="Bold" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#99000000" CornerRadius="6" Padding="8,3">
                                        <TextBlock Text="{x:Bind ViewModel.ScreenShareQualityBadge, Mode=OneWay}" Foreground="White" FontWeight="SemiBold" FontSize="11" />
                                    </Border>
                                    <Border Background="#99000000" CornerRadius="6" Padding="10,3">
                                        <TextBlock Text="{x:Bind ViewModel.ScreenShareTitle, Mode=OneWay}" Foreground="White" FontWeight="SemiBold" FontSize="11" MaxWidth="360" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </StackPanel>

                                <!-- Boutons rapides sur le stream : Changer de fenêtre / Arrêter le stream -->
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14,12">
                                    <Button Content="Changer de source" FontSize="11" Padding="10,5" CornerRadius="8"
                                            Background="#AA000000" Foreground="White" BorderThickness="0"
                                            Click="OnChangeScreenShareSourceClicked" />
                                    <Button Content="Arrêter le stream" FontSize="11" Padding="10,5" CornerRadius="8"
                                            Background="#DA373C" Foreground="White" BorderThickness="0"
                                            Click="OnStopScreenShareClicked" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <GridView Grid.Row="1" ItemsSource="{x:Bind ViewModel.VoiceParticipants, Mode=OneWay}" SelectionMode="None" Margin="0,0,0,76">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:DiscordUser">
                                    <Grid Width="260" Height="190" Margin="10">
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Profil" Tag="{x:Bind}" Click="OnUserMenuProfileClicked">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77B;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Mentionner" Tag="{x:Bind}" Click="OnUserMenuMentionClicked">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE910;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Message privé" Tag="{x:Bind}" Click="OnUserMenuDirectMessageClicked">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8BD;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Appeler" Tag="{x:Bind}" Click="OnUserMenuCallClicked">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE717;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutSubItem Text="Volume utilisateur">
                                                    <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE767;" /></MenuFlyoutSubItem.Icon>
                                                    <MenuFlyoutItem Text="200% (Maximum)" Tag="2.0" Click="OnUserMenuSetVolumeClicked" />
                                                    <MenuFlyoutItem Text="150%" Tag="1.5" Click="OnUserMenuSetVolumeClicked" />
                                                    <MenuFlyoutItem Text="100% (Normal)" Tag="1.0" Click="OnUserMenuSetVolumeClicked" />
                                                    <MenuFlyoutItem Text="75%" Tag="0.75" Click="OnUserMenuSetVolumeClicked" />
                                                    <MenuFlyoutItem Text="50%" Tag="0.5" Click="OnUserMenuSetVolumeClicked" />
                                                    <MenuFlyoutItem Text="25%" Tag="0.25" Click="OnUserMenuSetVolumeClicked" />
                                                    <MenuFlyoutItem Text="Couper le son (0%)" Tag="0.0" Click="OnUserMenuSetVolumeClicked" />
                                                </MenuFlyoutSubItem>
                                                <MenuFlyoutItem Text="Mettre en sourdine locale" Tag="{x:Bind}" Click="OnUserMenuToggleMuteClicked">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74F;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Ajouter en ami" Tag="{x:Bind}" Click="OnUserMenuAddFriendClicked">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FA;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Bloquer" Foreground="#FF453A" Tag="{x:Bind}" Click="OnUserMenuBlockClicked">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE894;" Foreground="#FF453A" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Copier le nom d'utilisateur" Tag="{x:Bind}" Click="OnUserMenuCopyUsernameClicked">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Copier le pseudo" Tag="{x:Bind}" Click="OnUserMenuCopyDisplayNameClicked">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Copier l'identifiant" Tag="{x:Bind}" Click="OnUserMenuCopyIdClicked">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                        <!-- Carte de fond -->
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                CornerRadius="16">
                                            <Grid>
                                                <!-- Avatar du participant -->
                                                <Ellipse Width="88" Height="88" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{x:Bind AvatarUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                    </Ellipse.Fill>
                                                </Ellipse>

                                                <!-- Cercle vert autour de l'avatar quand le micro détecte la voix -->
                                                <Ellipse Width="96" Height="96" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Stroke="#23A55A" StrokeThickness="3.5" Fill="Transparent"
                                                         Opacity="{x:Bind SpeakingRingOpacity, Mode=OneWay}"
                                                         IsHitTestVisible="False" />

                                                <!-- Badge rouge EN DIRECT en haut à droite si le participant partage son écran -->
                                                <Border Background="#DA373C" CornerRadius="6" Padding="7,2"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                                                        Opacity="{x:Bind StreamingBadgeOpacity, Mode=OneWay}">
                                                    <TextBlock Text="EN DIRECT" Foreground="White" FontWeight="Bold" FontSize="10" />
                                                </Border>

                                                <!-- Nom du participant en bas à gauche de la carte -->
                                                <Border Background="#66000000" CornerRadius="8" Padding="8,4"
                                                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Ellipse Width="8" Height="8" Fill="#23A55A" VerticalAlignment="Center"
                                                                 Opacity="{x:Bind SpeakingRingOpacity, Mode=OneWay}" />
                                                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" Foreground="White" FontWeight="SemiBold" FontSize="12" MaxWidth="145" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Indicateurs Caméra / Micro coupé / Casque coupé en bas à droite de la carte -->
                                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12">
                                                    <Border Background="#99000000" CornerRadius="6" Padding="5,4"
                                                            Opacity="{x:Bind VideoBadgeOpacity, Mode=OneWay}">
                                                        <FontIcon Glyph="&#xE714;" FontSize="11" Foreground="#23A55A" />
                                                    </Border>
                                                    <Border Background="#CCDA373C" CornerRadius="6" Padding="5,4"
                                                            Opacity="{x:Bind VoiceMutedOpacity, Mode=OneWay}">
                                                        <FontIcon Glyph="&#xE720;" FontSize="11" Foreground="White" />
                                                    </Border>
                                                    <Border Background="#CCDA373C" CornerRadius="6" Padding="5,4"
                                                            Opacity="{x:Bind VoiceDeafenedOpacity, Mode=OneWay}">
                                                        <FontIcon Glyph="&#xE7F6;" FontSize="11" Foreground="White" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Encadrement vert par-dessus toute la tuile quand le participant parle (comme sur Discord) -->
                                        <Border CornerRadius="16" BorderBrush="#23A55A" BorderThickness="3"
                                                Opacity="{x:Bind SpeakingRingOpacity, Mode=OneWay}"
                                                IsHitTestVisible="False" />
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <!-- Barre flottante de contrôles vocaux en bas de la vue vocale (Caméra, Partager l'écran Go Live, Micro, Casque, Krisp, Raccrocher) -->
                        <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="28" Padding="14,8">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Button Width="44" Height="44" CornerRadius="22" Padding="0"
                                        Click="OnToggleCameraClicked"
                                        Opacity="{x:Bind ViewModel.CameraOpacity, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.CameraTooltipText, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE714;" FontSize="16" Foreground="{x:Bind ViewModel.CameraIconBrush, Mode=OneWay}" />
                                </Button>
                                <Button Height="44" CornerRadius="22" Padding="14,0"
                                        Click="OnScreenShareClicked"
                                        Opacity="{x:Bind ViewModel.ScreenShareOpacity, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.ScreenShareTooltipText, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="{x:Bind ViewModel.ScreenShareIconBrush, Mode=OneWay}" />
                                        <TextBlock Text="Partager l'écran" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Width="44" Height="44" CornerRadius="22" Padding="0"
                                        Click="OnToggleMuteClicked" ToolTipService.ToolTip="Couper / Activer le micro">
                                    <FontIcon Glyph="&#xE720;" FontSize="16" Opacity="{x:Bind ViewModel.MuteOpacity, Mode=OneWay}" />
                                </Button>
                                <Button Width="44" Height="44" CornerRadius="22" Padding="0"
                                        Click="OnToggleDeafenClicked" ToolTipService.ToolTip="Mettre en sourdine">
                                    <FontIcon Glyph="&#xE7F6;" FontSize="16" Opacity="{x:Bind ViewModel.DeafenOpacity, Mode=OneWay}" />
                                </Button>
                                <Button Height="44" CornerRadius="22" Padding="14,0"
                                        Click="OnToggleKrispClicked"
                                        Opacity="{x:Bind ViewModel.KrispOpacity, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.KrispTooltipText, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE9F5;" FontSize="16" Foreground="{x:Bind ViewModel.KrispIconBrush, Mode=OneWay}" />
                                        <TextBlock Text="Krisp" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Height="44" CornerRadius="22" Padding="14,0"
                                        ToolTipService.ToolTip="Ouvrir le Soundboard">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE74F;" FontSize="16" Foreground="#5865F2" />
                                        <TextBlock Text="Sons" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout x:Name="VoiceBarSoundboardFlyout" Placement="Top" Opening="OnVoiceSoundboardFlyoutOpening">
                                            <Flyout.FlyoutPresenterStyle>
                                                <Style TargetType="FlyoutPresenter">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="CornerRadius" Value="12" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="MaxWidth" Value="390" />
                                                    <Setter Property="MaxHeight" Value="460" />
                                                </Style>
                                            </Flyout.FlyoutPresenterStyle>
                                            <controls:DiscordSoundboardPickerControl x:Name="VoiceBarSoundboardPicker"
                                                                                     SoundSelected="OnSoundboardPickerSoundSelected" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <Button Width="44" Height="44" CornerRadius="22" Padding="0" Background="#DA373C" BorderThickness="0"
                                        Click="OnDisconnectVoiceClicked" ToolTipService.ToolTip="Quitter le salon vocal">
                                    <FontIcon Glyph="&#xE711;" FontSize="15" Foreground="White" />
                                </Button>

                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- VUE TEXTUELLE (Messages complets : Réponses, Édition, Stickers, Fichiers, Sondages) -->
                    <ListView Grid.Row="1" Grid.Column="0" x:Name="MessageList"
                              Visibility="{x:Bind ViewModel.TextViewVisibility, Mode=OneWay}"
                              ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
                              Padding="16,8"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DiscordMessage">
                                <Grid Margin="0,1,0,3">
                                    <Border Background="#2B5865F2" CornerRadius="6"
                                            Visibility="{x:Bind IsHighlighted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <StackPanel Padding="6,2" Spacing="2">
                                    <StackPanel.ContextFlyout>
                                        <Flyout Placement="RightEdgeAlignedTop">
                                            <Flyout.FlyoutPresenterStyle>
                                                <Style TargetType="FlyoutPresenter">
                                                    <Setter Property="Padding" Value="6" />
                                                    <Setter Property="CornerRadius" Value="8" />
                                                    <Setter Property="Background" Value="#111214" />
                                                    <Setter Property="BorderBrush" Value="#2B2D31" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="MinWidth" Value="230" />
                                                    <Setter Property="MaxWidth" Value="250" />
                                                </Style>
                                            </Flyout.FlyoutPresenterStyle>
                                            <StackPanel Spacing="2" Tag="{x:Bind}">
                                                <!-- 1. Rangée horizontale de réactions rapides -->
                                                <Border Background="#1E1F22" CornerRadius="8" Padding="4,2" Margin="2,2,2,4">
                                                    <Grid HorizontalAlignment="Stretch">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Column="0" Content="👏" FontSize="16" Height="32" Width="46" Padding="0"
                                                                Background="Transparent" BorderThickness="0" CornerRadius="6"
                                                                HorizontalAlignment="Center" Tag="{x:Bind}" Click="OnQuickReactClapClicked" />
                                                        <Button Grid.Column="1" Content="👍" FontSize="16" Height="32" Width="46" Padding="0"
                                                                Background="Transparent" BorderThickness="0" CornerRadius="6"
                                                                HorizontalAlignment="Center" Tag="{x:Bind}" Click="OnQuickReactThumbsUpClicked" />
                                                        <Button Grid.Column="2" Content="😂" FontSize="16" Height="32" Width="46" Padding="0"
                                                                Background="Transparent" BorderThickness="0" CornerRadius="6"
                                                                HorizontalAlignment="Center" Tag="{x:Bind}" Click="OnQuickReactJoyClicked" />
                                                        <Button Grid.Column="3" Content="❤️" FontSize="16" Height="32" Width="46" Padding="0"
                                                                Background="Transparent" BorderThickness="0" CornerRadius="6"
                                                                HorizontalAlignment="Center" Tag="{x:Bind}" Click="OnQuickReactHeartClicked" />
                                                    </Grid>
                                                </Border>

                                                <!-- 2. Add Reaction > -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Height="34" Margin="2,0" Tag="{x:Bind}">
                                                    <Button.Flyout>
                                                        <Flyout Placement="RightEdgeAlignedTop">
                                                            <Flyout.FlyoutPresenterStyle>
                                                                <Style TargetType="FlyoutPresenter">
                                                                    <Setter Property="Padding" Value="8" />
                                                                    <Setter Property="CornerRadius" Value="8" />
                                                                    <Setter Property="Background" Value="#111214" />
                                                                    <Setter Property="BorderBrush" Value="#2B2D31" />
                                                                    <Setter Property="BorderThickness" Value="1" />
                                                                </Style>
                                                            </Flyout.FlyoutPresenterStyle>
                                                            <StackPanel Width="180" Spacing="6" Tag="{x:Bind}">
                                                                <TextBlock Text="Réactions" FontSize="11" FontWeight="Bold" Opacity="0.6" Margin="4,0,0,2" />
                                                                <Grid HorizontalAlignment="Center">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="34" />
                                                                        <ColumnDefinition Width="34" />
                                                                        <ColumnDefinition Width="34" />
                                                                        <ColumnDefinition Width="34" />
                                                                        <ColumnDefinition Width="34" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Button Grid.Row="0" Grid.Column="0" Content="👍" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Tag="{x:Bind}" Click="OnQuickReactThumbsUpClicked" />
                                                                    <Button Grid.Row="0" Grid.Column="1" Content="❤️" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Tag="{x:Bind}" Click="OnQuickReactHeartClicked" />
                                                                    <Button Grid.Row="0" Grid.Column="2" Content="😂" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Tag="{x:Bind}" Click="OnQuickReactJoyClicked" />
                                                                    <Button Grid.Row="0" Grid.Column="3" Content="🔥" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Tag="{x:Bind}" Click="OnQuickReactFireClicked" />
                                                                    <Button Grid.Row="0" Grid.Column="4" Content="🎉" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Tag="{x:Bind}" Click="OnAddCustomReactionClicked" />

                                                                    <Button Grid.Row="1" Grid.Column="0" Content="💯" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Tag="{x:Bind}" Click="OnAddCustomReactionClicked" />
                                                                    <Button Grid.Row="1" Grid.Column="1" Content="😭" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Tag="{x:Bind}" Click="OnAddCustomReactionClicked" />
                                                                    <Button Grid.Row="1" Grid.Column="2" Content="🤔" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Tag="{x:Bind}" Click="OnAddCustomReactionClicked" />
                                                                    <Button Grid.Row="1" Grid.Column="3" Content="🙏" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Tag="{x:Bind}" Click="OnAddCustomReactionClicked" />
                                                                    <Button Grid.Row="1" Grid.Column="4" Content="👀" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Tag="{x:Bind}" Click="OnAddCustomReactionClicked" />

                                                                    <Button Grid.Row="2" Grid.Column="0" Content="🚀" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Tag="{x:Bind}" Click="OnAddCustomReactionClicked" />
                                                                    <Button Grid.Row="2" Grid.Column="1" Content="👏" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Tag="{x:Bind}" Click="OnQuickReactClapClicked" />
                                                                    <Button Grid.Row="2" Grid.Column="2" Content="✨" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Tag="{x:Bind}" Click="OnAddCustomReactionClicked" />
                                                                    <Button Grid.Row="2" Grid.Column="3" Content="⭐" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Tag="{x:Bind}" Click="OnAddCustomReactionClicked" />
                                                                    <Button Grid.Row="2" Grid.Column="4" Content="💀" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Tag="{x:Bind}" Click="OnAddCustomReactionClicked" />
                                                                </Grid>
                                                                <Button HorizontalAlignment="Stretch" Background="#2B2D31" BorderThickness="0" CornerRadius="6"
                                                                        Padding="8,5" Margin="0,4,0,0" Tag="{x:Bind}" Click="OnOpenFullReactionPickerClicked">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                                        <FontIcon Glyph="&#xED54;" FontSize="13" Foreground="#949BA4" />
                                                                        <TextBlock Text="Tous les émojis..." FontSize="12" FontWeight="SemiBold" Foreground="#F2F3F5" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xED58;" FontSize="14" Opacity="0.85" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Add Reaction" FontSize="13" VerticalAlignment="Center" />
                                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <!-- 3. Edit Message (Uniquement pour mes messages) -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Height="34" Margin="2,0"
                                                        Visibility="{x:Bind IsOwnMessage, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Tag="{x:Bind}" Click="OnEditMessageClicked">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xE70F;" FontSize="14" Opacity="0.85" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Edit Message" FontSize="13" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <!-- 4. Reply -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Height="34" Margin="2,0"
                                                        Tag="{x:Bind}" Click="OnReplyMessageClicked">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xE97A;" FontSize="14" Opacity="0.85" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Reply" FontSize="13" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <!-- 5. Forward -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Height="34" Margin="2,0"
                                                        Tag="{x:Bind}" Click="OnForwardMessageClicked">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xE72D;" FontSize="14" Opacity="0.85" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Forward" FontSize="13" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <!-- Créer / Ouvrir un fil de discussion (Threads) -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Height="34" Margin="2,0"
                                                        Tag="{x:Bind}" Click="OnCreateThreadFromMessageClicked">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xE8BD;" FontSize="14" Opacity="0.85" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Créer un fil" FontSize="13" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <!-- Ligne de séparation -->
                                                <Border Height="1" Background="#2B2D31" Margin="4,3" />

                                                <!-- 6. Copy Text -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Height="34" Margin="2,0"
                                                        Tag="{x:Bind}" Click="OnCopyMessageTextClicked">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xE8C8;" FontSize="14" Opacity="0.85" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Copy Text" FontSize="13" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <!-- 7. Pin Message -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Height="34" Margin="2,0"
                                                        Tag="{x:Bind}" Click="OnTogglePinMessageClicked">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xE718;" FontSize="14" Opacity="0.85" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Pin Message" FontSize="13" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <!-- 8. Bookmark Message -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Height="34" Margin="2,0"
                                                        Tag="{x:Bind}" Click="OnBookmarkMessageClicked">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xE8A4;" FontSize="14" Opacity="0.85" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Bookmark Message" FontSize="13" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <!-- 9. Create Reminder > -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Height="34" Margin="2,0" Tag="{x:Bind}">
                                                    <Button.Flyout>
                                                        <Flyout Placement="RightEdgeAlignedTop">
                                                            <Flyout.FlyoutPresenterStyle>
                                                                <Style TargetType="FlyoutPresenter">
                                                                    <Setter Property="Padding" Value="6" />
                                                                    <Setter Property="CornerRadius" Value="8" />
                                                                    <Setter Property="Background" Value="#111214" />
                                                                    <Setter Property="BorderBrush" Value="#2B2D31" />
                                                                    <Setter Property="BorderThickness" Value="1" />
                                                                    <Setter Property="MinWidth" Value="160" />
                                                                </Style>
                                                            </Flyout.FlyoutPresenterStyle>
                                                            <StackPanel Spacing="2" Tag="{x:Bind}">
                                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Tag="{x:Bind}" Content="In 20 minutes" Click="OnCreateReminder20mClicked" />
                                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Tag="{x:Bind}" Content="In 1 hour" Click="OnCreateReminder1hClicked" />
                                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Tag="{x:Bind}" Content="In 3 hours" Click="OnCreateReminder3hClicked" />
                                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Tag="{x:Bind}" Content="Tomorrow" Click="OnCreateReminderTomorrowClicked" />
                                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Tag="{x:Bind}" Content="Next week" Click="OnCreateReminderNextWeekClicked" />
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xE823;" FontSize="14" Opacity="0.85" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Create Reminder" FontSize="13" VerticalAlignment="Center" />
                                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <!-- 10. Apps > -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Height="34" Margin="2,0" Tag="{x:Bind}">
                                                    <Button.Flyout>
                                                        <Flyout Placement="RightEdgeAlignedTop">
                                                            <Flyout.FlyoutPresenterStyle>
                                                                <Style TargetType="FlyoutPresenter">
                                                                    <Setter Property="Padding" Value="8" />
                                                                    <Setter Property="CornerRadius" Value="8" />
                                                                    <Setter Property="Background" Value="#111214" />
                                                                    <Setter Property="BorderBrush" Value="#2B2D31" />
                                                                    <Setter Property="BorderThickness" Value="1" />
                                                                </Style>
                                                            </Flyout.FlyoutPresenterStyle>
                                                            <StackPanel Width="170" Padding="4">
                                                                <TextBlock Text="No Apps Available" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" />
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xEA86;" FontSize="14" Opacity="0.85" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Apps" FontSize="13" VerticalAlignment="Center" />
                                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <!-- 11. Mark Unread -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Height="34" Margin="2,0"
                                                        Tag="{x:Bind}" Click="OnMarkUnreadClicked">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xE715;" FontSize="14" Opacity="0.85" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Mark Unread" FontSize="13" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <!-- 12. Copy Message Link -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Height="34" Margin="2,0"
                                                        Tag="{x:Bind}" Click="OnCopyMessageLinkClicked">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xE71B;" FontSize="14" Opacity="0.85" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Copy Message Link" FontSize="13" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <!-- 13. Speak Message -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Height="34" Margin="2,0"
                                                        Tag="{x:Bind}" Click="OnSpeakMessageClicked">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xE767;" FontSize="14" Opacity="0.85" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Speak Message" FontSize="13" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <!-- Ligne de séparation avant Delete/Report -->
                                                <Border Height="1" Background="#2B2D31" Margin="4,3" />

                                                <!-- 14. Delete Message (Uniquement pour mes messages) -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Height="34" Margin="2,0"
                                                        Visibility="{x:Bind IsOwnMessage, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Tag="{x:Bind}" Click="OnDeleteMessageClicked">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xE74D;" FontSize="14" Foreground="#F23F43" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Delete Message" FontSize="13" Foreground="#F23F43" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <!-- 15. Report Message (Uniquement pour les messages des autres) -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Height="34" Margin="2,0"
                                                        Visibility="{x:Bind IsNotOwnMessage, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Tag="{x:Bind}" Click="OnReportMessageClicked">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xE7C1;" FontSize="14" Foreground="#F23F43" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Report Message" FontSize="13" Foreground="#F23F43" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <!-- Ligne de séparation -->
                                                <Border Height="1" Background="#2B2D31" Margin="4,3" />

                                                <!-- 16. Copy Message ID -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Height="34" Margin="2,0"
                                                        Tag="{x:Bind}" Click="OnCopyMessageIdClicked">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xE943;" FontSize="14" Opacity="0.85" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Copy Message ID" FontSize="13" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </Flyout>
                                    </StackPanel.ContextFlyout>

                                    <!-- En-tête de réponse (ReferencedMessage) façon Discord / SakuraCord -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="20,8,0,0"
                                                Visibility="{x:Bind IsReply, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <FontIcon Glyph="&#xE97A;" FontSize="11" Opacity="0.6" />
                                        <Ellipse Width="16" Height="16">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{x:Bind ReplyAuthorAvatarUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock Text="{x:Bind ReplyAuthorName}" FontSize="12" FontWeight="SemiBold" Opacity="0.85" />
                                        <TextBlock Text="{x:Bind ReplyPreview}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,4"
                                                Visibility="{x:Bind ShowNormalHeader, Converter={StaticResource BoolToVisibilityConverter}}">

                                        <!-- Bouton avatar avec Popout Profil ultra détaillé façon Discord (couleurs custom Nitro, Tag Clan + icône, bulle statut, serveurs/amis en commun) -->
                                        <Button Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="20" VerticalAlignment="Top"
                                                PointerEntered="OnAvatarPointerEntered" PointerExited="OnAvatarPointerExited"
                                                DoubleTapped="OnAvatarDoubleTapped" ToolTipService.ToolTip="Cliquez pour le mini-profil, double-cliquez pour la vue complète">
                                            <Button.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="Profil" Tag="{x:Bind Author}" Click="OnUserMenuProfileClicked">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77B;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Mentionner" Tag="{x:Bind Author}" Click="OnUserMenuMentionClicked">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE910;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Message privé" Tag="{x:Bind Author}" Click="OnUserMenuDirectMessageClicked">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8BD;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Appeler" Tag="{x:Bind Author}" Click="OnUserMenuCallClicked">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE717;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutSubItem Text="Volume utilisateur">
                                                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE767;" /></MenuFlyoutSubItem.Icon>
                                                        <MenuFlyoutItem Text="200% (Maximum)" Tag="2.0" Click="OnUserMenuSetVolumeClicked" />
                                                        <MenuFlyoutItem Text="150%" Tag="1.5" Click="OnUserMenuSetVolumeClicked" />
                                                        <MenuFlyoutItem Text="100% (Normal)" Tag="1.0" Click="OnUserMenuSetVolumeClicked" />
                                                        <MenuFlyoutItem Text="75%" Tag="0.75" Click="OnUserMenuSetVolumeClicked" />
                                                        <MenuFlyoutItem Text="50%" Tag="0.5" Click="OnUserMenuSetVolumeClicked" />
                                                        <MenuFlyoutItem Text="25%" Tag="0.25" Click="OnUserMenuSetVolumeClicked" />
                                                        <MenuFlyoutItem Text="Couper le son (0%)" Tag="0.0" Click="OnUserMenuSetVolumeClicked" />
                                                    </MenuFlyoutSubItem>
                                                    <MenuFlyoutItem Text="Mettre en sourdine locale" Tag="{x:Bind Author}" Click="OnUserMenuToggleMuteClicked">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74F;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Ajouter en ami" Tag="{x:Bind Author}" Click="OnUserMenuAddFriendClicked">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FA;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Bloquer" Foreground="#FF453A" Tag="{x:Bind Author}" Click="OnUserMenuBlockClicked">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE894;" Foreground="#FF453A" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Copier le nom d'utilisateur" Tag="{x:Bind Author}" Click="OnUserMenuCopyUsernameClicked">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Copier le pseudo" Tag="{x:Bind Author}" Click="OnUserMenuCopyDisplayNameClicked">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Copier l'identifiant" Tag="{x:Bind Author}" Click="OnUserMenuCopyIdClicked">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Button.ContextFlyout>
                                            <Button.Flyout>
                                                <Flyout Opening="OnUserProfileFlyoutOpening">
                                                    <Flyout.FlyoutPresenterStyle>
                                                        <Style TargetType="FlyoutPresenter">
                                                            <Setter Property="Padding" Value="0" />
                                                            <Setter Property="CornerRadius" Value="18" />
                                                            <Setter Property="MaxWidth" Value="350" />
                                                        </Style>
                                                    </Flyout.FlyoutPresenterStyle>
                                                    <Border Width="336" CornerRadius="18"
                                                            BorderBrush="{x:Bind Author.ProfileBorderColorHex, Mode=OneWay}"
                                                            BorderThickness="3"
                                                            Tag="{x:Bind Author}">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="{x:Bind Author.ProfilePrimaryColorHex, Mode=OneWay}" Offset="0.0" />
                                                                <GradientStop Color="{x:Bind Author.ProfileSecondaryColorHex, Mode=OneWay}" Offset="1.0" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Grid>
                                                            <!-- Bannière (124px de haut, calée en haut, coins arrondis clippés) avec boutons d'actions -->
                                                            <Border Height="124" VerticalAlignment="Top" Background="{x:Bind Author.BannerColorHex, Mode=OneWay}" CornerRadius="15,15,0,0">
                                                                <Grid>
                                                                    <Border CornerRadius="15,15,0,0"
                                                                            Visibility="{x:Bind Author.HasBanner, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                        <Border.Background>
                                                                            <ImageBrush ImageSource="{x:Bind Author.BannerUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                                                        Stretch="UniformToFill" AlignmentY="Center" AlignmentX="Center" />
                                                                        </Border.Background>
                                                                    </Border>
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Spacing="6">
                                                                        <Button Width="30" Height="30" Padding="0" CornerRadius="15"
                                                                                Background="#66000000" BorderThickness="0"
                                                                                Visibility="{x:Bind Author.IsNotCurrentUser, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                ToolTipService.ToolTip="{x:Bind Author.FriendStatusTooltip, Mode=OneWay}"
                                                                                Tag="{x:Bind Author}" Click="OnAddFriendFromPopoutClicked">
                                                                            <FontIcon Glyph="{x:Bind Author.FriendActionGlyph, Mode=OneWay}" FontSize="13" Foreground="#FFFFFF" />
                                                                        </Button>
                                                                        <Button Width="30" Height="30" Padding="0" CornerRadius="15"
                                                                                Background="#66000000" BorderThickness="0"
                                                                                ToolTipService.ToolTip="Plus d'options">
                                                                            <Button.Flyout>
                                                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                                    <MenuFlyoutItem Text="Voir le profil complet" Tag="{x:Bind Author}" Click="OnViewFullProfileFromPopoutClicked">
                                                                                        <MenuFlyoutItem.Icon>
                                                                                            <FontIcon Glyph="&#xE77B;" />
                                                                                        </MenuFlyoutItem.Icon>
                                                                                    </MenuFlyoutItem>
                                                                                    <MenuFlyoutItem Text="Partager le profil" Tag="{x:Bind Author}" Click="OnShareProfileFromPopoutClicked">
                                                                                        <MenuFlyoutItem.Icon>
                                                                                            <FontIcon Glyph="&#xE72D;" />
                                                                                        </MenuFlyoutItem.Icon>
                                                                                    </MenuFlyoutItem>
                                                                                    <MenuFlyoutItem Text="Shop This Look">
                                                                                        <MenuFlyoutItem.Icon>
                                                                                            <FontIcon Glyph="&#xE719;" />
                                                                                        </MenuFlyoutItem.Icon>
                                                                                    </MenuFlyoutItem>
                                                                                    <MenuFlyoutItem Text="Inviter sur le serveur" Tag="{x:Bind Author}" Click="OnInviteUserToGuildClicked">
                                                                                        <MenuFlyoutItem.Icon>
                                                                                            <FontIcon Glyph="&#xE8FA;" />
                                                                                        </MenuFlyoutItem.Icon>
                                                                                    </MenuFlyoutItem>
                                                                                    <MenuFlyoutSeparator />
                                                                                    <MenuFlyoutItem Text="Ignorer" Tag="{x:Bind Author}" Click="OnIgnoreUserClicked">
                                                                                        <MenuFlyoutItem.Icon>
                                                                                            <FontIcon Glyph="&#xE7BA;" />
                                                                                        </MenuFlyoutItem.Icon>
                                                                                    </MenuFlyoutItem>
                                                                                    <MenuFlyoutItem Text="Bloquer" Foreground="#F23F43" Tag="{x:Bind Author}" Click="OnBlockUserFromPopoutClicked">
                                                                                        <MenuFlyoutItem.Icon>
                                                                                            <FontIcon Glyph="&#xE72B;" Foreground="#F23F43" />
                                                                                        </MenuFlyoutItem.Icon>
                                                                                    </MenuFlyoutItem>
                                                                                    <MenuFlyoutItem Text="Signaler le profil d'utilisateur" Foreground="#F23F43" Tag="{x:Bind Author}" Click="OnReportUserClicked">
                                                                                        <MenuFlyoutItem.Icon>
                                                                                            <FontIcon Glyph="&#xE730;" Foreground="#F23F43" />
                                                                                        </MenuFlyoutItem.Icon>
                                                                                    </MenuFlyoutItem>
                                                                                    <MenuFlyoutSeparator />
                                                                                    <MenuFlyoutItem Text="Copier l'identifiant" Tag="{x:Bind Author}" Click="OnCopyUserIdFromPopoutClicked">
                                                                                        <MenuFlyoutItem.Icon>
                                                                                            <FontIcon Glyph="&#xE8C8;" />
                                                                                        </MenuFlyoutItem.Icon>
                                                                                    </MenuFlyoutItem>
                                                                                </MenuFlyout>
                                                                            </Button.Flyout>
                                                                            <FontIcon Glyph="&#xE712;" FontSize="13" Foreground="#FFFFFF" />
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>

                                                            <!-- Avatar rond avec bordure assortie à la couleur principale du profil (cliquable pour ouvrir la vue complète) -->
                                                            <Button Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="43"
                                                                    Margin="16,74,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                    ToolTipService.ToolTip="Afficher le profil complet"
                                                                    Tag="{x:Bind Author}"
                                                                    Click="OnOpenFullUserProfileFromPopoutClicked">
                                                                <Ellipse Width="86" Height="86"
                                                                         StrokeThickness="6" Stroke="{x:Bind Author.ProfileAvatarCutoutStrokeColorHex, Mode=OneWay}">
                                                                    <Ellipse.Fill>
                                                                        <ImageBrush ImageSource="{x:Bind Author.AvatarUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                    </Ellipse.Fill>
                                                                </Ellipse>
                                                            </Button>

                                                            <!-- Pastille de statut sur l'avatar -->
                                                            <Ellipse Width="22" Height="22" Margin="78,136,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                     Fill="{x:Bind Author.StatusColor, Mode=OneWay}"
                                                                     Stroke="{x:Bind Author.ProfileAvatarCutoutStrokeColorHex, Mode=OneWay}" StrokeThickness="4" />

                                                            <!-- Bulle de pensée Statut Personnalisé à droite de l'avatar (comme sur la capture Discord) -->
                                                            <Border Margin="112,110,14,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                    Background="#F2FFFFFF" CornerRadius="16" Padding="12,7"
                                                                    Visibility="{x:Bind Author.HasCustomStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="{x:Bind Author.CustomStatusText, Mode=OneWay}"
                                                                           Foreground="#1E1F22" FontSize="12" FontWeight="Medium"
                                                                           TextTrimming="CharacterEllipsis" MaxWidth="185" />
                                                            </Border>

                                                            <!-- Corps du profil positionné proprement sous la bannière -->
                                                            <StackPanel Margin="16,168,16,16" Spacing="8">
                                                                <!-- Nom d'affichage en grand + bouton Note -->
                                                                <Grid>
                                                                    <TextBlock Text="{x:Bind Author.DisplayName}"
                                                                               Foreground="{x:Bind Author.ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                               FontWeight="Bold" FontSize="20" TextTrimming="CharacterEllipsis" Margin="0,0,26,0" />
                                                                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Padding="4" Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTipService.ToolTip="Note sur l'utilisateur">
                                                                        <FontIcon Glyph="&#xE70F;" FontSize="13" Foreground="{x:Bind Author.ProfileTextForegroundColorHex, Mode=OneWay}" Opacity="0.8" />
                                                                    </Button>
                                                                </Grid>

                                                                <!-- Ligne : username • pronoms [Clan] + Badges officiels côte à côte -->
                                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind Author.Username}"
                                                                               Foreground="{x:Bind Author.ProfileSecondaryTextColorHex, Mode=OneWay}"
                                                                               Opacity="0.85" FontSize="13" VerticalAlignment="Center" />
                                                                    <TextBlock Text="•"
                                                                               Foreground="{x:Bind Author.ProfileMutedTextColorHex, Mode=OneWay}"
                                                                               Opacity="0.55" FontSize="12" VerticalAlignment="Center"
                                                                               Visibility="{x:Bind Author.HasPronouns, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                    <TextBlock Text="{x:Bind Author.Pronouns, Mode=OneWay}"
                                                                               Foreground="{x:Bind Author.ProfileSecondaryTextColorHex, Mode=OneWay}"
                                                                               Opacity="0.85" FontSize="13" VerticalAlignment="Center"
                                                                               Visibility="{x:Bind Author.HasPronouns, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                                    <!-- Tag de Clan / Serveur avec son icône -->
                                                                    <Button Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6"
                                                                            Visibility="{x:Bind Author.HasClan, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                            Tag="{x:Bind Author}" Click="OnClanTagPillClicked"
                                                                            ToolTipService.ToolTip="Afficher le profil du clan">
                                                                        <Border Background="{x:Bind Author.ProfilePillBackgroundColorHex, Mode=OneWay}"
                                                                                BorderBrush="{x:Bind Author.ProfilePillBorderColorHex, Mode=OneWay}"
                                                                                BorderThickness="1" CornerRadius="6" Padding="7,2" VerticalAlignment="Center">
                                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                                <Image Width="14" Height="14" Source="{x:Bind Author.ClanBadgeUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="Uniform" />
                                                                                <TextBlock Text="{x:Bind Author.ClanTag, Mode=OneWay}"
                                                                                           Foreground="{x:Bind Author.ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </Button>

                                                                    <!-- Badges officiels de l'utilisateur alignés sur la même ligne -->
                                                                    <ItemsControl ItemsSource="{x:Bind Author.Badges, Mode=OneWay}"
                                                                                  VerticalAlignment="Center"
                                                                                  Visibility="{x:Bind Author.HasBadges, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="models:DiscordBadge">
                                                                                <Image Width="18" Height="18"
                                                                                       Source="{x:Bind IconUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                                                                       ToolTipService.ToolTip="{x:Bind Description}"
                                                                                       Stretch="Uniform" />
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>

                                                                <!-- Ligne Mutual Friends • Mutual Servers -->
                                                                <TextBlock Text="{x:Bind Author.MutualSummaryText, Mode=OneWay}"
                                                                           Foreground="{x:Bind Author.ProfileSecondaryTextColorHex, Mode=OneWay}"
                                                                           Opacity="0.85" FontSize="12" FontWeight="Medium"
                                                                           Visibility="{x:Bind Author.HasMutualInfo, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                                <!-- Carte Rich Presence (RPC) de l'utilisateur -->
                                                                <Border Visibility="{x:Bind Author.HasRichPresence, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                        Background="{x:Bind Author.ProfileCardInnerBackgroundColorHex, Mode=OneWay}"
                                                                        BorderBrush="{x:Bind Author.ProfileCardInnerBorderColorHex, Mode=OneWay}"
                                                                        BorderThickness="1" CornerRadius="10" Padding="10">
                                                                    <StackPanel Spacing="6">
                                                                        <TextBlock Text="{x:Bind Author.PrimaryActivity.HeaderLabel, Mode=OneWay}"
                                                                                   Foreground="{x:Bind Author.ProfileSecondaryTextColorHex, Mode=OneWay}"
                                                                                   FontSize="10" FontWeight="Bold" Opacity="0.8" />
                                                                        <Grid ColumnSpacing="10">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <Grid Grid.Column="0" Width="52" Height="52" VerticalAlignment="Top"
                                                                                  Visibility="{x:Bind Author.PrimaryActivity.HasLargeImage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                <Border Width="52" Height="52" CornerRadius="8">
                                                                                    <Border.Background>
                                                                                        <ImageBrush ImageSource="{x:Bind Author.PrimaryActivity.LargeImageUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                                    </Border.Background>
                                                                                </Border>
                                                                                <Ellipse Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"
                                                                                         Stroke="{ThemeResource CardBackgroundFillColorDefaultBrush}" StrokeThickness="2"
                                                                                         Visibility="{x:Bind Author.PrimaryActivity.HasSmallImage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                    <Ellipse.Fill>
                                                                                        <ImageBrush ImageSource="{x:Bind Author.PrimaryActivity.SmallImageUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                                    </Ellipse.Fill>
                                                                                </Ellipse>
                                                                            </Grid>
                                                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                                <TextBlock Text="{x:Bind Author.PrimaryActivity.Name, Mode=OneWay}"
                                                                                           Foreground="{x:Bind Author.ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                                           FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                                                <TextBlock Text="{x:Bind Author.PrimaryActivity.Details, Mode=OneWay}"
                                                                                           Foreground="{x:Bind Author.ProfileSecondaryTextColorHex, Mode=OneWay}"
                                                                                           FontSize="11" Opacity="0.85" TextTrimming="CharacterEllipsis"
                                                                                           Visibility="{x:Bind Author.PrimaryActivity.HasDetails, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                                <TextBlock Text="{x:Bind Author.PrimaryActivity.State, Mode=OneWay}"
                                                                                           Foreground="{x:Bind Author.ProfileMutedTextColorHex, Mode=OneWay}"
                                                                                           FontSize="11" Opacity="0.8" TextTrimming="CharacterEllipsis"
                                                                                           Visibility="{x:Bind Author.PrimaryActivity.HasState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                                <TextBlock Text="{x:Bind Author.PrimaryActivity.ElapsedText, Mode=OneWay}" FontSize="11" Foreground="#23A55A" FontWeight="SemiBold"
                                                                                           Visibility="{x:Bind Author.PrimaryActivity.HasElapsed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- Widget Game Collection de l'utilisateur -->
                                                                <Border Visibility="{x:Bind Author.HasGameWidgets, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                        Background="{x:Bind Author.ProfileCardInnerBackgroundColorHex, Mode=OneWay}"
                                                                        BorderBrush="{x:Bind Author.ProfileCardInnerBorderColorHex, Mode=OneWay}"
                                                                        BorderThickness="1" CornerRadius="10" Padding="10,8">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                            <TextBlock Text="Game"
                                                                                       Foreground="{x:Bind Author.ProfileSecondaryTextColorHex, Mode=OneWay}"
                                                                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                            <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{x:Bind Author.ProfileMutedTextColorHex, Mode=OneWay}" Opacity="0.8" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                        <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Author.GameWidgets, Mode=OneWay}" VerticalAlignment="Center">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="models:DiscordWidgetGame">
                                                                                    <Border Width="26" Height="26" CornerRadius="6" ToolTipService.ToolTip="{x:Bind TooltipText}">
                                                                                        <Border.Background>
                                                                                            <ImageBrush ImageSource="{x:Bind IconUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                                        </Border.Background>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </Grid>
                                                                </Border>

                                                                <!-- Bio directe comme sur Discord -->
                                                                <TextBlock Text="{x:Bind Author.AboutMe, Mode=OneWay}"
                                                                           Foreground="{x:Bind Author.ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                           FontSize="13" TextWrapping="Wrap" Opacity="0.95" />

                                                                <!-- Comptes et liens reliés affichés sur le profil de l'utilisateur -->
                                                                <StackPanel Spacing="6" Visibility="{x:Bind Author.HasConnectedAccounts, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <ItemsControl ItemsSource="{x:Bind Author.ConnectedAccounts, Mode=OneWay}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel Spacing="4" />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="models:DiscordConnectedAccount">
                                                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                                        Background="{x:Bind CardBackgroundColorHex, Mode=OneWay}"
                                                                                        BorderBrush="{x:Bind CardBorderColorHex, Mode=OneWay}"
                                                                                        BorderThickness="1" CornerRadius="8" Padding="10,7"
                                                                                        Tag="{x:Bind}"
                                                                                        Click="OnConnectedAccountClicked"
                                                                                        ToolTipService.ToolTip="{x:Bind TooltipText}">
                                                                                    <Grid ColumnSpacing="8">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="Auto" />
                                                                                            <ColumnDefinition Width="*" />
                                                                                            <ColumnDefinition Width="Auto" />
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <Border Grid.Column="0" Width="30" Height="30" Background="{x:Bind IconBadgeBackgroundColorHex, Mode=OneWay}"
                                                                                                BorderBrush="{x:Bind IconBadgeBorderColorHex, Mode=OneWay}" BorderThickness="1"
                                                                                                CornerRadius="8" VerticalAlignment="Center"
                                                                                                ToolTipService.ToolTip="{x:Bind PlatformBubbleName}">
                                                                                            <FontIcon Glyph="{x:Bind PlatformGlyph}" FontSize="15" Foreground="{x:Bind IconGlyphColorHex, Mode=OneWay}"
                                                                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                        </Border>
                                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                                                <TextBlock Text="{x:Bind Name}" Foreground="{x:Bind TextColorHex, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="165" />
                                                                                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="#23A55A" VerticalAlignment="Center"
                                                                                                          Visibility="{x:Bind Verified, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                                          ToolTipService.ToolTip="Compte vérifié" />
                                                                                            </StackPanel>
                                                                                            <TextBlock Text="{x:Bind PlatformDisplayName}" Foreground="{x:Bind SecondaryTextColorHex, Mode=OneWay}" FontSize="10" Opacity="0.8" />
                                                                                        </StackPanel>
                                                                                        <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="12" Foreground="{x:Bind SecondaryTextColorHex, Mode=OneWay}" Opacity="0.85" VerticalAlignment="Center"
                                                                                                  Visibility="{x:Bind HasUrl, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                                    </Grid>
                                                                                </Button>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>

                                                                <!-- Rôles de l'utilisateur dans le serveur -->
                                                                <StackPanel Spacing="4" Visibility="{x:Bind Author.HasDisplayRoles, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <TextBlock Text="RÔLES" FontSize="10" FontWeight="Bold" Foreground="{x:Bind Author.ProfileMutedTextColorHex, Mode=OneWay}" Opacity="0.75" />
                                                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                                                  HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                                                                        <ItemsControl ItemsSource="{x:Bind Author.DisplayRoles, Mode=OneWay}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="models:DiscordRole">
                                                                                    <Border Background="#2b2d31" BorderBrush="#35373c" BorderThickness="1" CornerRadius="6" Padding="6,3">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                                            <Ellipse Width="8" Height="8" Fill="{x:Bind ColorHex}" VerticalAlignment="Center" />
                                                                                            <TextBlock Text="{x:Bind Name}" FontSize="11" FontWeight="SemiBold" Foreground="#F2F3F5" VerticalAlignment="Center" />
                                                                                        </StackPanel>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </ScrollViewer>
                                                                </StackPanel>

                                                                <!-- Champ de message direct actif (Entrée pour envoyer un MP) -->
                                                                <Grid Margin="0,4,0,0">
                                                                    <TextBox PlaceholderText="{x:Bind Author.QuickMessagePlaceholder, Mode=OneWay}"
                                                                             Tag="{x:Bind Author}"
                                                                             KeyDown="OnQuickProfileMessageKeyDown"
                                                                             Background="{x:Bind Author.ProfileInputBackgroundColorHex, Mode=OneWay}"
                                                                             Foreground="{x:Bind Author.ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                             BorderBrush="{x:Bind Author.ProfileInputBorderColorHex, Mode=OneWay}"
                                                                             BorderThickness="1"
                                                                             CornerRadius="8" Padding="10,6,34,6" FontSize="12" />
                                                                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                            Margin="0,0,4,0" Padding="4"
                                                                            Background="Transparent" BorderThickness="0" CornerRadius="6"
                                                                            ToolTipService.ToolTip="Émojis">
                                                                        <FontIcon Glyph="&#xE76E;" FontSize="13" Foreground="{x:Bind Author.ProfileMutedTextColorHex, Mode=OneWay}" />
                                                                    </Button>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Flyout>
                                            </Button.Flyout>

                                            <!-- L'avatar affiché dans le message (cercle parfait) -->
                                            <Grid Width="40" Height="40">
                                                <Ellipse Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                                                <Ellipse>
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{x:Bind Author.AvatarUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>
                                        </Button>

                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Author.DisplayName}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"
                                                           Foreground="{x:Bind Author.RoleColorHex, Mode=OneWay}">
                                                    <TextBlock.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="Profil" Tag="{x:Bind Author}" Click="OnUserMenuProfileClicked">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77B;" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Mentionner" Tag="{x:Bind Author}" Click="OnUserMenuMentionClicked">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE910;" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Message privé" Tag="{x:Bind Author}" Click="OnUserMenuDirectMessageClicked">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8BD;" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Appeler" Tag="{x:Bind Author}" Click="OnUserMenuCallClicked">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE717;" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutSubItem Text="Volume utilisateur">
                                                                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE767;" /></MenuFlyoutSubItem.Icon>
                                                                <MenuFlyoutItem Text="200% (Maximum)" Tag="2.0" Click="OnUserMenuSetVolumeClicked" />
                                                                <MenuFlyoutItem Text="150%" Tag="1.5" Click="OnUserMenuSetVolumeClicked" />
                                                                <MenuFlyoutItem Text="100% (Normal)" Tag="1.0" Click="OnUserMenuSetVolumeClicked" />
                                                                <MenuFlyoutItem Text="75%" Tag="0.75" Click="OnUserMenuSetVolumeClicked" />
                                                                <MenuFlyoutItem Text="50%" Tag="0.5" Click="OnUserMenuSetVolumeClicked" />
                                                                <MenuFlyoutItem Text="25%" Tag="0.25" Click="OnUserMenuSetVolumeClicked" />
                                                                <MenuFlyoutItem Text="Couper le son (0%)" Tag="0.0" Click="OnUserMenuSetVolumeClicked" />
                                                            </MenuFlyoutSubItem>
                                                            <MenuFlyoutItem Text="Mettre en sourdine locale" Tag="{x:Bind Author}" Click="OnUserMenuToggleMuteClicked">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74F;" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem Text="Ajouter en ami" Tag="{x:Bind Author}" Click="OnUserMenuAddFriendClicked">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FA;" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Bloquer" Foreground="#FF453A" Tag="{x:Bind Author}" Click="OnUserMenuBlockClicked">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE894;" Foreground="#FF453A" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem Text="Copier le nom d'utilisateur" Tag="{x:Bind Author}" Click="OnUserMenuCopyUsernameClicked">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Copier le pseudo" Tag="{x:Bind Author}" Click="OnUserMenuCopyDisplayNameClicked">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Copier l'identifiant" Tag="{x:Bind Author}" Click="OnUserMenuCopyIdClicked">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                        </MenuFlyout>
                                                    </TextBlock.ContextFlyout>
                                                </TextBlock>
                                                <!-- Pill Tag de Clan à côté du pseudo dans les messages -->
                                                <Button Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="5"
                                                        Visibility="{x:Bind Author.HasClan, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Tag="{x:Bind Author}" Click="OnClanTagPillClicked"
                                                        ToolTipService.ToolTip="Afficher le profil du clan">
                                                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1" CornerRadius="5" Padding="5,1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                                            <Image Width="12" Height="12" Source="{x:Bind Author.ClanBadgeUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="Uniform" />
                                                            <TextBlock Text="{x:Bind Author.ClanTag, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </Button>
                                                <TextBlock Text="{x:Bind ShortTime}" Opacity="0.5" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind EditedText}" Opacity="0.45" FontSize="11" VerticalAlignment="Center"
                                                           Visibility="{x:Bind IsEdited, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Message Système (Appel démarré, arrivée d'un membre, message épinglé, boost, etc. avec icône dédiée colorée style Discord) -->
                                    <StackPanel Orientation="Horizontal" Visibility="{x:Bind IsSystem, Converter={StaticResource BoolToVisibilityConverter}}" Spacing="12" Margin="14,6,0,6" VerticalAlignment="Center">
                                        <FontIcon Glyph="{x:Bind SystemIconGlyph}" Foreground="{x:Bind SystemIconColor}" FontSize="15" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind SystemText}" Opacity="0.88" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ShortTime}" Opacity="0.45" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Texte du message -->
                                    <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" Margin="50,0,0,0"
                                               IsTextSelectionEnabled="True"
                                               Visibility="{x:Bind HasContent, Converter={StaticResource BoolToVisibilityConverter}}" />

                                    <!-- Stickers Discord -->
                                    <ItemsControl ItemsSource="{x:Bind StickerItems}" Margin="50,4,0,0"
                                                  Visibility="{x:Bind HasStickers, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:DiscordStickerItem">
                                                <Image Source="{x:Bind Url, Converter={StaticResource StringToImageSourceConverter}}"
                                                       Width="140" Height="140" HorizontalAlignment="Left" Stretch="Uniform"
                                                       ToolTipService.ToolTip="{x:Bind Name}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Pièces jointes Images -->
                                    <ItemsControl ItemsSource="{x:Bind ImageAttachments}" Margin="50,4,0,0"
                                                  Visibility="{x:Bind HasImages, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:DiscordAttachment">
                                                <Border CornerRadius="8" Tag="{x:Bind}"
                                                        Tapped="OnImageAttachmentTapped"
                                                        ContextRequested="OnImageAttachmentContextRequested">
                                                    <Image Source="{x:Bind Url, Converter={StaticResource StringToImageSourceConverter}}"
                                                           MaxWidth="400" MaxHeight="300" HorizontalAlignment="Left" Margin="0,4" Stretch="Uniform" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Pièces jointes Audio & Messages Vocaux (Discord 1:1) -->
                                    <ItemsControl ItemsSource="{x:Bind AudioAttachments}" Margin="50,4,0,0"
                                                  Visibility="{x:Bind HasAudio, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:DiscordAttachment">
                                                <controls:DiscordAudioPlayerControl Attachment="{x:Bind}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Pièces jointes Fichiers non-image non-audio (ex: message.txt, zip, pdf) -->
                                    <ItemsControl ItemsSource="{x:Bind FileAttachments}" Margin="50,4,0,0"
                                                  Visibility="{x:Bind HasFiles, Converter={StaticResource BoolToVisibilityConverter}}">

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:DiscordAttachment">
                                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,4" MaxWidth="360" HorizontalAlignment="Left">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <FontIcon Glyph="&#xE8A5;" FontSize="20" Opacity="0.8" />
                                                        <StackPanel VerticalAlignment="Center" Width="210">
                                                            <TextBlock Text="{x:Bind Filename}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind SizeText}" FontSize="11" Opacity="0.6" />
                                                        </StackPanel>
                                                        <HyperlinkButton Content="Ouvrir" NavigateUri="{x:Bind Url}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Sondages natifs Discord (Polls) -->
                                    <Border Margin="50,4,0,0" MaxWidth="380" HorizontalAlignment="Left"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="12"
                                            Visibility="{x:Bind HasPoll, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{x:Bind Poll.QuestionText}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{x:Bind Poll.Answers}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:DiscordPollAnswer">
                                                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="6" Padding="10,6" Margin="0,2">
                                                            <TextBlock Text="{x:Bind DisplayText}" FontSize="13" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Embeds -->
                                    <ItemsControl ItemsSource="{x:Bind Embeds}" Margin="50,4,0,0"
                                                  Visibility="{x:Bind HasEmbeds, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:DiscordEmbed">
                                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4" MaxWidth="400" HorizontalAlignment="Left">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{x:Bind Provider.Name}" FontSize="12" Opacity="0.6" Visibility="{x:Bind HasProvider, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="{x:Bind HasTitle, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        <TextBlock Text="{x:Bind Description}" FontSize="12" TextWrapping="Wrap" Opacity="0.8" Visibility="{x:Bind HasDescription, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        <Border CornerRadius="8" Tag="{x:Bind}"
                                                                Tapped="OnImageEmbedTapped"
                                                                ContextRequested="OnImageEmbedContextRequested"
                                                                Visibility="{x:Bind HasMainImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <Image Source="{x:Bind MainImageUrl, Converter={StaticResource StringToImageSourceConverter}}" MaxWidth="400" MaxHeight="300" Margin="0,8,0,0" Stretch="Uniform" />
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Réactions sous le message -->
                                    <ItemsControl ItemsSource="{x:Bind Reactions}" Margin="50,4,0,0"
                                                  Visibility="{x:Bind HasReactions, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:DiscordReaction">
                                                <Button Padding="6,3" Height="28" CornerRadius="8" Margin="0,0,4,0"
                                                        Background="{x:Bind BackgroundBrushHex, Mode=OneWay}"
                                                        BorderBrush="{x:Bind BorderBrushHex, Mode=OneWay}"
                                                        BorderThickness="1"
                                                        Tag="{x:Bind}"
                                                        Click="OnExistingReactionClicked">
                                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                        <Border Width="16" Height="16"
                                                                Visibility="{x:Bind IsCustom, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <Image Source="{x:Bind ImageUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="Uniform" />
                                                        </Border>
                                                        <TextBlock Text="{x:Bind EmojiText, Mode=OneWay}" FontSize="13"
                                                                   Visibility="{x:Bind IsCustom, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                                                        <TextBlock Text="{x:Bind CountText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Opacity="0.85" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Carte Fil de discussion (In-Chat Thread Starter Card) -->
                                    <Button Margin="50,6,0,0" Padding="10,8" MaxWidth="440" HorizontalAlignment="Left"
                                            Background="#2B2D31" BorderBrush="#383A40" BorderThickness="1" CornerRadius="8"
                                            Tag="{x:Bind Thread}" Click="OnOpenThreadCardClicked"
                                            Visibility="{x:Bind HasThread, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6" Background="#1E1F22" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE8BD;" FontSize="15" Foreground="#5865F2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind Thread.DisplayName, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Thread.ThreadMessageCountText, Mode=OneWay}" FontSize="11" Opacity="0.65" />
                                            </StackPanel>
                                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Opacity="0.5" VerticalAlignment="Center" Margin="4,0,2,0" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Popup d'Autocomplétion Flottant Discord (@ Membres, Rôles, Émojis) -->
                    <Border Grid.Row="1" Grid.Column="0"
                            VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                            Margin="16,0,16,4" Canvas.ZIndex="150"
                            Background="#2B2D31"
                            BorderBrush="#1F2023" BorderThickness="1"
                            CornerRadius="8" MaxHeight="340"
                            Visibility="{x:Bind ViewModel.IsAutocompleteOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- En-tête de la catégorie (ex: "MEMBRES DU SERVEUR" ou "ÉMOJIS") -->
                            <Border Grid.Row="0" Background="#232428" Padding="12,8" CornerRadius="8,8,0,0" BorderBrush="#1F2023" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.AutocompleteCategoryTitle, Mode=OneWay}"
                                               FontSize="11" FontWeight="Bold" Foreground="#949BA4" />
                                    <TextBlock Text="• Utilisez ↑ ↓ pour naviguer, Entrée ou Tab pour valider"
                                               FontSize="11" Foreground="#80848E" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Liste déroulante des suggestions -->
                            <ListView Grid.Row="1"
                                      ItemsSource="{x:Bind ViewModel.AutocompleteSuggestions, Mode=OneWay}"
                                      SelectionMode="None"
                                      Padding="6,4">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AutocompleteItemViewModel">
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                Padding="8,6" Margin="0,1" CornerRadius="6"
                                                Background="{x:Bind BackgroundHex, Mode=OneWay}"
                                                BorderThickness="0"
                                                Tag="{x:Bind}"
                                                Click="OnAutocompleteItemClicked">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Cas 1 : Avatar de membre avec pastille de statut -->
                                                <Grid Grid.Column="0" Width="26" Height="26"
                                                      Visibility="{x:Bind HasAvatar, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Ellipse Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{x:Bind AvatarUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                             Fill="{x:Bind StatusColor, Mode=OneWay}" Stroke="#2B2D31" StrokeThickness="1.5"
                                                             Visibility="{x:Bind HasStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </Grid>

                                                <!-- Cas 2 : Émoji personnalisé (image animée ou statique) -->
                                                <Border Grid.Column="0" Width="24" Height="24"
                                                        Visibility="{x:Bind IsCustomEmoji, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Image Source="{x:Bind EmojiImageUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="Uniform" />
                                                </Border>

                                                <!-- Cas 3 : Émoji Unicode standard -->
                                                <TextBlock Grid.Column="0" Text="{x:Bind EmojiUnicode, Mode=OneWay}" FontSize="18"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{x:Bind IsEmoji, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                <!-- Titre et sous-titre -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                               FontWeight="SemiBold" FontSize="13"
                                                               Foreground="{x:Bind TitleColorHex, Mode=OneWay}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}"
                                                               FontSize="11" Foreground="#949BA4"
                                                               TextTrimming="CharacterEllipsis"
                                                               Visibility="{x:Bind HasSubtitle, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>

                                                <!-- Touche Tab / Entrée d'aide sur l'élément sélectionné -->
                                                <Border Grid.Column="2" Background="#1E1F22" CornerRadius="4" Padding="6,2"
                                                        VerticalAlignment="Center"
                                                        Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="Tab ↵" FontSize="10" FontWeight="Bold" Foreground="#949BA4" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>


                    <!-- Panneau Split-View : Fil de discussion actif (Threads) -->
                    <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Width="400"
                            Background="#1E1F22"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0"
                            Visibility="{x:Bind ViewModel.SplitThreadPanelVisibility, Mode=OneWay}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="48" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 1. En-tête du Fil -->
                            <Border Grid.Row="0" Background="#1E1F22" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8BD;" FontSize="16" Foreground="#5865F2" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ViewModel.ActiveSplitThread.DisplayName, Mode=OneWay}"
                                                   FontWeight="Bold" FontSize="14" Foreground="#F2F3F5"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Width="30" Height="30" Padding="0" CornerRadius="15"
                                            Background="Transparent" BorderThickness="0"
                                            Click="OnCloseSplitThreadClicked" ToolTipService.ToolTip="Fermer le fil">
                                        <FontIcon Glyph="&#xE711;" FontSize="12" Opacity="0.7" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- 2. Liste des messages du Fil -->
                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.ActiveThreadMessages, Mode=OneWay}"
                                      Padding="10,8" SelectionMode="None"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:DiscordMessage">
                                        <Grid Margin="0,2,0,4">
                                            <StackPanel Padding="4,2" Spacing="2">
                                                <!-- En-tête de message : Avatar + Pseudo + Timestamp -->
                                                <Grid Visibility="{x:Bind ShowHeader, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15" Margin="0,0,8,0" VerticalAlignment="Top">
                                                        <Ellipse>
                                                            <Ellipse.Fill>
                                                                <ImageBrush ImageSource="{x:Bind Author.AvatarUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{x:Bind Author.DisplayName}" FontWeight="Bold" FontSize="13" Foreground="{x:Bind Author.RoleColorHex, Mode=OneWay}" />
                                                            <TextBlock Text="{x:Bind TimeText}" FontSize="10" Opacity="0.5" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Contenu du message -->
                                                <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" FontSize="13" LineHeight="18"
                                                           Margin="38,0,0,0" IsTextSelectionEnabled="True"
                                                           Visibility="{x:Bind HasContent, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                <!-- Pièces jointes images dans le fil -->
                                                <ItemsControl ItemsSource="{x:Bind ImageAttachments}" Margin="38,2,0,0"
                                                              Visibility="{x:Bind HasImages, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:DiscordAttachment">
                                                            <Border CornerRadius="6" Margin="0,2,0,2">
                                                                <Image Source="{x:Bind Url, Converter={StaticResource StringToImageSourceConverter}}"
                                                                       MaxHeight="180" MaxWidth="300" Stretch="Uniform" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- 3. Barre de saisie de message dans le fil -->
                            <Border Grid.Row="2" Background="#1E1F22" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="12,10">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="SplitThreadMessageInput"
                                             PlaceholderText="Envoyer un message dans le fil..."
                                             CornerRadius="8" BorderThickness="0"
                                             Background="{ThemeResource ControlFillColorDefaultBrush}"
                                             Padding="12,8"
                                             KeyDown="OnSplitThreadMessageInputKeyDown" />
                                    <Button Grid.Column="1" Width="36" Height="36" CornerRadius="18" Padding="0"
                                            Background="#5865F2" BorderThickness="0"
                                            Click="OnSendSplitThreadMessageClicked" ToolTipService.ToolTip="Envoyer (Entrée)">
                                        <FontIcon Glyph="&#xE725;" FontSize="13" Foreground="White" />
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>


                    <!-- Panneau latéral droit : Activités récentes du serveur & Liste des Membres (En ligne / Hors ligne) -->
                    <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Width="240"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0"
                            Visibility="{x:Bind ViewModel.MemberListVisibility, Mode=OneWay}">
                        <ScrollViewer Padding="8,10">
                            <StackPanel Spacing="12">
                                <!-- 1. SECTION ACTIVITÉ RÉCENTE -->
                                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasRecentMemberActivities, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid Margin="6,2,6,2">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="Activité" FontSize="11" FontWeight="Bold" Foreground="#949BA4" />
                                            <TextBlock Text="—" FontSize="11" FontWeight="Bold" Foreground="#949BA4" />
                                            <TextBlock Text="{x:Bind ViewModel.RecentMemberActivities.Count, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#949BA4" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE713;" FontSize="11" Foreground="#949BA4" />
                                            <FontIcon Glyph="&#xE76C;" FontSize="11" Foreground="#949BA4" />
                                        </StackPanel>
                                    </Grid>

                                    <ItemsControl ItemsSource="{x:Bind ViewModel.RecentMemberActivities, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:MemberActivityCardViewModel">
                                                <Button Background="#1e1f22" BorderBrush="#2b2d31" BorderThickness="1"
                                                        CornerRadius="8" Padding="10,8" Margin="0,0,0,6"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Tag="{x:Bind User}" Click="OnActivityCardClicked"
                                                        ToolTipService.ToolTip="{x:Bind TooltipText}">
                                                    <Button.Flyout>
                                                        <Flyout Opening="OnUserProfileFlyoutOpening" Placement="LeftEdgeAlignedTop">
                                                            <Flyout.FlyoutPresenterStyle>
                                                                <Style TargetType="FlyoutPresenter">
                                                                    <Setter Property="Padding" Value="0" />
                                                                    <Setter Property="CornerRadius" Value="18" />
                                                                    <Setter Property="MaxWidth" Value="350" />
                                                                    <Setter Property="Background" Value="Transparent" />
                                                                    <Setter Property="BorderThickness" Value="0" />
                                                                </Style>
                                                            </Flyout.FlyoutPresenterStyle>
                                                            <Border Width="336" CornerRadius="18"
                                                                    BorderBrush="{x:Bind User.ProfileBorderColorHex, Mode=OneWay}"
                                                                    BorderThickness="3"
                                                                    Tag="{x:Bind User}">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="{x:Bind User.ProfilePrimaryColorHex, Mode=OneWay}" Offset="0.0" />
                                                                        <GradientStop Color="{x:Bind User.ProfileSecondaryColorHex, Mode=OneWay}" Offset="1.0" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                                <Grid>
                                                                    <!-- Bannière (124px de haut, calée en haut, coins arrondis clippés) avec boutons d'actions -->
                                                                    <Border Height="124" VerticalAlignment="Top" Background="{x:Bind User.BannerColorHex, Mode=OneWay}" CornerRadius="15,15,0,0">
                                                                        <Grid>
                                                                            <Border CornerRadius="15,15,0,0"
                                                                                    Visibility="{x:Bind User.HasBanner, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                <Border.Background>
                                                                                    <ImageBrush ImageSource="{x:Bind User.BannerUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                                                                Stretch="UniformToFill" AlignmentY="Center" AlignmentX="Center" />
                                                                                </Border.Background>
                                                                            </Border>
                                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Spacing="6">
                                                                                <Button Width="30" Height="30" Padding="0" CornerRadius="15"
                                                                                        Background="#66000000" BorderThickness="0"
                                                                                        Visibility="{x:Bind User.IsNotCurrentUser, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                        ToolTipService.ToolTip="{x:Bind User.FriendStatusTooltip, Mode=OneWay}"
                                                                                        Tag="{x:Bind User}" Click="OnAddFriendFromPopoutClicked">
                                                                                    <FontIcon Glyph="{x:Bind User.FriendActionGlyph, Mode=OneWay}" FontSize="13" Foreground="#FFFFFF" />
                                                                                </Button>
                                                                                <Button Width="30" Height="30" Padding="0" CornerRadius="15"
                                                                                        Background="#66000000" BorderThickness="0"
                                                                                        ToolTipService.ToolTip="Plus d'options">
                                                                                    <Button.Flyout>
                                                                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                                            <MenuFlyoutItem Text="Voir le profil complet" Tag="{x:Bind User}" Click="OnViewFullProfileFromPopoutClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE77B;" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutItem Text="Partager le profil" Tag="{x:Bind User}" Click="OnShareProfileFromPopoutClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE72D;" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutItem Text="Shop This Look">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE719;" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutItem Text="Inviter sur le serveur" Tag="{x:Bind User}" Click="OnInviteUserToGuildClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE8FA;" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutSeparator />
                                                                                            <MenuFlyoutItem Text="Ignorer" Tag="{x:Bind User}" Click="OnIgnoreUserClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE7BA;" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutItem Text="Bloquer" Foreground="#F23F43" Tag="{x:Bind User}" Click="OnBlockUserFromPopoutClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE72B;" Foreground="#F23F43" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutItem Text="Signaler le profil d'utilisateur" Foreground="#F23F43" Tag="{x:Bind User}" Click="OnReportUserClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE730;" Foreground="#F23F43" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutSeparator />
                                                                                            <MenuFlyoutItem Text="Copier l'identifiant" Tag="{x:Bind User}" Click="OnCopyUserIdFromPopoutClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE8C8;" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                        </MenuFlyout>
                                                                                    </Button.Flyout>
                                                                                    <FontIcon Glyph="&#xE712;" FontSize="13" Foreground="#FFFFFF" />
                                                                                </Button>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>

                                                                    <!-- Avatar rond avec bordure assortie à la couleur principale du profil (cliquable pour ouvrir la vue complète) -->
                                                                    <Button Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="43"
                                                                            Margin="16,74,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                            ToolTipService.ToolTip="Afficher le profil complet"
                                                                            Tag="{x:Bind User}"
                                                                            Click="OnOpenFullUserProfileFromPopoutClicked">
                                                                        <Ellipse Width="86" Height="86"
                                                                                 StrokeThickness="6" Stroke="{x:Bind User.ProfileAvatarCutoutStrokeColorHex, Mode=OneWay}">
                                                                            <Ellipse.Fill>
                                                                                <ImageBrush ImageSource="{x:Bind User.AvatarUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                            </Ellipse.Fill>
                                                                        </Ellipse>
                                                                    </Button>

                                                                    <!-- Pastille de statut sur l'avatar -->
                                                                    <Ellipse Width="22" Height="22" Margin="78,136,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                             Fill="{x:Bind User.StatusColor, Mode=OneWay}"
                                                                             Stroke="{x:Bind User.ProfileAvatarCutoutStrokeColorHex, Mode=OneWay}" StrokeThickness="4" />

                                                                    <!-- Bulle de pensée Statut Personnalisé à droite de l'avatar (comme sur la capture Discord) -->
                                                                    <Border Margin="112,110,14,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                            Background="#F2FFFFFF" CornerRadius="16" Padding="12,7"
                                                                            Visibility="{x:Bind User.HasCustomStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                        <TextBlock Text="{x:Bind User.CustomStatusText, Mode=OneWay}"
                                                                                   Foreground="#1E1F22" FontSize="12" FontWeight="Medium"
                                                                                   TextTrimming="CharacterEllipsis" MaxWidth="185" />
                                                                    </Border>

                                                                    <!-- Corps du profil positionné proprement sous la bannière -->
                                                                    <StackPanel Margin="16,168,16,16" Spacing="8">
                                                                        <!-- Nom d'affichage en grand + bouton Note -->
                                                                        <Grid>
                                                                            <TextBlock Text="{x:Bind User.DisplayName}"
                                                                                       Foreground="{x:Bind User.ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                                       FontWeight="Bold" FontSize="20" TextTrimming="CharacterEllipsis" Margin="0,0,26,0" />
                                                                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Padding="4" Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTipService.ToolTip="Note sur l'utilisateur">
                                                                                <FontIcon Glyph="&#xE70F;" FontSize="13" Foreground="{x:Bind User.ProfileTextForegroundColorHex, Mode=OneWay}" Opacity="0.8" />
                                                                            </Button>
                                                                        </Grid>

                                                                        <!-- Ligne : username • pronoms [Clan] + Badges officiels côte à côte -->
                                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                            <TextBlock Text="{x:Bind User.Username}"
                                                                                       Foreground="{x:Bind User.ProfileSecondaryTextColorHex, Mode=OneWay}"
                                                                                       Opacity="0.85" FontSize="13" VerticalAlignment="Center" />
                                                                            <TextBlock Text="•"
                                                                                       Foreground="{x:Bind User.ProfileMutedTextColorHex, Mode=OneWay}"
                                                                                       Opacity="0.55" FontSize="12" VerticalAlignment="Center"
                                                                                       Visibility="{x:Bind User.HasPronouns, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                            <TextBlock Text="{x:Bind User.Pronouns, Mode=OneWay}"
                                                                                       Foreground="{x:Bind User.ProfileSecondaryTextColorHex, Mode=OneWay}"
                                                                                       Opacity="0.85" FontSize="13" VerticalAlignment="Center"
                                                                                       Visibility="{x:Bind User.HasPronouns, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                                            <!-- Tag de Clan / Serveur avec son icône -->
                                                                            <Button Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6"
                                                                                    Visibility="{x:Bind User.HasClan, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                    Tag="{x:Bind User}" Click="OnClanTagPillClicked"
                                                                                    ToolTipService.ToolTip="Afficher le profil du clan">
                                                                                <Border Background="{x:Bind User.ProfilePillBackgroundColorHex, Mode=OneWay}"
                                                                                        BorderBrush="{x:Bind User.ProfilePillBorderColorHex, Mode=OneWay}"
                                                                                        BorderThickness="1" CornerRadius="6" Padding="7,2" VerticalAlignment="Center">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                                        <Image Width="14" Height="14" Source="{x:Bind User.ClanBadgeUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="Uniform" />
                                                                                        <TextBlock Text="{x:Bind User.ClanTag, Mode=OneWay}"
                                                                                                   Foreground="{x:Bind User.ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                                                   FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </Button>

                                                                            <!-- Badges officiels de l'utilisateur alignés sur la même ligne -->
                                                                            <ItemsControl ItemsSource="{x:Bind User.Badges, Mode=OneWay}"
                                                                                          VerticalAlignment="Center"
                                                                                          Visibility="{x:Bind User.HasBadges, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="models:DiscordBadge">
                                                                                        <Image Width="18" Height="18"
                                                                                               Source="{x:Bind IconUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                                                                               ToolTipService.ToolTip="{x:Bind Description}"
                                                                                               Stretch="Uniform" />
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>

                                                                        <!-- Ligne Mutual Friends • Mutual Servers -->
                                                                        <TextBlock Text="{x:Bind User.MutualSummaryText, Mode=OneWay}"
                                                                                   Foreground="{x:Bind User.ProfileSecondaryTextColorHex, Mode=OneWay}"
                                                                                   Opacity="0.85" FontSize="12" FontWeight="Medium"
                                                                                   Visibility="{x:Bind User.HasMutualInfo, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                                        <!-- Carte Rich Presence (RPC) de l'utilisateur -->
                                                                        <Border Visibility="{x:Bind User.HasRichPresence, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                Background="{x:Bind User.ProfileCardInnerBackgroundColorHex, Mode=OneWay}"
                                                                                BorderBrush="{x:Bind User.ProfileCardInnerBorderColorHex, Mode=OneWay}"
                                                                                BorderThickness="1" CornerRadius="10" Padding="10">
                                                                            <StackPanel Spacing="6">
                                                                                <TextBlock Text="{x:Bind User.PrimaryActivity.HeaderLabel, Mode=OneWay}"
                                                                                           Foreground="{x:Bind User.ProfileSecondaryTextColorHex, Mode=OneWay}"
                                                                                           FontSize="10" FontWeight="Bold" Opacity="0.8" />
                                                                                <Grid ColumnSpacing="10">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <Grid Grid.Column="0" Width="52" Height="52" VerticalAlignment="Top"
                                                                                          Visibility="{x:Bind User.PrimaryActivity.HasLargeImage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                        <Border Width="52" Height="52" CornerRadius="8">
                                                                                            <Border.Background>
                                                                                                <ImageBrush ImageSource="{x:Bind User.PrimaryActivity.LargeImageUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                                            </Border.Background>
                                                                                        </Border>
                                                                                        <Ellipse Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"
                                                                                                 Stroke="{ThemeResource CardBackgroundFillColorDefaultBrush}" StrokeThickness="2"
                                                                                                 Visibility="{x:Bind User.PrimaryActivity.HasSmallImage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                            <Ellipse.Fill>
                                                                                                <ImageBrush ImageSource="{x:Bind User.PrimaryActivity.SmallImageUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                             </Ellipse.Fill>
                                                                                        </Ellipse>
                                                                                    </Grid>
                                                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                                        <TextBlock Text="{x:Bind User.PrimaryActivity.Name, Mode=OneWay}"
                                                                                                   Foreground="{x:Bind User.ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                                                   FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                                                        <TextBlock Text="{x:Bind User.PrimaryActivity.Details, Mode=OneWay}"
                                                                                                   Foreground="{x:Bind User.ProfileSecondaryTextColorHex, Mode=OneWay}"
                                                                                                   FontSize="11" Opacity="0.85" TextTrimming="CharacterEllipsis"
                                                                                                   Visibility="{x:Bind User.PrimaryActivity.HasDetails, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                                        <TextBlock Text="{x:Bind User.PrimaryActivity.State, Mode=OneWay}"
                                                                                                   Foreground="{x:Bind User.ProfileMutedTextColorHex, Mode=OneWay}"
                                                                                                   FontSize="11" Opacity="0.8" TextTrimming="CharacterEllipsis"
                                                                                                   Visibility="{x:Bind User.PrimaryActivity.HasState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                                        <TextBlock Text="{x:Bind User.PrimaryActivity.ElapsedText, Mode=OneWay}" FontSize="11" Foreground="#23A55A" FontWeight="SemiBold"
                                                                                                   Visibility="{x:Bind User.PrimaryActivity.HasElapsed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                            </StackPanel>
                                                                        </Border>

                                                                        <!-- Widget Game Collection de l'utilisateur -->
                                                                        <Border Visibility="{x:Bind User.HasGameWidgets, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                Background="{x:Bind User.ProfileCardInnerBackgroundColorHex, Mode=OneWay}"
                                                                                BorderBrush="{x:Bind User.ProfileCardInnerBorderColorHex, Mode=OneWay}"
                                                                                BorderThickness="1" CornerRadius="10" Padding="10,8">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                                    <TextBlock Text="Game"
                                                                                               Foreground="{x:Bind User.ProfileSecondaryTextColorHex, Mode=OneWay}"
                                                                                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                                    <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{x:Bind User.ProfileMutedTextColorHex, Mode=OneWay}" Opacity="0.8" VerticalAlignment="Center" />
                                                                                </StackPanel>
                                                                                <ItemsControl Grid.Column="1" ItemsSource="{x:Bind User.GameWidgets, Mode=OneWay}" VerticalAlignment="Center">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                                        </ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate x:DataType="models:DiscordWidgetGame">
                                                                                            <Border Width="26" Height="26" CornerRadius="6" ToolTipService.ToolTip="{x:Bind TooltipText}">
                                                                                                <Border.Background>
                                                                                                    <ImageBrush ImageSource="{x:Bind IconUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                                                </Border.Background>
                                                                                            </Border>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </Grid>
                                                                        </Border>

                                                                        <!-- Bio directe comme sur Discord -->
                                                                        <TextBlock Text="{x:Bind User.AboutMe, Mode=OneWay}"
                                                                                   Foreground="{x:Bind User.ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                                   FontSize="13" TextWrapping="Wrap" Opacity="0.95" />

                                                                        <!-- Comptes et liens reliés affichés sur le profil de l'utilisateur -->
                                                                        <StackPanel Spacing="6" Visibility="{x:Bind User.HasConnectedAccounts, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <ItemsControl ItemsSource="{x:Bind User.ConnectedAccounts, Mode=OneWay}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <StackPanel Spacing="4" />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="models:DiscordConnectedAccount">
                                                                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                                                Background="{x:Bind CardBackgroundColorHex, Mode=OneWay}"
                                                                                                BorderBrush="{x:Bind CardBorderColorHex, Mode=OneWay}"
                                                                                                BorderThickness="1" CornerRadius="8" Padding="10,7"
                                                                                                Tag="{x:Bind}"
                                                                                                Click="OnConnectedAccountClicked"
                                                                                                ToolTipService.ToolTip="{x:Bind TooltipText}">
                                                                                            <Grid ColumnSpacing="8">
                                                                                                <Grid.ColumnDefinitions>
                                                                                                    <ColumnDefinition Width="Auto" />
                                                                                                    <ColumnDefinition Width="*" />
                                                                                                    <ColumnDefinition Width="Auto" />
                                                                                                </Grid.ColumnDefinitions>
                                                                                                <Border Grid.Column="0" Width="30" Height="30" Background="{x:Bind IconBadgeBackgroundColorHex, Mode=OneWay}"
                                                                                                        BorderBrush="{x:Bind IconBadgeBorderColorHex, Mode=OneWay}" BorderThickness="1"
                                                                                                        CornerRadius="8" VerticalAlignment="Center"
                                                                                                        ToolTipService.ToolTip="{x:Bind PlatformBubbleName}">
                                                                                                    <FontIcon Glyph="{x:Bind PlatformGlyph}" FontSize="15" Foreground="{x:Bind IconGlyphColorHex, Mode=OneWay}"
                                                                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                                </Border>
                                                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                                                        <TextBlock Text="{x:Bind Name}" Foreground="{x:Bind TextColorHex, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="165" />
                                                                                                        <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="#23A55A" VerticalAlignment="Center"
                                                                                                                  Visibility="{x:Bind Verified, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                                                  ToolTipService.ToolTip="Compte vérifié" />
                                                                                                    </StackPanel>
                                                                                                    <TextBlock Text="{x:Bind PlatformDisplayName}" Foreground="{x:Bind SecondaryTextColorHex, Mode=OneWay}" FontSize="10" Opacity="0.8" />
                                                                                                </StackPanel>
                                                                                                <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="12" Foreground="{x:Bind SecondaryTextColorHex, Mode=OneWay}" Opacity="0.85" VerticalAlignment="Center"
                                                                                                          Visibility="{x:Bind HasUrl, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                                            </Grid>
                                                                                        </Button>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>

                                                                        <!-- Rôles de l'utilisateur dans le serveur -->
                                                                        <StackPanel Spacing="4" Visibility="{x:Bind User.HasDisplayRoles, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <TextBlock Text="RÔLES" FontSize="10" FontWeight="Bold" Foreground="{x:Bind User.ProfileMutedTextColorHex, Mode=OneWay}" Opacity="0.75" />
                                                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                                                          HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                                                                                <ItemsControl ItemsSource="{x:Bind User.DisplayRoles, Mode=OneWay}">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                                        </ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate x:DataType="models:DiscordRole">
                                                                                            <Border Background="#2b2d31" BorderBrush="#35373c" BorderThickness="1" CornerRadius="6" Padding="6,3">
                                                                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                                                    <Ellipse Width="8" Height="8" Fill="{x:Bind ColorHex}" VerticalAlignment="Center" />
                                                                                                    <TextBlock Text="{x:Bind Name}" FontSize="11" FontWeight="SemiBold" Foreground="#F2F3F5" VerticalAlignment="Center" />
                                                                                                </StackPanel>
                                                                                            </Border>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </ScrollViewer>
                                                                        </StackPanel>

                                                                        <!-- Champ de message direct actif (Entrée pour envoyer un MP) -->
                                                                        <Grid Margin="0,4,0,0">
                                                                            <TextBox PlaceholderText="{x:Bind User.QuickMessagePlaceholder, Mode=OneWay}"
                                                                                     Tag="{x:Bind User}"
                                                                                     KeyDown="OnQuickProfileMessageKeyDown"
                                                                                     Background="{x:Bind User.ProfileInputBackgroundColorHex, Mode=OneWay}"
                                                                                     Foreground="{x:Bind User.ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                                     BorderBrush="{x:Bind User.ProfileInputBorderColorHex, Mode=OneWay}"
                                                                                     BorderThickness="1"
                                                                                     CornerRadius="8" Padding="10,6,34,6" FontSize="12" />
                                                                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                                    Margin="0,0,4,0" Padding="4"
                                                                                    Background="Transparent" BorderThickness="0" CornerRadius="6"
                                                                                    ToolTipService.ToolTip="Émojis">
                                                                                <FontIcon Glyph="&#xE76E;" FontSize="13" Foreground="{x:Bind User.ProfileMutedTextColorHex, Mode=OneWay}" />
                                                                            </Button>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </Flyout>
                                                    </Button.Flyout>

                                                    <!-- Carte d'activité compacte dans la liste -->
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <Ellipse Width="7" Height="7" Fill="{x:Bind UserStatusColor}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{x:Bind UserName}" FontSize="12" FontWeight="Bold"
                                                                           Foreground="#F2F3F5" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                                                            </StackPanel>
                                                            <TextBlock Text="{x:Bind ActivityName}" FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="#DBDEE1" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <FontIcon Glyph="&#xE767;" FontSize="10" Foreground="#23A55A" VerticalAlignment="Center"
                                                                          Visibility="{x:Bind HasVoiceChannel, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                <TextBlock Text="{x:Bind SubtitleLine}" FontSize="10"
                                                                           Foreground="#23A55A" FontWeight="Medium"
                                                                           TextTrimming="CharacterEllipsis" MaxWidth="140" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Grid Grid.Column="1" Width="40" Height="40" VerticalAlignment="Center">
                                                            <Border Background="#2b2d31" CornerRadius="8">
                                                                <FontIcon Glyph="&#xE7FC;" FontSize="18" Foreground="#949BA4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <Border CornerRadius="8"
                                                                    Visibility="{x:Bind HasLargeImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{x:Bind LargeImageUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                </Border.Background>
                                                            </Border>
                                                        </Grid>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- 2. SECTIONS DE MEMBRES GROUPÉES PAR RÔLES (Discord 1:1) -->
                                <ItemsControl ItemsSource="{x:Bind ViewModel.MemberGroups, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:DiscordMemberGroup">
                                            <StackPanel Spacing="2" Margin="0,2,0,8">
                                                <!-- En-tête de Rôle / Groupe (Nom majuscule, Couleur du rôle, Compteur) -->
                                                <TextBlock Text="{x:Bind HeaderText, Mode=OneWay}"
                                                           FontSize="11" FontWeight="Bold"
                                                           Foreground="{x:Bind RoleColorHex, Mode=OneWay}"
                                                           Margin="6,4,6,2" />

                                                <ItemsControl ItemsSource="{x:Bind Members, Mode=OneWay}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:DiscordUser">
                                                            <Button Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Left" Padding="6,5" CornerRadius="8"
                                                                    Opacity="{x:Bind MemberItemOpacity, Mode=OneWay}"
                                                        Tag="{x:Bind}" Click="OnMemberItemClicked" DoubleTapped="OnMemberItemDoubleTapped"
                                                        ToolTipService.ToolTip="{x:Bind DisplayName}">
                                                    <Button.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="Profil" Tag="{x:Bind}" Click="OnUserMenuProfileClicked">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77B;" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Mentionner" Tag="{x:Bind}" Click="OnUserMenuMentionClicked">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE910;" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Message privé" Tag="{x:Bind}" Click="OnUserMenuDirectMessageClicked">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8BD;" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Appeler" Tag="{x:Bind}" Click="OnUserMenuCallClicked">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE717;" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutSubItem Text="Volume utilisateur">
                                                                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE767;" /></MenuFlyoutSubItem.Icon>
                                                                <MenuFlyoutItem Text="200% (Maximum)" Tag="2.0" Click="OnUserMenuSetVolumeClicked" />
                                                                <MenuFlyoutItem Text="150%" Tag="1.5" Click="OnUserMenuSetVolumeClicked" />
                                                                <MenuFlyoutItem Text="100% (Normal)" Tag="1.0" Click="OnUserMenuSetVolumeClicked" />
                                                                <MenuFlyoutItem Text="75%" Tag="0.75" Click="OnUserMenuSetVolumeClicked" />
                                                                <MenuFlyoutItem Text="50%" Tag="0.5" Click="OnUserMenuSetVolumeClicked" />
                                                                <MenuFlyoutItem Text="25%" Tag="0.25" Click="OnUserMenuSetVolumeClicked" />
                                                                <MenuFlyoutItem Text="Couper le son (0%)" Tag="0.0" Click="OnUserMenuSetVolumeClicked" />
                                                            </MenuFlyoutSubItem>
                                                            <MenuFlyoutItem Text="Mettre en sourdine locale" Tag="{x:Bind}" Click="OnUserMenuToggleMuteClicked">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74F;" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem Text="Ajouter en ami" Tag="{x:Bind}" Click="OnUserMenuAddFriendClicked">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FA;" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Bloquer" Foreground="#FF453A" Tag="{x:Bind}" Click="OnUserMenuBlockClicked">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE894;" Foreground="#FF453A" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem Text="Copier le nom d'utilisateur" Tag="{x:Bind}" Click="OnUserMenuCopyUsernameClicked">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Copier le pseudo" Tag="{x:Bind}" Click="OnUserMenuCopyDisplayNameClicked">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Copier l'identifiant" Tag="{x:Bind}" Click="OnUserMenuCopyIdClicked">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                        </MenuFlyout>
                                                    </Button.ContextFlyout>
                                                    <Button.Flyout>
                                                        <Flyout Opening="OnUserProfileFlyoutOpening" Placement="LeftEdgeAlignedTop">
                                                            <Flyout.FlyoutPresenterStyle>
                                                                <Style TargetType="FlyoutPresenter">
                                                                    <Setter Property="Padding" Value="0" />
                                                                    <Setter Property="CornerRadius" Value="18" />
                                                                    <Setter Property="MaxWidth" Value="350" />
                                                                    <Setter Property="Background" Value="Transparent" />
                                                                    <Setter Property="BorderThickness" Value="0" />
                                                                </Style>
                                                            </Flyout.FlyoutPresenterStyle>
                                                            <Border Width="336" CornerRadius="18"
                                                                    BorderBrush="{x:Bind ProfileBorderColorHex, Mode=OneWay}"
                                                                    BorderThickness="3"
                                                                    Tag="{x:Bind}">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="{x:Bind ProfilePrimaryColorHex, Mode=OneWay}" Offset="0.0" />
                                                                        <GradientStop Color="{x:Bind ProfileSecondaryColorHex, Mode=OneWay}" Offset="1.0" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                                <Grid>
                                                                    <!-- Bannière (124px de haut, calée en haut, coins arrondis clippés) avec boutons d'actions -->
                                                                    <Border Height="124" VerticalAlignment="Top" Background="{x:Bind BannerColorHex, Mode=OneWay}" CornerRadius="15,15,0,0">
                                                                        <Grid>
                                                                            <Border CornerRadius="15,15,0,0"
                                                                                    Visibility="{x:Bind HasBanner, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                <Border.Background>
                                                                                    <ImageBrush ImageSource="{x:Bind BannerUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                                                                Stretch="UniformToFill" AlignmentY="Center" AlignmentX="Center" />
                                                                                </Border.Background>
                                                                            </Border>
                                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Spacing="6">
                                                                                <Button Width="30" Height="30" Padding="0" CornerRadius="15"
                                                                                        Background="#66000000" BorderThickness="0"
                                                                                        Visibility="{x:Bind IsNotCurrentUser, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                        ToolTipService.ToolTip="{x:Bind FriendStatusTooltip, Mode=OneWay}"
                                                                                        Tag="{x:Bind}" Click="OnAddFriendFromPopoutClicked">
                                                                                    <FontIcon Glyph="{x:Bind FriendActionGlyph, Mode=OneWay}" FontSize="13" Foreground="#FFFFFF" />
                                                                                </Button>
                                                                                <Button Width="30" Height="30" Padding="0" CornerRadius="15"
                                                                                        Background="#66000000" BorderThickness="0"
                                                                                        ToolTipService.ToolTip="Plus d'options">
                                                                                    <Button.Flyout>
                                                                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                                            <MenuFlyoutItem Text="Voir le profil complet" Tag="{x:Bind}" Click="OnViewFullProfileFromPopoutClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE77B;" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutItem Text="Partager le profil" Tag="{x:Bind}" Click="OnShareProfileFromPopoutClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE72D;" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutItem Text="Shop This Look">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE719;" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutItem Text="Inviter sur le serveur" Tag="{x:Bind}" Click="OnInviteUserToGuildClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE8FA;" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutSeparator />
                                                                                            <MenuFlyoutItem Text="Ignorer" Tag="{x:Bind}" Click="OnIgnoreUserClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE7BA;" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutItem Text="Bloquer" Foreground="#F23F43" Tag="{x:Bind}" Click="OnBlockUserFromPopoutClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE72B;" Foreground="#F23F43" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutItem Text="Signaler le profil d'utilisateur" Foreground="#F23F43" Tag="{x:Bind}" Click="OnReportUserClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE730;" Foreground="#F23F43" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutSeparator />
                                                                                            <MenuFlyoutItem Text="Copier l'identifiant" Tag="{x:Bind}" Click="OnCopyUserIdFromPopoutClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE8C8;" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                        </MenuFlyout>
                                                                                    </Button.Flyout>
                                                                                    <FontIcon Glyph="&#xE712;" FontSize="13" Foreground="#FFFFFF" />
                                                                                </Button>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>

                                                                    <!-- Avatar rond avec bordure assortie à la couleur principale du profil (cliquable pour ouvrir la vue complète) -->
                                                                    <Button Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="43"
                                                                            Margin="16,74,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                            ToolTipService.ToolTip="Afficher le profil complet"
                                                                            Tag="{x:Bind}"
                                                                            Click="OnOpenFullUserProfileFromPopoutClicked">
                                                                        <Ellipse Width="86" Height="86"
                                                                                 StrokeThickness="6" Stroke="{x:Bind ProfileAvatarCutoutStrokeColorHex, Mode=OneWay}">
                                                                            <Ellipse.Fill>
                                                                                <ImageBrush ImageSource="{x:Bind AvatarUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                            </Ellipse.Fill>
                                                                        </Ellipse>
                                                                    </Button>

                                                                    <!-- Pastille de statut sur l'avatar -->
                                                                    <Ellipse Width="22" Height="22" Margin="78,136,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                             Fill="{x:Bind StatusColor, Mode=OneWay}"
                                                                             Stroke="{x:Bind ProfileAvatarCutoutStrokeColorHex, Mode=OneWay}" StrokeThickness="4" />

                                                                    <!-- Bulle de pensée Statut Personnalisé à droite de l'avatar (comme sur la capture Discord) -->
                                                                    <Border Margin="112,110,14,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                            Background="#F2FFFFFF" CornerRadius="16" Padding="12,7"
                                                                            Visibility="{x:Bind HasCustomStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                        <TextBlock Text="{x:Bind CustomStatusText, Mode=OneWay}"
                                                                                   Foreground="#1E1F22" FontSize="12" FontWeight="Medium"
                                                                                   TextTrimming="CharacterEllipsis" MaxWidth="185" />
                                                                    </Border>

                                                                    <!-- Corps du profil positionné proprement sous la bannière -->
                                                                    <StackPanel Margin="16,168,16,16" Spacing="8">
                                                                        <!-- Nom d'affichage en grand + bouton Note -->
                                                                        <Grid>
                                                                            <TextBlock Text="{x:Bind DisplayName}"
                                                                                       Foreground="{x:Bind ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                                       FontWeight="Bold" FontSize="20" TextTrimming="CharacterEllipsis" Margin="0,0,26,0" />
                                                                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Padding="4" Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTipService.ToolTip="Note sur l'utilisateur">
                                                                                <FontIcon Glyph="&#xE70F;" FontSize="13" Foreground="{x:Bind ProfileTextForegroundColorHex, Mode=OneWay}" Opacity="0.8" />
                                                                            </Button>
                                                                        </Grid>

                                                                        <!-- Ligne : username • pronoms [Clan] + Badges officiels côte à côte -->
                                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                            <TextBlock Text="{x:Bind Username}"
                                                                                       Foreground="{x:Bind ProfileSecondaryTextColorHex, Mode=OneWay}"
                                                                                       Opacity="0.85" FontSize="13" VerticalAlignment="Center" />
                                                                            <TextBlock Text="•"
                                                                                       Foreground="{x:Bind ProfileMutedTextColorHex, Mode=OneWay}"
                                                                                       Opacity="0.55" FontSize="12" VerticalAlignment="Center"
                                                                                       Visibility="{x:Bind HasPronouns, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                            <TextBlock Text="{x:Bind Pronouns, Mode=OneWay}"
                                                                                       Foreground="{x:Bind ProfileSecondaryTextColorHex, Mode=OneWay}"
                                                                                       Opacity="0.85" FontSize="13" VerticalAlignment="Center"
                                                                                       Visibility="{x:Bind HasPronouns, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                                            <!-- Tag de Clan / Serveur avec son icône -->
                                                                            <Button Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6"
                                                                                    Visibility="{x:Bind HasClan, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                    Tag="{x:Bind}" Click="OnClanTagPillClicked"
                                                                                    ToolTipService.ToolTip="Afficher le profil du clan">
                                                                                <Border Background="{x:Bind ProfilePillBackgroundColorHex, Mode=OneWay}"
                                                                                        BorderBrush="{x:Bind ProfilePillBorderColorHex, Mode=OneWay}"
                                                                                        BorderThickness="1" CornerRadius="6" Padding="7,2" VerticalAlignment="Center">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                                        <Image Width="14" Height="14" Source="{x:Bind ClanBadgeUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="Uniform" />
                                                                                        <TextBlock Text="{x:Bind ClanTag, Mode=OneWay}"
                                                                                                   Foreground="{x:Bind ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                                                   FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </Button>

                                                                            <!-- Badges officiels de l'utilisateur alignés sur la même ligne -->
                                                                            <ItemsControl ItemsSource="{x:Bind Badges, Mode=OneWay}"
                                                                                          VerticalAlignment="Center"
                                                                                          Visibility="{x:Bind HasBadges, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="models:DiscordBadge">
                                                                                        <Image Width="18" Height="18"
                                                                                               Source="{x:Bind IconUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                                                                               ToolTipService.ToolTip="{x:Bind Description}"
                                                                                               Stretch="Uniform" />
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>

                                                                        <!-- Ligne Mutual Friends • Mutual Servers -->
                                                                        <TextBlock Text="{x:Bind MutualSummaryText, Mode=OneWay}"
                                                                                   Foreground="{x:Bind ProfileSecondaryTextColorHex, Mode=OneWay}"
                                                                                   Opacity="0.85" FontSize="12" FontWeight="Medium"
                                                                                   Visibility="{x:Bind HasMutualInfo, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                                        <!-- Carte Rich Presence (RPC) de l'utilisateur -->
                                                                        <Border Visibility="{x:Bind HasRichPresence, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                Background="{x:Bind ProfileCardInnerBackgroundColorHex, Mode=OneWay}"
                                                                                BorderBrush="{x:Bind ProfileCardInnerBorderColorHex, Mode=OneWay}"
                                                                                BorderThickness="1" CornerRadius="10" Padding="10">
                                                                            <StackPanel Spacing="6">
                                                                                <TextBlock Text="{x:Bind PrimaryActivity.HeaderLabel, Mode=OneWay}"
                                                                                           Foreground="{x:Bind ProfileSecondaryTextColorHex, Mode=OneWay}"
                                                                                           FontSize="10" FontWeight="Bold" Opacity="0.8" />
                                                                                <Grid ColumnSpacing="10">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <Grid Grid.Column="0" Width="52" Height="52" VerticalAlignment="Top"
                                                                                          Visibility="{x:Bind PrimaryActivity.HasLargeImage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                        <Border Width="52" Height="52" CornerRadius="8">
                                                                                            <Border.Background>
                                                                                                <ImageBrush ImageSource="{x:Bind PrimaryActivity.LargeImageUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                                            </Border.Background>
                                                                                        </Border>
                                                                                        <Ellipse Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"
                                                                                                 Stroke="{ThemeResource CardBackgroundFillColorDefaultBrush}" StrokeThickness="2"
                                                                                                 Visibility="{x:Bind PrimaryActivity.HasSmallImage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                            <Ellipse.Fill>
                                                                                                <ImageBrush ImageSource="{x:Bind PrimaryActivity.SmallImageUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                                            </Ellipse.Fill>
                                                                                        </Ellipse>
                                                                                    </Grid>
                                                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                                        <TextBlock Text="{x:Bind PrimaryActivity.Name, Mode=OneWay}"
                                                                                                   Foreground="{x:Bind ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                                                   FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                                                        <TextBlock Text="{x:Bind PrimaryActivity.Details, Mode=OneWay}"
                                                                                                   Foreground="{x:Bind ProfileSecondaryTextColorHex, Mode=OneWay}"
                                                                                                   FontSize="11" Opacity="0.85" TextTrimming="CharacterEllipsis"
                                                                                                   Visibility="{x:Bind PrimaryActivity.HasDetails, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                                        <TextBlock Text="{x:Bind PrimaryActivity.State, Mode=OneWay}"
                                                                                                   Foreground="{x:Bind ProfileMutedTextColorHex, Mode=OneWay}"
                                                                                                   FontSize="11" Opacity="0.8" TextTrimming="CharacterEllipsis"
                                                                                                   Visibility="{x:Bind PrimaryActivity.HasState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                                        <TextBlock Text="{x:Bind PrimaryActivity.ElapsedText, Mode=OneWay}" FontSize="11" Foreground="#23A55A" FontWeight="SemiBold"
                                                                                                   Visibility="{x:Bind PrimaryActivity.HasElapsed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                            </StackPanel>
                                                                        </Border>

                                                                        <!-- Widget Game Collection de l'utilisateur -->
                                                                        <Border Visibility="{x:Bind HasGameWidgets, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                Background="{x:Bind ProfileCardInnerBackgroundColorHex, Mode=OneWay}"
                                                                                BorderBrush="{x:Bind ProfileCardInnerBorderColorHex, Mode=OneWay}"
                                                                                BorderThickness="1" CornerRadius="10" Padding="10,8">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                                    <TextBlock Text="Game"
                                                                                               Foreground="{x:Bind ProfileSecondaryTextColorHex, Mode=OneWay}"
                                                                                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                                    <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{x:Bind ProfileMutedTextColorHex, Mode=OneWay}" Opacity="0.8" VerticalAlignment="Center" />
                                                                                </StackPanel>
                                                                                <ItemsControl Grid.Column="1" ItemsSource="{x:Bind GameWidgets, Mode=OneWay}" VerticalAlignment="Center">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                                        </ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate x:DataType="models:DiscordWidgetGame">
                                                                                            <Border Width="26" Height="26" CornerRadius="6" ToolTipService.ToolTip="{x:Bind TooltipText}">
                                                                                                <Border.Background>
                                                                                                    <ImageBrush ImageSource="{x:Bind IconUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                                                </Border.Background>
                                                                                            </Border>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </Grid>
                                                                        </Border>

                                                                        <!-- Bio directe comme sur Discord -->
                                                                        <TextBlock Text="{x:Bind AboutMe, Mode=OneWay}"
                                                                                   Foreground="{x:Bind ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                                   FontSize="13" TextWrapping="Wrap" Opacity="0.95" />

                                                                        <!-- Comptes et liens reliés affichés sur le profil de l'utilisateur -->
                                                                        <StackPanel Spacing="6" Visibility="{x:Bind HasConnectedAccounts, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <ItemsControl ItemsSource="{x:Bind ConnectedAccounts, Mode=OneWay}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <StackPanel Spacing="4" />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="models:DiscordConnectedAccount">
                                                                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                                                Background="{x:Bind CardBackgroundColorHex, Mode=OneWay}"
                                                                                                BorderBrush="{x:Bind CardBorderColorHex, Mode=OneWay}"
                                                                                                BorderThickness="1" CornerRadius="8" Padding="10,7"
                                                                                                Tag="{x:Bind}"
                                                                                                Click="OnConnectedAccountClicked"
                                                                                                ToolTipService.ToolTip="{x:Bind TooltipText}">
                                                                                            <Grid ColumnSpacing="8">
                                                                                                <Grid.ColumnDefinitions>
                                                                                                    <ColumnDefinition Width="Auto" />
                                                                                                    <ColumnDefinition Width="*" />
                                                                                                    <ColumnDefinition Width="Auto" />
                                                                                                </Grid.ColumnDefinitions>
                                                                                                <Border Grid.Column="0" Width="30" Height="30" Background="{x:Bind IconBadgeBackgroundColorHex, Mode=OneWay}"
                                                                                                        BorderBrush="{x:Bind IconBadgeBorderColorHex, Mode=OneWay}" BorderThickness="1"
                                                                                                        CornerRadius="8" VerticalAlignment="Center"
                                                                                                        ToolTipService.ToolTip="{x:Bind PlatformBubbleName}">
                                                                                                    <FontIcon Glyph="{x:Bind PlatformGlyph}" FontSize="15" Foreground="{x:Bind IconGlyphColorHex, Mode=OneWay}"
                                                                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                                </Border>
                                                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                                                        <TextBlock Text="{x:Bind Name}" Foreground="{x:Bind TextColorHex, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="165" />
                                                                                                        <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="#23A55A" VerticalAlignment="Center"
                                                                                                                  Visibility="{x:Bind Verified, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                                                  ToolTipService.ToolTip="Compte vérifié" />
                                                                                                    </StackPanel>
                                                                                                    <TextBlock Text="{x:Bind PlatformDisplayName}" Foreground="{x:Bind SecondaryTextColorHex, Mode=OneWay}" FontSize="10" Opacity="0.8" />
                                                                                                </StackPanel>
                                                                                                <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="12" Foreground="{x:Bind SecondaryTextColorHex, Mode=OneWay}" Opacity="0.85" VerticalAlignment="Center"
                                                                                                          Visibility="{x:Bind HasUrl, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                                            </Grid>
                                                                                        </Button>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>

                                                                        <!-- Rôles de l'utilisateur dans le serveur -->
                                                                        <StackPanel Spacing="4" Visibility="{x:Bind HasDisplayRoles, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <TextBlock Text="RÔLES" FontSize="10" FontWeight="Bold" Foreground="{x:Bind ProfileMutedTextColorHex, Mode=OneWay}" Opacity="0.75" />
                                                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                                                          HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                                                                                <ItemsControl ItemsSource="{x:Bind DisplayRoles, Mode=OneWay}">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                                        </ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate x:DataType="models:DiscordRole">
                                                                                            <Border Background="#2b2d31" BorderBrush="#35373c" BorderThickness="1" CornerRadius="6" Padding="6,3">
                                                                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                                                    <Ellipse Width="8" Height="8" Fill="{x:Bind ColorHex}" VerticalAlignment="Center" />
                                                                                                    <TextBlock Text="{x:Bind Name}" FontSize="11" FontWeight="SemiBold" Foreground="#F2F3F5" VerticalAlignment="Center" />
                                                                                                </StackPanel>
                                                                                            </Border>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </ScrollViewer>
                                                                        </StackPanel>

                                                                        <!-- Champ de message direct actif (Entrée pour envoyer un MP) -->
                                                                        <Grid Margin="0,4,0,0">
                                                                            <TextBox PlaceholderText="{x:Bind QuickMessagePlaceholder, Mode=OneWay}"
                                                                                     Tag="{x:Bind}"
                                                                                     KeyDown="OnQuickProfileMessageKeyDown"
                                                                                     Background="{x:Bind ProfileInputBackgroundColorHex, Mode=OneWay}"
                                                                                     Foreground="{x:Bind ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                                     BorderBrush="{x:Bind ProfileInputBorderColorHex, Mode=OneWay}"
                                                                                     BorderThickness="1"
                                                                                     CornerRadius="8" Padding="10,6,34,6" FontSize="12" />
                                                                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                                    Margin="0,0,4,0" Padding="4"
                                                                                    Background="Transparent" BorderThickness="0" CornerRadius="6"
                                                                                    ToolTipService.ToolTip="Émojis">
                                                                                <FontIcon Glyph="&#xE76E;" FontSize="13" Foreground="{x:Bind ProfileMutedTextColorHex, Mode=OneWay}" />
                                                                            </Button>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </Flyout>
                                                    </Button.Flyout>

                                                    <!-- Affichage du membre dans la liste -->
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Grid Width="32" Height="32" PointerEntered="OnAvatarPointerEntered" PointerExited="OnAvatarPointerExited">
                                                            <Ellipse Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                                                            <Ellipse>
                                                                <Ellipse.Fill>
                                                                    <ImageBrush ImageSource="{x:Bind AvatarUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                </Ellipse.Fill>
                                                            </Ellipse>
                                                            <Ellipse Width="10" Height="10" Fill="{x:Bind StatusColor, Mode=OneWay}"
                                                                     Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="2"
                                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                                        </Grid>
                                                        <StackPanel VerticalAlignment="Center" MaxWidth="150">
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind DisplayName}" FontSize="13" FontWeight="Medium" Foreground="{x:Bind RoleColorHex, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxWidth="110" />
                                                                <!-- Tag de Clan -->
                                                                <Button Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="4"
                                                                        Visibility="{x:Bind HasClan, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                        Tag="{x:Bind}" Click="OnClanTagPillClicked"
                                                                        ToolTipService.ToolTip="Afficher le profil du clan">
                                                                    <Border Background="#2b2d31" CornerRadius="4" Padding="4,1" VerticalAlignment="Center">
                                                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                                                            <Image Width="10" Height="10" Source="{x:Bind ClanBadgeUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="Uniform" />
                                                                            <TextBlock Text="{x:Bind ClanTag, Mode=OneWay}" FontSize="9" FontWeight="Bold" Foreground="#DBDEE1" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Button>
                                                                <!-- Badge Bot -->
                                                                <Border Visibility="{x:Bind Bot, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                        Background="#5865F2" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                                                    <TextBlock Text="APP" FontSize="9" FontWeight="Bold" Foreground="White" />
                                                                </Border>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                                                        Visibility="{x:Bind HasActivityOrCustomStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <FontIcon Glyph="&#xE767;" FontSize="11" Foreground="#23A55A" VerticalAlignment="Center"
                                                                          Visibility="{x:Bind IsInVoice, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                <TextBlock Text="{x:Bind ActivitySummaryText, Mode=OneWay}" FontSize="11" Foreground="#23A55A" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                                <!-- 3. SECTION HORS LIGNE (Gérée via MemberGroups ci-dessus) -->
                                <StackPanel Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="6,8,6,4">
                                        <TextBlock Text="HORS LIGNE" FontSize="11" FontWeight="Bold" Foreground="#949BA4" />
                                        <TextBlock Text="—" FontSize="11" FontWeight="Bold" Foreground="#949BA4" />
                                        <TextBlock Text="{x:Bind ViewModel.OfflineMembersCount, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#949BA4" />
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{x:Bind ViewModel.OfflineMembers, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:DiscordUser">
                                                <Button Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left" Padding="6,5" CornerRadius="8" Opacity="0.65"
                                                        Tag="{x:Bind}" Click="OnMemberItemClicked" DoubleTapped="OnMemberItemDoubleTapped"
                                                        ToolTipService.ToolTip="{x:Bind DisplayName}">
                                                    <Button.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="Profil" Tag="{x:Bind}" Click="OnUserMenuProfileClicked">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77B;" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Mentionner" Tag="{x:Bind}" Click="OnUserMenuMentionClicked">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE910;" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Message privé" Tag="{x:Bind}" Click="OnUserMenuDirectMessageClicked">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8BD;" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Appeler" Tag="{x:Bind}" Click="OnUserMenuCallClicked">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE717;" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutSubItem Text="Volume utilisateur">
                                                                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE767;" /></MenuFlyoutSubItem.Icon>
                                                                <MenuFlyoutItem Text="200% (Maximum)" Tag="2.0" Click="OnUserMenuSetVolumeClicked" />
                                                                <MenuFlyoutItem Text="150%" Tag="1.5" Click="OnUserMenuSetVolumeClicked" />
                                                                <MenuFlyoutItem Text="100% (Normal)" Tag="1.0" Click="OnUserMenuSetVolumeClicked" />
                                                                <MenuFlyoutItem Text="75%" Tag="0.75" Click="OnUserMenuSetVolumeClicked" />
                                                                <MenuFlyoutItem Text="50%" Tag="0.5" Click="OnUserMenuSetVolumeClicked" />
                                                                <MenuFlyoutItem Text="25%" Tag="0.25" Click="OnUserMenuSetVolumeClicked" />
                                                                <MenuFlyoutItem Text="Couper le son (0%)" Tag="0.0" Click="OnUserMenuSetVolumeClicked" />
                                                            </MenuFlyoutSubItem>
                                                            <MenuFlyoutItem Text="Mettre en sourdine locale" Tag="{x:Bind}" Click="OnUserMenuToggleMuteClicked">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74F;" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem Text="Ajouter en ami" Tag="{x:Bind}" Click="OnUserMenuAddFriendClicked">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FA;" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Bloquer" Foreground="#FF453A" Tag="{x:Bind}" Click="OnUserMenuBlockClicked">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE894;" Foreground="#FF453A" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem Text="Copier le nom d'utilisateur" Tag="{x:Bind}" Click="OnUserMenuCopyUsernameClicked">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Copier le pseudo" Tag="{x:Bind}" Click="OnUserMenuCopyDisplayNameClicked">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Copier l'identifiant" Tag="{x:Bind}" Click="OnUserMenuCopyIdClicked">
                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                        </MenuFlyout>
                                                    </Button.ContextFlyout>
                                                    <Button.Flyout>
                                                        <Flyout Opening="OnUserProfileFlyoutOpening" Placement="LeftEdgeAlignedTop">
                                                            <Flyout.FlyoutPresenterStyle>
                                                                <Style TargetType="FlyoutPresenter">
                                                                    <Setter Property="Padding" Value="0" />
                                                                    <Setter Property="CornerRadius" Value="18" />
                                                                    <Setter Property="MaxWidth" Value="350" />
                                                                    <Setter Property="Background" Value="Transparent" />
                                                                    <Setter Property="BorderThickness" Value="0" />
                                                                </Style>
                                                            </Flyout.FlyoutPresenterStyle>
                                                            <Border Width="336" CornerRadius="18"
                                                                    BorderBrush="{x:Bind ProfileBorderColorHex, Mode=OneWay}"
                                                                    BorderThickness="3"
                                                                    Tag="{x:Bind}">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="{x:Bind ProfilePrimaryColorHex, Mode=OneWay}" Offset="0.0" />
                                                                        <GradientStop Color="{x:Bind ProfileSecondaryColorHex, Mode=OneWay}" Offset="1.0" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                                <Grid>
                                                                    <!-- Bannière (124px de haut, calée en haut, coins arrondis clippés) avec boutons d'actions -->
                                                                    <Border Height="124" VerticalAlignment="Top" Background="{x:Bind BannerColorHex, Mode=OneWay}" CornerRadius="15,15,0,0">
                                                                        <Grid>
                                                                            <Border CornerRadius="15,15,0,0"
                                                                                    Visibility="{x:Bind HasBanner, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                <Border.Background>
                                                                                    <ImageBrush ImageSource="{x:Bind BannerUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                                                                Stretch="UniformToFill" AlignmentY="Center" AlignmentX="Center" />
                                                                                </Border.Background>
                                                                            </Border>
                                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Spacing="6">
                                                                                <Button Width="30" Height="30" Padding="0" CornerRadius="15"
                                                                                        Background="#66000000" BorderThickness="0"
                                                                                        Visibility="{x:Bind IsNotCurrentUser, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                        ToolTipService.ToolTip="{x:Bind FriendStatusTooltip, Mode=OneWay}"
                                                                                        Tag="{x:Bind}" Click="OnAddFriendFromPopoutClicked">
                                                                                    <FontIcon Glyph="{x:Bind FriendActionGlyph, Mode=OneWay}" FontSize="13" Foreground="#FFFFFF" />
                                                                                </Button>
                                                                                <Button Width="30" Height="30" Padding="0" CornerRadius="15"
                                                                                        Background="#66000000" BorderThickness="0"
                                                                                        ToolTipService.ToolTip="Plus d'options">
                                                                                    <Button.Flyout>
                                                                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                                            <MenuFlyoutItem Text="Voir le profil complet" Tag="{x:Bind}" Click="OnViewFullProfileFromPopoutClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE77B;" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutItem Text="Partager le profil" Tag="{x:Bind}" Click="OnShareProfileFromPopoutClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE72D;" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutItem Text="Shop This Look">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE719;" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutItem Text="Inviter sur le serveur" Tag="{x:Bind}" Click="OnInviteUserToGuildClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE8FA;" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutSeparator />
                                                                                            <MenuFlyoutItem Text="Ignorer" Tag="{x:Bind}" Click="OnIgnoreUserClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE7BA;" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutItem Text="Bloquer" Foreground="#F23F43" Tag="{x:Bind}" Click="OnBlockUserFromPopoutClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE72B;" Foreground="#F23F43" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutItem Text="Signaler le profil d'utilisateur" Foreground="#F23F43" Tag="{x:Bind}" Click="OnReportUserClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE730;" Foreground="#F23F43" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutSeparator />
                                                                                            <MenuFlyoutItem Text="Copier l'identifiant" Tag="{x:Bind}" Click="OnCopyUserIdFromPopoutClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE8C8;" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                        </MenuFlyout>
                                                                                    </Button.Flyout>
                                                                                    <FontIcon Glyph="&#xE712;" FontSize="13" Foreground="#FFFFFF" />
                                                                                </Button>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>

                                                                    <!-- Avatar rond avec bordure assortie à la couleur principale du profil (cliquable pour ouvrir la vue complète) -->
                                                                    <Button Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="43"
                                                                            Margin="16,74,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                            ToolTipService.ToolTip="Afficher le profil complet"
                                                                            Tag="{x:Bind}"
                                                                            Click="OnOpenFullUserProfileFromPopoutClicked">
                                                                        <Ellipse Width="86" Height="86"
                                                                                 StrokeThickness="6" Stroke="{x:Bind ProfileAvatarCutoutStrokeColorHex, Mode=OneWay}">
                                                                            <Ellipse.Fill>
                                                                                <ImageBrush ImageSource="{x:Bind AvatarUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                            </Ellipse.Fill>
                                                                        </Ellipse>
                                                                    </Button>

                                                                    <!-- Pastille de statut sur l'avatar -->
                                                                    <Ellipse Width="22" Height="22" Margin="78,136,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                             Fill="{x:Bind StatusColor, Mode=OneWay}"
                                                                             Stroke="{x:Bind ProfileAvatarCutoutStrokeColorHex, Mode=OneWay}" StrokeThickness="4" />

                                                                    <!-- Bulle de pensée Statut Personnalisé à droite de l'avatar (comme sur la capture Discord) -->
                                                                    <Border Margin="112,110,14,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                            Background="#F2FFFFFF" CornerRadius="16" Padding="12,7"
                                                                            Visibility="{x:Bind HasCustomStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                        <TextBlock Text="{x:Bind CustomStatusText, Mode=OneWay}"
                                                                                   Foreground="#1E1F22" FontSize="12" FontWeight="Medium"
                                                                                   TextTrimming="CharacterEllipsis" MaxWidth="185" />
                                                                    </Border>

                                                                    <!-- Corps du profil positionné proprement sous la bannière -->
                                                                    <StackPanel Margin="16,168,16,16" Spacing="8">
                                                                        <!-- Nom d'affichage en grand + bouton Note -->
                                                                        <Grid>
                                                                            <TextBlock Text="{x:Bind DisplayName}"
                                                                                       Foreground="{x:Bind ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                                       FontWeight="Bold" FontSize="20" TextTrimming="CharacterEllipsis" Margin="0,0,26,0" />
                                                                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Padding="4" Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTipService.ToolTip="Note sur l'utilisateur">
                                                                                <FontIcon Glyph="&#xE70F;" FontSize="13" Foreground="{x:Bind ProfileTextForegroundColorHex, Mode=OneWay}" Opacity="0.8" />
                                                                            </Button>
                                                                        </Grid>

                                                                        <!-- Ligne : username • pronoms [Clan] + Badges officiels côte à côte -->
                                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                            <TextBlock Text="{x:Bind Username}"
                                                                                       Foreground="{x:Bind ProfileSecondaryTextColorHex, Mode=OneWay}"
                                                                                       Opacity="0.85" FontSize="13" VerticalAlignment="Center" />
                                                                            <TextBlock Text="•"
                                                                                       Foreground="{x:Bind ProfileMutedTextColorHex, Mode=OneWay}"
                                                                                       Opacity="0.55" FontSize="12" VerticalAlignment="Center"
                                                                                       Visibility="{x:Bind HasPronouns, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                            <TextBlock Text="{x:Bind Pronouns, Mode=OneWay}"
                                                                                       Foreground="{x:Bind ProfileSecondaryTextColorHex, Mode=OneWay}"
                                                                                       Opacity="0.85" FontSize="13" VerticalAlignment="Center"
                                                                                       Visibility="{x:Bind HasPronouns, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                                            <!-- Tag de Clan / Serveur avec son icône -->
                                                                            <Button Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6"
                                                                                    Visibility="{x:Bind HasClan, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                    Tag="{x:Bind}" Click="OnClanTagPillClicked"
                                                                                    ToolTipService.ToolTip="Afficher le profil du clan">
                                                                                <Border Background="{x:Bind ProfilePillBackgroundColorHex, Mode=OneWay}"
                                                                                        BorderBrush="{x:Bind ProfilePillBorderColorHex, Mode=OneWay}"
                                                                                        BorderThickness="1" CornerRadius="6" Padding="7,2" VerticalAlignment="Center">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                                        <Image Width="14" Height="14" Source="{x:Bind ClanBadgeUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="Uniform" />
                                                                                        <TextBlock Text="{x:Bind ClanTag, Mode=OneWay}"
                                                                                                   Foreground="{x:Bind ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                                                   FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </Button>

                                                                            <!-- Badges officiels de l'utilisateur alignés sur la même ligne -->
                                                                            <ItemsControl ItemsSource="{x:Bind Badges, Mode=OneWay}"
                                                                                          VerticalAlignment="Center"
                                                                                          Visibility="{x:Bind HasBadges, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="models:DiscordBadge">
                                                                                        <Image Width="18" Height="18"
                                                                                               Source="{x:Bind IconUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                                                                               ToolTipService.ToolTip="{x:Bind Description}"
                                                                                               Stretch="Uniform" />
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>

                                                                        <!-- Ligne Mutual Friends • Mutual Servers -->
                                                                        <TextBlock Text="{x:Bind MutualSummaryText, Mode=OneWay}"
                                                                                   Foreground="{x:Bind ProfileSecondaryTextColorHex, Mode=OneWay}"
                                                                                   Opacity="0.85" FontSize="12" FontWeight="Medium"
                                                                                   Visibility="{x:Bind HasMutualInfo, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                                        <!-- Carte Rich Presence (RPC) de l'utilisateur -->
                                                                        <Border Visibility="{x:Bind HasRichPresence, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                Background="{x:Bind ProfileCardInnerBackgroundColorHex, Mode=OneWay}"
                                                                                BorderBrush="{x:Bind ProfileCardInnerBorderColorHex, Mode=OneWay}"
                                                                                BorderThickness="1" CornerRadius="10" Padding="10">
                                                                            <StackPanel Spacing="6">
                                                                                <TextBlock Text="{x:Bind PrimaryActivity.HeaderLabel, Mode=OneWay}"
                                                                                           Foreground="{x:Bind ProfileSecondaryTextColorHex, Mode=OneWay}"
                                                                                           FontSize="10" FontWeight="Bold" Opacity="0.8" />
                                                                                <Grid ColumnSpacing="10">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <Grid Grid.Column="0" Width="52" Height="52" VerticalAlignment="Top"
                                                                                          Visibility="{x:Bind PrimaryActivity.HasLargeImage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                        <Border Width="52" Height="52" CornerRadius="8">
                                                                                            <Border.Background>
                                                                                                <ImageBrush ImageSource="{x:Bind PrimaryActivity.LargeImageUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                                            </Border.Background>
                                                                                        </Border>
                                                                                        <Ellipse Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"
                                                                                                 Stroke="{ThemeResource CardBackgroundFillColorDefaultBrush}" StrokeThickness="2"
                                                                                                 Visibility="{x:Bind PrimaryActivity.HasSmallImage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                            <Ellipse.Fill>
                                                                                                <ImageBrush ImageSource="{x:Bind PrimaryActivity.SmallImageUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                                            </Ellipse.Fill>
                                                                                        </Ellipse>
                                                                                    </Grid>
                                                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                                        <TextBlock Text="{x:Bind PrimaryActivity.Name, Mode=OneWay}"
                                                                                                   Foreground="{x:Bind ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                                                   FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                                                        <TextBlock Text="{x:Bind PrimaryActivity.Details, Mode=OneWay}"
                                                                                                   Foreground="{x:Bind ProfileSecondaryTextColorHex, Mode=OneWay}"
                                                                                                   FontSize="11" Opacity="0.85" TextTrimming="CharacterEllipsis"
                                                                                                   Visibility="{x:Bind PrimaryActivity.HasDetails, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                                        <TextBlock Text="{x:Bind PrimaryActivity.State, Mode=OneWay}"
                                                                                                   Foreground="{x:Bind ProfileMutedTextColorHex, Mode=OneWay}"
                                                                                                   FontSize="11" Opacity="0.8" TextTrimming="CharacterEllipsis"
                                                                                                   Visibility="{x:Bind PrimaryActivity.HasState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                                        <TextBlock Text="{x:Bind PrimaryActivity.ElapsedText, Mode=OneWay}" FontSize="11" Foreground="#23A55A" FontWeight="SemiBold"
                                                                                                   Visibility="{x:Bind PrimaryActivity.HasElapsed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                            </StackPanel>
                                                                        </Border>

                                                                        <!-- Widget Game Collection de l'utilisateur -->
                                                                        <Border Visibility="{x:Bind HasGameWidgets, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                Background="{x:Bind ProfileCardInnerBackgroundColorHex, Mode=OneWay}"
                                                                                BorderBrush="{x:Bind ProfileCardInnerBorderColorHex, Mode=OneWay}"
                                                                                BorderThickness="1" CornerRadius="10" Padding="10,8">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                                    <TextBlock Text="Game"
                                                                                               Foreground="{x:Bind ProfileSecondaryTextColorHex, Mode=OneWay}"
                                                                                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                                    <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{x:Bind ProfileMutedTextColorHex, Mode=OneWay}" Opacity="0.8" VerticalAlignment="Center" />
                                                                                </StackPanel>
                                                                                <ItemsControl Grid.Column="1" ItemsSource="{x:Bind GameWidgets, Mode=OneWay}" VerticalAlignment="Center">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                                        </ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate x:DataType="models:DiscordWidgetGame">
                                                                                            <Border Width="26" Height="26" CornerRadius="6" ToolTipService.ToolTip="{x:Bind TooltipText}">
                                                                                                <Border.Background>
                                                                                                    <ImageBrush ImageSource="{x:Bind IconUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                                                </Border.Background>
                                                                                            </Border>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </Grid>
                                                                        </Border>

                                                                        <!-- Bio directe comme sur Discord -->
                                                                        <TextBlock Text="{x:Bind AboutMe, Mode=OneWay}"
                                                                                   Foreground="{x:Bind ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                                   FontSize="13" TextWrapping="Wrap" Opacity="0.95" />

                                                                        <!-- Comptes et liens reliés affichés sur le profil de l'utilisateur -->
                                                                        <StackPanel Spacing="6" Visibility="{x:Bind HasConnectedAccounts, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <ItemsControl ItemsSource="{x:Bind ConnectedAccounts, Mode=OneWay}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <StackPanel Spacing="4" />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="models:DiscordConnectedAccount">
                                                                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                                                Background="{x:Bind CardBackgroundColorHex, Mode=OneWay}"
                                                                                                BorderBrush="{x:Bind CardBorderColorHex, Mode=OneWay}"
                                                                                                BorderThickness="1" CornerRadius="8" Padding="10,7"
                                                                                                Tag="{x:Bind}"
                                                                                                Click="OnConnectedAccountClicked"
                                                                                                ToolTipService.ToolTip="{x:Bind TooltipText}">
                                                                                            <Grid ColumnSpacing="8">
                                                                                                <Grid.ColumnDefinitions>
                                                                                                    <ColumnDefinition Width="Auto" />
                                                                                                    <ColumnDefinition Width="*" />
                                                                                                    <ColumnDefinition Width="Auto" />
                                                                                                </Grid.ColumnDefinitions>
                                                                                                <Border Grid.Column="0" Width="30" Height="30" Background="{x:Bind IconBadgeBackgroundColorHex, Mode=OneWay}"
                                                                                                        BorderBrush="{x:Bind IconBadgeBorderColorHex, Mode=OneWay}" BorderThickness="1"
                                                                                                        CornerRadius="8" VerticalAlignment="Center"
                                                                                                        ToolTipService.ToolTip="{x:Bind PlatformBubbleName}">
                                                                                                    <FontIcon Glyph="{x:Bind PlatformGlyph}" FontSize="15" Foreground="{x:Bind IconGlyphColorHex, Mode=OneWay}"
                                                                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                                </Border>
                                                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                                                        <TextBlock Text="{x:Bind Name}" Foreground="{x:Bind TextColorHex, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="165" />
                                                                                                        <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="#23A55A" VerticalAlignment="Center"
                                                                                                                  Visibility="{x:Bind Verified, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                                                  ToolTipService.ToolTip="Compte vérifié" />
                                                                                                    </StackPanel>
                                                                                                    <TextBlock Text="{x:Bind PlatformDisplayName}" Foreground="{x:Bind SecondaryTextColorHex, Mode=OneWay}" FontSize="10" Opacity="0.8" />
                                                                                                </StackPanel>
                                                                                                <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="12" Foreground="{x:Bind SecondaryTextColorHex, Mode=OneWay}" Opacity="0.85" VerticalAlignment="Center"
                                                                                                          Visibility="{x:Bind HasUrl, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                                            </Grid>
                                                                                        </Button>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>

                                                                        <!-- Rôles de l'utilisateur dans le serveur -->
                                                                        <StackPanel Spacing="4" Visibility="{x:Bind HasDisplayRoles, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <TextBlock Text="RÔLES" FontSize="10" FontWeight="Bold" Foreground="{x:Bind ProfileMutedTextColorHex, Mode=OneWay}" Opacity="0.75" />
                                                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                                                          HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                                                                                <ItemsControl ItemsSource="{x:Bind DisplayRoles, Mode=OneWay}">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                                        </ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate x:DataType="models:DiscordRole">
                                                                                            <Border Background="#2b2d31" BorderBrush="#35373c" BorderThickness="1" CornerRadius="6" Padding="6,3">
                                                                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                                                    <Ellipse Width="8" Height="8" Fill="{x:Bind ColorHex}" VerticalAlignment="Center" />
                                                                                                    <TextBlock Text="{x:Bind Name}" FontSize="11" FontWeight="SemiBold" Foreground="#F2F3F5" VerticalAlignment="Center" />
                                                                                                </StackPanel>
                                                                                            </Border>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </ScrollViewer>
                                                                        </StackPanel>

                                                                        <!-- Champ de message direct actif (Entrée pour envoyer un MP) -->
                                                                        <Grid Margin="0,4,0,0">
                                                                            <TextBox PlaceholderText="{x:Bind QuickMessagePlaceholder, Mode=OneWay}"
                                                                                     Tag="{x:Bind}"
                                                                                     KeyDown="OnQuickProfileMessageKeyDown"
                                                                                     Background="{x:Bind ProfileInputBackgroundColorHex, Mode=OneWay}"
                                                                                     Foreground="{x:Bind ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                                     BorderBrush="{x:Bind ProfileInputBorderColorHex, Mode=OneWay}"
                                                                                     BorderThickness="1"
                                                                                     CornerRadius="8" Padding="10,6,34,6" FontSize="12" />
                                                                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                                    Margin="0,0,4,0" Padding="4"
                                                                                    Background="Transparent" BorderThickness="0" CornerRadius="6"
                                                                                    ToolTipService.ToolTip="Émojis">
                                                                                <FontIcon Glyph="&#xE76E;" FontSize="13" Foreground="{x:Bind ProfileMutedTextColorHex, Mode=OneWay}" />
                                                                            </Button>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </Flyout>
                                                    </Button.Flyout>

                                                    <!-- Affichage membre hors ligne -->
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Grid Width="32" Height="32">
                                                            <Ellipse Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                                                            <Ellipse>
                                                                <Ellipse.Fill>
                                                                    <ImageBrush ImageSource="{x:Bind AvatarUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                </Ellipse.Fill>
                                                            </Ellipse>
                                                            <Ellipse Width="10" Height="10" Fill="{x:Bind StatusColor, Mode=OneWay}"
                                                                     Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="2"
                                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                                        </Grid>
                                                        <StackPanel VerticalAlignment="Center" MaxWidth="150">
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind DisplayName}" FontSize="13" FontWeight="Medium" Foreground="#949BA4" TextTrimming="CharacterEllipsis" MaxWidth="110" />
                                                                <!-- Tag de Clan -->
                                                                <Button Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="4"
                                                                        Visibility="{x:Bind HasClan, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                        Tag="{x:Bind}" Click="OnClanTagPillClicked"
                                                                        ToolTipService.ToolTip="Afficher le profil du clan">
                                                                    <Border Background="#2b2d31" CornerRadius="4" Padding="4,1" VerticalAlignment="Center">
                                                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                                                            <Image Width="10" Height="10" Source="{x:Bind ClanBadgeUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="Uniform" />
                                                                            <TextBlock Text="{x:Bind ClanTag, Mode=OneWay}" FontSize="9" FontWeight="Bold" Foreground="#DBDEE1" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Button>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Barre de saisie de message (avec bannière Réponse/Édition, Collage Presse-papiers & Sélecteur d'Emojis) -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Visibility="{x:Bind ViewModel.TextViewVisibility, Mode=OneWay}" Padding="16,0,16,16" Spacing="6">
                        <!-- Bannière Réponse ou Modification en cours -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12,6"
                                Visibility="{x:Bind ViewModel.ComposerBannerVisibility, Mode=OneWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.ComposerBannerText, Mode=OneWay}"
                                           FontSize="12" FontWeight="SemiBold" Opacity="0.85"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Padding="6,2" CornerRadius="6"
                                        Background="Transparent" BorderThickness="0"
                                        Click="OnCancelComposerActionClicked" ToolTipService.ToolTip="Annuler">
                                    <FontIcon Glyph="&#xE711;" FontSize="10" />
                                </Button>
                            </Grid>
                        </Border>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Width="40" Height="40" CornerRadius="20" Padding="0"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}" BorderThickness="0"
                                    Click="OnAttachFileClicked" ToolTipService.ToolTip="Joindre un fichier ou une image">
                                <FontIcon Glyph="&#xE710;" FontSize="16" />
                            </Button>

                            <Button Grid.Column="1" Width="40" Height="40" CornerRadius="20" Padding="0"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}" BorderThickness="0"
                                    Click="OnPasteClipboardAttachmentClicked" ToolTipService.ToolTip="Envoyer l'image du presse-papiers">
                                <FontIcon Glyph="&#xE77F;" FontSize="15" />
                            </Button>

                            <Button Grid.Column="2" Width="40" Height="40" CornerRadius="20" Padding="0"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}" BorderThickness="0"
                                    Click="OnCreatePollClicked" ToolTipService.ToolTip="Créer un sondage Discord">
                                <FontIcon Glyph="&#xE9D9;" FontSize="15" />
                            </Button>

                            <TextBox Grid.Column="3" x:Name="MessageInput"
                                     PlaceholderText="Écrire un message... ( >4000 car. converti en message.txt )"
                                     CornerRadius="10" BorderThickness="0"
                                     Background="{ThemeResource ControlFillColorDefaultBrush}"
                                     Padding="14,10"
                                     TextChanged="OnMessageInputTextChanged"
                                     KeyDown="OnMessageInputKeyDown" />

                            <!-- Bouton GIF Tenor Discord -->
                            <Button Grid.Column="4" Width="40" Height="40" CornerRadius="20" Padding="0"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}" BorderThickness="0"
                                    ToolTipService.ToolTip="Rechercher un GIF">
                                <TextBlock Text="GIF" FontSize="13" FontWeight="ExtraBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button.Flyout>
                                    <Flyout x:Name="ComposerGifFlyout" Placement="Top" Opening="OnComposerGifFlyoutOpening">
                                        <Flyout.FlyoutPresenterStyle>
                                            <Style TargetType="FlyoutPresenter">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="CornerRadius" Value="12" />
                                                <Setter Property="Background" Value="#2B2D31" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="BorderBrush" Value="#1F2023" />
                                                <Setter Property="MaxWidth" Value="460" />
                                                <Setter Property="MaxHeight" Value="500" />
                                            </Style>
                                        </Flyout.FlyoutPresenterStyle>
                                        <Grid Width="430" Height="460">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <!-- Barre de recherche GIF -->
                                            <TextBox Grid.Row="0" x:Name="GifSearchBox"
                                                     PlaceholderText="Rechercher des GIFs..."
                                                     Margin="12,12,12,8" CornerRadius="8"
                                                     Background="#1E1F22" BorderBrush="#1F2023"
                                                     Padding="10,6"
                                                     TextChanged="OnGifSearchTextChanged" />

                                            <!-- Catégories rapides de GIFs -->
                                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                          Padding="12,0,12,8">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Button Content="Tendances" CornerRadius="6" Padding="8,4" FontSize="11" Tag="trending" Click="OnGifCategoryClicked" />
                                                    <Button Content="Anime" CornerRadius="6" Padding="8,4" FontSize="11" Tag="anime" Click="OnGifCategoryClicked" />
                                                    <Button Content="LOL" CornerRadius="6" Padding="8,4" FontSize="11" Tag="lol" Click="OnGifCategoryClicked" />
                                                    <Button Content="Love" CornerRadius="6" Padding="8,4" FontSize="11" Tag="love" Click="OnGifCategoryClicked" />
                                                    <Button Content="Cat" CornerRadius="6" Padding="8,4" FontSize="11" Tag="cat" Click="OnGifCategoryClicked" />
                                                    <Button Content="Dance" CornerRadius="6" Padding="8,4" FontSize="11" Tag="dance" Click="OnGifCategoryClicked" />
                                                    <Button Content="Happy" CornerRadius="6" Padding="8,4" FontSize="11" Tag="happy" Click="OnGifCategoryClicked" />
                                                    <Button Content="Sad" CornerRadius="6" Padding="8,4" FontSize="11" Tag="sad" Click="OnGifCategoryClicked" />
                                                </StackPanel>
                                            </ScrollViewer>

                                            <!-- Grille de résultats GIFs -->
                                            <ScrollViewer Grid.Row="2" Padding="12,0,12,12">
                                                <GridView ItemsSource="{x:Bind ViewModel.GifResults, Mode=OneWay}" SelectionMode="None">
                                                    <GridView.ItemTemplate>
                                                        <DataTemplate x:DataType="models:DiscordGifItem">
                                                            <Button Width="194" Height="124" Padding="0" Margin="2"
                                                                    CornerRadius="8" BorderThickness="0"
                                                                    Tag="{x:Bind}" Click="OnGifResultItemClicked">
                                                                <Image Source="{x:Bind PreviewUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                                                       Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                                            </Button>
                                                        </DataTemplate>
                                                    </GridView.ItemTemplate>
                                                </GridView>
                                            </ScrollViewer>
                                        </Grid>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <!-- Sélecteur d'Autocollants complet Discord (Packs Discord + Serveurs + Recherche) -->
                            <Button Grid.Column="5" Width="40" Height="40" CornerRadius="20" Padding="0"
                                     Background="{ThemeResource ControlFillColorDefaultBrush}" BorderThickness="0"
                                     ToolTipService.ToolTip="Ouvrir le sélecteur d'autocollants">
                                <FontIcon Glyph="&#xEB9F;" FontSize="16" />
                                <Button.Flyout>
                                    <Flyout x:Name="ComposerStickerFlyout" Placement="Top" Opening="OnComposerStickerPickerOpening">
                                        <Flyout.FlyoutPresenterStyle>
                                            <Style TargetType="FlyoutPresenter">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="CornerRadius" Value="12" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="MaxWidth" Value="460" />
                                                <Setter Property="MaxHeight" Value="500" />
                                            </Style>
                                        </Flyout.FlyoutPresenterStyle>
                                        <controls:DiscordStickerPickerControl x:Name="ComposerStickerPicker"
                                                                              StickerSelected="OnComposerStickerSelected" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <!-- Sélecteur d'Emojis complet Discord (Serveurs + Catégories + Recherche) -->
                            <Button Grid.Column="6" Width="40" Height="40" CornerRadius="20" Padding="0"
                                     Background="{ThemeResource ControlFillColorDefaultBrush}" BorderThickness="0"
                                     ToolTipService.ToolTip="Insérer un émoji">
                                <FontIcon Glyph="&#xED54;" FontSize="16" />
                                <Button.Flyout>
                                    <Flyout x:Name="ComposerEmojiFlyout" Placement="Top" Opening="OnComposerEmojiPickerOpening">
                                        <Flyout.FlyoutPresenterStyle>
                                            <Style TargetType="FlyoutPresenter">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="CornerRadius" Value="12" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="MaxWidth" Value="440" />
                                                <Setter Property="MaxHeight" Value="480" />
                                            </Style>
                                        </Flyout.FlyoutPresenterStyle>
                                        <controls:DiscordEmojiPickerControl x:Name="ComposerEmojiPicker"
                                                                            EmojiSelected="OnComposerEmojiSelected" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <Button Grid.Column="7" Content="Envoyer" Click="OnSendClicked"
                                     CornerRadius="10"
                                     Style="{StaticResource AccentButtonStyle}" />
                        </Grid>

                    </StackPanel>

                    <!-- VUE FORUM (Discord GuildForum Type 15) -->
                    <Grid Grid.Row="1" Grid.RowSpan="2" Grid.Column="0"
                          Visibility="{x:Bind ViewModel.ForumViewVisibility, Mode=OneWay}"
                          Background="#313338">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 1. En-tête Forum : Titre, Topic & Filtres par tags + Bouton Nouveau Post -->
                        <Border Grid.Row="0" Background="#2B2D31" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="20,14">
                            <StackPanel Spacing="12">
                                <!-- Ligne titre du forum + Bouton Nouveau Post -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Border Width="36" Height="36" CornerRadius="18" Background="#5865F2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8BD;" FontSize="18" Foreground="White" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedChannelName, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="#F2F3F5" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedChannelTopic, Mode=OneWay}" FontSize="12" Foreground="#949BA4"
                                                       Visibility="{x:Bind ViewModel.TopicVisibility, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxWidth="500" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="1" Click="OnToggleCreateForumPostClicked"
                                            Background="#5865F2" CornerRadius="8" Padding="14,8" BorderThickness="0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE710;" FontSize="13" Foreground="White" />
                                            <TextBlock Text="Nouveau post" FontWeight="SemiBold" Foreground="White" FontSize="13" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Ligne de Recherche + Filtres par Tags -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0" x:Name="ForumSearchBox"
                                             PlaceholderText="Rechercher une publication..."
                                             CornerRadius="8" Background="#1E1F22" BorderThickness="0"
                                             Padding="12,8" TextChanged="OnForumSearchTextChanged" />

                                    <!-- Tags disponibles pour le filtrage -->
                                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Content="Tous" FontSize="12" Padding="12,5" CornerRadius="14"
                                                    Background="#1E1F22" BorderThickness="0" Foreground="#F2F3F5"
                                                    Click="OnClearForumFilterClicked" />
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.ForumAvailableTags, Mode=OneWay}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:DiscordForumTag">
                                                        <Button Content="{x:Bind DisplayText}" Tag="{x:Bind}" FontSize="12" Padding="12,5"
                                                                CornerRadius="14" Background="#1E1F22" BorderThickness="0" Foreground="#DBDEE1"
                                                                Click="OnForumFilterTagClicked" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 2. Corps du Forum : Panneau de Création (si actif) + Liste des Posts -->
                        <ScrollViewer Grid.Row="1" Padding="20,16" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="16">

                                <!-- Panneau Création de Post (Card) -->
                                <Border Background="#2B2D31" BorderBrush="#383A40" BorderThickness="1" CornerRadius="12" Padding="16"
                                        Visibility="{x:Bind ViewModel.IsCreatingForumPost, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Spacing="12">
                                        <Grid>
                                            <TextBlock Text="Créer une publication" FontWeight="Bold" FontSize="15" Foreground="#F2F3F5" VerticalAlignment="Center" />
                                            <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="6" CornerRadius="6"
                                                    Click="OnCancelCreateForumPostClicked">
                                                <FontIcon Glyph="&#xE711;" FontSize="12" Opacity="0.7" />
                                            </Button>
                                        </Grid>

                                        <TextBox x:Name="ForumNewPostTitleInput" PlaceholderText="Titre de la publication"
                                                 FontSize="14" FontWeight="SemiBold" CornerRadius="8" Background="#1E1F22" BorderThickness="0" Padding="12,8" />

                                        <!-- Sélecteur de tags pour le nouveau post -->
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Sélectionner des tags :" FontSize="11" Foreground="#949BA4" FontWeight="SemiBold" />
                                            <ItemsControl x:Name="ForumNewPostTagsControl" ItemsSource="{x:Bind ViewModel.ForumAvailableTags, Mode=OneWay}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:DiscordForumTag">
                                                        <ToggleButton Content="{x:Bind DisplayText}" Tag="{x:Bind Id}"
                                                                      Checked="OnForumComposerTagChecked" Unchecked="OnForumComposerTagUnchecked"
                                                                      FontSize="11" Padding="10,4" CornerRadius="12"
                                                                      Background="#1E1F22" BorderThickness="0" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <TextBox x:Name="ForumNewPostContentInput" PlaceholderText="Écrivez le message de départ..."
                                                 AcceptsReturn="True" MinHeight="100" TextWrapping="Wrap"
                                                 CornerRadius="8" Background="#1E1F22" BorderThickness="0" Padding="12,8" />

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                            <Button Content="Annuler" Click="OnCancelCreateForumPostClicked"
                                                    CornerRadius="8" Padding="14,6" Background="Transparent" BorderThickness="0" />
                                            <Button Content="Publier" Click="OnPublishForumPostClicked"
                                                    Background="#5865F2" Foreground="White" FontWeight="SemiBold"
                                                    CornerRadius="8" Padding="18,6" BorderThickness="0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- En-tête de décompte des posts -->
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="{x:Bind ViewModel.ForumPostsCountText, Mode=OneWay}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#949BA4" />
                                </Grid>

                                <!-- État vide si 0 post -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,40" Spacing="10"
                                            Visibility="{x:Bind ViewModel.HasFilteredForumPosts, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <FontIcon Glyph="&#xE8BD;" FontSize="40" Foreground="#4E5058" HorizontalAlignment="Center" />
                                    <TextBlock Text="Aucune publication trouvée" FontWeight="Bold" FontSize="16" Foreground="#F2F3F5" HorizontalAlignment="Center" />
                                    <TextBlock Text="Soyez le premier à poser une question ou lancer une discussion !" FontSize="13" Foreground="#949BA4" HorizontalAlignment="Center" />
                                </StackPanel>

                                <!-- Liste des Cartes de Publications (Forum Posts) -->
                                <ListView ItemsSource="{x:Bind ViewModel.FilteredForumPosts, Mode=OneWay}"
                                          SelectionMode="None" Padding="0">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:DiscordChannel">
                                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                    Background="#2B2D31" BorderBrush="#35373C" BorderThickness="1"
                                                    CornerRadius="10" Padding="16,14" Margin="0,0,0,10"
                                                    Tag="{x:Bind}" Click="OnForumPostCardClicked">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Détails du post : Titre, Tags, Auteur/Infos -->
                                                    <StackPanel Grid.Column="0" Spacing="8">
                                                        <TextBlock Text="{x:Bind DisplayName}" FontWeight="Bold" FontSize="15" Foreground="#F2F3F5"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="620" />

                                                        <!-- Tags appliqués sur le post -->
                                                        <ItemsControl ItemsSource="{x:Bind ResolvedTags, Mode=OneWay}"
                                                                      Visibility="{x:Bind HasResolvedTags, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:DiscordForumTag">
                                                                    <Border Background="#1E1F22" CornerRadius="10" Padding="8,3">
                                                                        <TextBlock Text="{x:Bind DisplayText}" FontSize="11" Foreground="#B5BAC1" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <!-- Badge messages & statut à droite -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                                        <Border Background="#1E1F22" CornerRadius="8" Padding="10,6">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <FontIcon Glyph="&#xE8BD;" FontSize="13" Foreground="#5865F2" />
                                                                <TextBlock Text="{x:Bind ThreadMessageCountText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#DBDEE1" />
                                                            </StackPanel>
                                                        </Border>
                                                        <FontIcon Glyph="&#xE76C;" FontSize="12" Foreground="#949BA4" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>

        <!-- Vue Complète du Profil (Full User Profile Modal) 100% fidèle à Discord (media_1792268309402_4ba614ad.png) -->
        <Grid x:Name="FullUserProfileOverlay" Visibility="Collapsed" Background="#B8000000" Canvas.ZIndex="880"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              PointerPressed="OnFullUserProfileBackdropPointerPressed">
            <Border Width="880" Height="620" CornerRadius="20"
                    BorderBrush="#35373C" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    PointerPressed="OnFullUserProfileModalContainerPointerPressed">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{x:Bind FullProfileUser.ProfilePrimaryColorHex, Mode=OneWay}" Offset="0.0" />
                        <GradientStop Color="{x:Bind FullProfileUser.ProfileSecondaryColorHex, Mode=OneWay}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <!-- Bouton Fermer (X) en haut à droite -->
                    <Button Width="36" Height="36" Padding="0" CornerRadius="18"
                            Background="{x:Bind FullProfileUser.ProfileCardInnerBackgroundColorHex, Mode=OneWay}"
                            BorderBrush="{x:Bind FullProfileUser.ProfileCardInnerBorderColorHex, Mode=OneWay}"
                            BorderThickness="1"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,16,16,0" Canvas.ZIndex="10"
                            Click="OnCloseFullUserProfileClicked" ToolTipService.ToolTip="Fermer (Échap)">
                        <FontIcon Glyph="&#xE8BB;" FontSize="14" Foreground="{x:Bind FullProfileUser.ProfileTextForegroundColorHex, Mode=OneWay}" />
                    </Button>

                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="330" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- COLONNE GAUCHE (Identité de l'utilisateur) -->
                        <Border Grid.Column="0" Background="{x:Bind FullProfileUser.ProfileCardInnerBackgroundColorHex, Mode=OneWay}"
                                BorderBrush="{x:Bind FullProfileUser.ProfileCardInnerBorderColorHex, Mode=OneWay}"
                                BorderThickness="1" CornerRadius="16" Padding="0" Margin="0,0,12,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="0">
                                    <!-- Bannière de profil avec coins arrondis -->
                                    <Grid Height="125">
                                        <Border CornerRadius="16,16,0,0"
                                                Background="{x:Bind FullProfileUser.BannerColorHex, Mode=OneWay}">
                                            <Border CornerRadius="16,16,0,0"
                                                    Visibility="{x:Bind FullProfileUser.HasBanner, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{x:Bind FullProfileUser.BannerUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                                Stretch="UniformToFill" AlignmentY="Center" AlignmentX="Center" />
                                                </Border.Background>
                                            </Border>
                                        </Border>

                                        <!-- Avatar rond avec bordure épaisse assortie (Cliquer pour zoomer en plein écran) -->
                                        <Button Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="45"
                                                Width="90" Height="90" Margin="16,74,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Click="OnZoomAvatarClicked" ToolTipService.ToolTip="Cliquer pour afficher la photo de profil en grand">
                                            <Ellipse Width="90" Height="90"
                                                     StrokeThickness="6" Stroke="{x:Bind FullProfileUser.ProfileAvatarCutoutStrokeColorHex, Mode=OneWay}">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{x:Bind FullProfileUser.AvatarUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Button>

                                        <!-- Pastille de statut sur l'avatar -->
                                        <Ellipse Width="22" Height="22" Margin="80,138,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                 Fill="{x:Bind FullProfileUser.StatusColor, Mode=OneWay}"
                                                 Stroke="{x:Bind FullProfileUser.ProfileAvatarCutoutStrokeColorHex, Mode=OneWay}" StrokeThickness="4" />

                                        <!-- Bulle de statut personnalisé (pensée) à droite de l'avatar -->
                                        <Border Margin="116,110,14,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Background="{x:Bind FullProfileUser.ProfileCardInnerBackgroundColorHex, Mode=OneWay}"
                                                BorderBrush="{x:Bind FullProfileUser.ProfileCardInnerBorderColorHex, Mode=OneWay}"
                                                BorderThickness="1" CornerRadius="16" Padding="12,6"
                                                Visibility="{x:Bind FullProfileUser.HasCustomStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{x:Bind FullProfileUser.CustomStatusText, Mode=OneWay}"
                                                       Foreground="{x:Bind FullProfileUser.ProfileTextForegroundColorHex, Mode=OneWay}" FontSize="12" FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                        </Border>
                                    </Grid>

                                    <!-- Informations sous la bannière -->
                                    <StackPanel Margin="16,46,16,16" Spacing="10">
                                        <!-- Nom d'affichage en très grand -->
                                        <TextBlock Text="{x:Bind FullProfileUser.DisplayName, Mode=OneWay}"
                                                   Foreground="{x:Bind FullProfileUser.ProfileTextForegroundColorHex, Mode=OneWay}"
                                                   FontWeight="Bold" FontSize="22" TextTrimming="CharacterEllipsis" />

                                        <!-- Username + Clan pill + Badges officiels -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind FullProfileUser.UserTag, Mode=OneWay}"
                                                       Foreground="{x:Bind FullProfileUser.ProfileSecondaryTextColorHex, Mode=OneWay}"
                                                       FontSize="13" VerticalAlignment="Center" />

                                            <!-- Tag Clan -->
                                            <Button Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="8"
                                                    Visibility="{x:Bind FullProfileUser.HasClan, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Tag="{x:Bind FullProfileUser}" Click="OnClanTagPillClicked"
                                                    ToolTipService.ToolTip="Afficher le profil du clan">
                                                <Border Background="{x:Bind FullProfileUser.ProfilePillBackgroundColorHex, Mode=OneWay}"
                                                        BorderBrush="{x:Bind FullProfileUser.ProfilePillBorderColorHex, Mode=OneWay}"
                                                        BorderThickness="1" CornerRadius="8" Padding="6,2" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <Image Width="12" Height="12" Source="{x:Bind FullProfileUser.ClanBadgeUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="Uniform" />
                                                        <TextBlock Text="{x:Bind FullProfileUser.ClanTag, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{x:Bind FullProfileUser.ProfileTextForegroundColorHex, Mode=OneWay}" />
                                                    </StackPanel>
                                                </Border>
                                            </Button>

                                            <!-- Badges -->
                                            <ItemsControl ItemsSource="{x:Bind FullProfileUser.Badges, Mode=OneWay}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:DiscordBadge">
                                                        <Image Width="16" Height="16" Source="{x:Bind IconUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                                               ToolTipService.ToolTip="{x:Bind Description}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Boutons d'action (Add Friend, Message, ...) -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,4">
                                            <!-- Si déjà ami : Bouton principal "Message" -->
                                            <Button Style="{StaticResource AccentButtonStyle}"
                                                    CornerRadius="8" Padding="14,6" Height="34"
                                                    Visibility="{x:Bind FullProfileUser.IsFriend, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Click="OnSendMessageFromProfileClicked">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE8BD;" FontSize="14" Foreground="White" />
                                                    <TextBlock Text="Message" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                                                </StackPanel>
                                            </Button>
                                            <Button Width="36" Height="34" Padding="0" CornerRadius="8"
                                                    Background="{x:Bind FullProfileUser.ProfileCardInnerBackgroundColorHex, Mode=OneWay}"
                                                    BorderBrush="{x:Bind FullProfileUser.ProfileCardInnerBorderColorHex, Mode=OneWay}"
                                                    BorderThickness="1"
                                                    Visibility="{x:Bind FullProfileUser.IsFriend, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    ToolTipService.ToolTip="Ami">
                                                <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#23A55A" />
                                            </Button>

                                            <!-- Si PAS encore ami : Bouton principal "Demande d'ami" -->
                                            <Button Style="{StaticResource AccentButtonStyle}"
                                                    CornerRadius="8" Padding="14,6" Height="34"
                                                    Visibility="{x:Bind FullProfileUser.IsFriend, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                                                    Click="OnAddFriendFromProfileClicked">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE8FA;" FontSize="14" Foreground="White" />
                                                    <TextBlock Text="Demande d'ami" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                                                </StackPanel>
                                            </Button>
                                            <Button Width="36" Height="34" Padding="0" CornerRadius="8"
                                                    Background="{x:Bind FullProfileUser.ProfileCardInnerBackgroundColorHex, Mode=OneWay}"
                                                    BorderBrush="{x:Bind FullProfileUser.ProfileCardInnerBorderColorHex, Mode=OneWay}"
                                                    BorderThickness="1"
                                                    Visibility="{x:Bind FullProfileUser.IsFriend, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                                                    Click="OnSendMessageFromProfileClicked" ToolTipService.ToolTip="Envoyer un message privé">
                                                <FontIcon Glyph="&#xE8BD;" FontSize="15" Foreground="{x:Bind FullProfileUser.ProfileTextForegroundColorHex, Mode=OneWay}" />
                                            </Button>

                                            <!-- Bouton Autres options ... -->
                                            <Button Width="36" Height="34" Padding="0" CornerRadius="8"
                                                    Background="{x:Bind FullProfileUser.ProfileCardInnerBackgroundColorHex, Mode=OneWay}"
                                                    BorderBrush="{x:Bind FullProfileUser.ProfileCardInnerBorderColorHex, Mode=OneWay}"
                                                    BorderThickness="1"
                                                    Click="OnProfileMoreActionsClicked" ToolTipService.ToolTip="Autres actions">
                                                <FontIcon Glyph="&#xE10C;" FontSize="15" Foreground="{x:Bind FullProfileUser.ProfileTextForegroundColorHex, Mode=OneWay}" />
                                            </Button>
                                        </StackPanel>

                                        <!-- Ligne de séparation -->
                                        <Border Height="1" Background="{x:Bind FullProfileUser.ProfileCardInnerBorderColorHex, Mode=OneWay}" Margin="0,4" />

                                        <!-- Bio / About Me -->
                                        <TextBlock Text="{x:Bind FullProfileUser.AboutMe, Mode=OneWay}"
                                                   Foreground="{x:Bind FullProfileUser.ProfileTextForegroundColorHex, Mode=OneWay}"
                                                   TextWrapping="Wrap" FontSize="13" Opacity="0.9" />

                                        <!-- Ligne de séparation -->
                                        <Border Height="1" Background="{x:Bind FullProfileUser.ProfileCardInnerBorderColorHex, Mode=OneWay}" Margin="0,4" />

                                        <!-- Section Member Since -->
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="MEMBRE DEPUIS" FontSize="11" FontWeight="Bold" Foreground="{x:Bind FullProfileUser.ProfileMutedTextColorHex, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind FullProfileUser.MemberSinceText, Mode=OneWay}" FontSize="13" FontWeight="Medium" Foreground="{x:Bind FullProfileUser.ProfileTextForegroundColorHex, Mode=OneWay}" />
                                        </StackPanel>

                                        <!-- Section Friends Since (si ami) -->
                                        <StackPanel Spacing="3" Margin="0,4,0,0" Visibility="{x:Bind FullProfileUser.HasFriendsSince, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="AMIS DEPUIS" FontSize="11" FontWeight="Bold" Foreground="{x:Bind FullProfileUser.ProfileMutedTextColorHex, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind FullProfileUser.FriendsSinceText, Mode=OneWay}" FontSize="13" FontWeight="Medium" Foreground="{x:Bind FullProfileUser.ProfileTextForegroundColorHex, Mode=OneWay}" />
                                        </StackPanel>

                                        <!-- Ligne de séparation -->
                                        <Border Height="1" Background="{x:Bind FullProfileUser.ProfileCardInnerBorderColorHex, Mode=OneWay}" Margin="0,4" />

                                        <!-- Section Note -->
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="NOTE (VISIBLE UNIQUEMENT PAR VOUS)" FontSize="11" FontWeight="Bold" Foreground="{x:Bind FullProfileUser.ProfileMutedTextColorHex, Mode=OneWay}" />
                                            <TextBox x:Name="ProfileUserNoteTextBox" PlaceholderText="Cliquez pour ajouter une note"
                                                     Background="{x:Bind FullProfileUser.ProfileInputBackgroundColorHex, Mode=OneWay}"
                                                     BorderBrush="{x:Bind FullProfileUser.ProfileInputBorderColorHex, Mode=OneWay}"
                                                     BorderThickness="1" CornerRadius="4" Padding="6,4" FontSize="12"
                                                     Foreground="{x:Bind FullProfileUser.ProfileTextForegroundColorHex, Mode=OneWay}"
                                                     LostFocus="OnProfileUserNoteLostFocus" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- COLONNE DROITE (Onglets : Activity, Wishlist, Mutual Friends, Mutual Servers) -->
                        <Grid Grid.Column="1" Margin="8,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Barre d'onglets façon Discord -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="4,0,0,12">
                                <!-- Onglet Activity -->
                                <StackPanel Spacing="4"
                                            Visibility="{x:Bind FullProfileUser.HasRecentActivities, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button x:Name="ProfileActivityTabButton" Content="Activity" Background="Transparent" BorderThickness="0" Padding="4,4"
                                            FontSize="14" FontWeight="SemiBold" Foreground="{x:Bind FullProfileUser.ProfileTextForegroundColorHex, Mode=OneWay}"
                                            Tag="Activity" Click="OnProfileTabClicked" />
                                    <Border x:Name="ProfileActivityTabIndicator" Height="2" Background="{x:Bind FullProfileUser.ProfileTextForegroundColorHex, Mode=OneWay}" CornerRadius="1" />
                                </StackPanel>

                                <!-- Onglet Wishlist -->
                                <StackPanel Spacing="4"
                                            Visibility="{x:Bind FullProfileUser.HasWishlist, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button x:Name="ProfileWishlistTabButton" Content="{x:Bind FullProfileUser.WishlistTabTitle, Mode=OneWay}" Background="Transparent" BorderThickness="0" Padding="4,4"
                                            FontSize="14" FontWeight="SemiBold" Foreground="{x:Bind FullProfileUser.ProfileTextForegroundColorHex, Mode=OneWay}" Opacity="0.75"
                                            Tag="Wishlist" Click="OnProfileTabClicked" />
                                    <Border x:Name="ProfileWishlistTabIndicator" Height="2" Background="{x:Bind FullProfileUser.ProfileTextForegroundColorHex, Mode=OneWay}" CornerRadius="1" Visibility="Collapsed" />
                                </StackPanel>

                                <!-- Onglet Amis en commun -->
                                <StackPanel Spacing="4"
                                            Visibility="{x:Bind FullProfileUser.HasMutualFriends, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button x:Name="ProfileMutualFriendsTabButton" Content="{x:Bind FullProfileUser.MutualFriendsTabTitle, Mode=OneWay}" Background="Transparent" BorderThickness="0" Padding="4,4"
                                            FontSize="14" FontWeight="SemiBold" Foreground="{x:Bind FullProfileUser.ProfileTextForegroundColorHex, Mode=OneWay}" Opacity="0.75"
                                            Tag="MutualFriends" Click="OnProfileTabClicked" />
                                    <Border x:Name="ProfileMutualFriendsTabIndicator" Height="2" Background="{x:Bind FullProfileUser.ProfileTextForegroundColorHex, Mode=OneWay}" CornerRadius="1" Visibility="Collapsed" />
                                </StackPanel>

                                <!-- Onglet Serveurs en commun -->
                                <StackPanel Spacing="4"
                                            Visibility="{x:Bind FullProfileUser.HasMutualGuilds, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button x:Name="ProfileMutualServersTabButton" Content="{x:Bind FullProfileUser.MutualServersTabTitle, Mode=OneWay}" Background="Transparent" BorderThickness="0" Padding="4,4"
                                            FontSize="14" FontWeight="SemiBold" Foreground="{x:Bind FullProfileUser.ProfileTextForegroundColorHex, Mode=OneWay}" Opacity="0.75"
                                            Tag="MutualServers" Click="OnProfileTabClicked" />
                                    <Border x:Name="ProfileMutualServersTabIndicator" Height="2" Background="{x:Bind FullProfileUser.ProfileTextForegroundColorHex, Mode=OneWay}" CornerRadius="1" Visibility="Collapsed" />
                                </StackPanel>
                            </StackPanel>

                            <!-- CONTENU DES ONGLETS -->
                            <Grid Grid.Row="1">
                                <!-- CONTENU ONGLET 1 : ACTIVITY -->
                                <ScrollViewer x:Name="ProfileActivityContent" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="10" Margin="0,0,6,0">
                                        <TextBlock Text="Recent activity" FontSize="12" FontWeight="SemiBold" Foreground="#949BA4" Margin="2,0,0,4" />

                                        <!-- Liste des activités récentes -->
                                        <ItemsControl ItemsSource="{x:Bind FullProfileUser.RecentActivities, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:DiscordActivity">
                                                    <Border Background="#2B2D31" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Icône de l'application / jeu -->
                                                            <Grid Grid.Column="0" Width="44" Height="44" Margin="0,0,12,0">
                                                                <Border CornerRadius="8" Background="#1E1F22">
                                                                    <Grid>
                                                                        <Border CornerRadius="8" Visibility="{x:Bind HasEffectiveIcon, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <Border.Background>
                                                                                <ImageBrush ImageSource="{x:Bind EffectiveIconUrl, Mode=OneTime, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                            </Border.Background>
                                                                        </Border>
                                                                        <FontIcon Glyph="&#xE7FC;" FontSize="20" Foreground="#B5BAC1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                  Visibility="{x:Bind HasEffectiveIcon, Mode=OneTime, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                                                                    </Grid>
                                                                </Border>
                                                            </Grid>

                                                            <!-- Infos du jeu : Nom + Sous-titre (Manette + Temps / Trending) -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                                <TextBlock Text="{x:Bind Name, Mode=OneTime}" FontSize="14" FontWeight="Bold" Foreground="#F2F3F5" TextTrimming="CharacterEllipsis" />
                                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                    <FontIcon Glyph="&#xE7FC;" FontSize="11" Foreground="#949BA4" />
                                                                    <TextBlock Text="{x:Bind RecentSubtitleLine, Mode=OneTime}" FontSize="12" Foreground="#949BA4" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <!-- Bouton ... (actions) -->
                                                            <Button Grid.Column="2" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                                                                <FontIcon Glyph="&#xE10C;" FontSize="13" Foreground="#949BA4" />
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Message si aucune activité récente -->
                                        <Border Background="#2B2D31" CornerRadius="10" Padding="28"
                                                Visibility="{x:Bind FullProfileUser.HasRecentActivities, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE7FC;" FontSize="32" Foreground="#949BA4" Opacity="0.5" HorizontalAlignment="Center" />
                                                <TextBlock Text="Aucune activité récente" FontSize="13" Foreground="#949BA4" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- CONTENU ONGLET 2 : WISHLIST -->
                                <ScrollViewer x:Name="ProfileWishlistContent" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                    <StackPanel Spacing="12" Margin="0,0,6,0">
                                        <Grid Margin="2,0,2,4">
                                            <TextBlock Text="Wishlist" FontSize="12" FontWeight="SemiBold" Foreground="#949BA4" VerticalAlignment="Center" />
                                            <Button HorizontalAlignment="Right" Background="#35373C" BorderThickness="0" CornerRadius="4" Padding="10,6"
                                                    Click="OnBrowseShopClicked">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE7BF;" FontSize="13" Foreground="#F2F3F5" />
                                                    <TextBlock Text="Browse the Shop" FontSize="12" FontWeight="SemiBold" Foreground="#F2F3F5" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <Border Background="#2B2D31" CornerRadius="10" Padding="28">
                                            <StackPanel Spacing="10" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE734;" FontSize="32" Foreground="#949BA4" Opacity="0.5" HorizontalAlignment="Center" />
                                                <TextBlock Text="Cette liste de souhaits est vide pour le moment" FontSize="13" Foreground="#949BA4" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- CONTENU ONGLET 3 : MUTUAL FRIENDS -->
                                <ScrollViewer x:Name="ProfileMutualFriendsContent" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                    <StackPanel Spacing="8" Margin="0,0,6,0">
                                        <ItemsControl ItemsSource="{x:Bind FullProfileUser.MutualFriends, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:DiscordUser">
                                                    <Button Background="Transparent" BorderThickness="0" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                            CornerRadius="8" Margin="0,0,0,4" Tag="{x:Bind}" Click="OnMutualFriendItemClicked">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Avatar avec badge de statut -->
                                                            <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0">
                                                                <Border Width="40" Height="40" CornerRadius="20">
                                                                    <Border.Background>
                                                                        <ImageBrush ImageSource="{x:Bind AvatarUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                    </Border.Background>
                                                                </Border>
                                                                <Ellipse Width="12" Height="12"
                                                                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                         Fill="{x:Bind StatusColor, Mode=OneWay}"
                                                                         Stroke="#232428" StrokeThickness="2" />
                                                            </Grid>

                                                            <!-- Pseudo, Tag de clan, et Activité -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="#F2F3F5" TextTrimming="CharacterEllipsis" />

                                                                    <!-- Badge de clan (façon Screenshots 1 et 2) -->
                                                                    <Border Background="#2B2D31" CornerRadius="4" Padding="4,1" VerticalAlignment="Center"
                                                                            Visibility="{x:Bind HasClan, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                            <Image Width="10" Height="10" Source="{x:Bind ClanBadgeUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="Uniform"
                                                                                   Visibility="{x:Bind HasClanBadge, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                            <TextBlock Text="{x:Bind ClanTag, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#DBDEE1" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </StackPanel>

                                                                <!-- Sous-titre Jeu : Manette + Nom du jeu (façon Screenshot 1 Melo na melo) -->
                                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                                                                            Visibility="{x:Bind HasGameActivity, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <FontIcon Glyph="&#xE7FC;" FontSize="11" Foreground="#949BA4" />
                                                                    <TextBlock Text="{x:Bind CurrentGameName, Mode=OneWay}" FontSize="12" Foreground="#949BA4" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>

                                                                <!-- Autre activité / statut personnalisé si pas de jeu -->
                                                                <TextBlock Text="{x:Bind ActivitySummaryText, Mode=OneWay}" FontSize="12" Foreground="#949BA4" TextTrimming="CharacterEllipsis"
                                                                           Visibility="{x:Bind HasNonGameActivitySummary, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- État vide -->
                                        <Border Background="#2B2D31" CornerRadius="10" Padding="28"
                                                Visibility="{x:Bind FullProfileUser.HasMutualFriends, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE716;" FontSize="32" Foreground="#949BA4" Opacity="0.5" HorizontalAlignment="Center" />
                                                <TextBlock Text="Aucun ami en commun" FontSize="13" Foreground="#949BA4" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- CONTENU ONGLET 4 : MUTUAL SERVERS -->
                                <ScrollViewer x:Name="ProfileMutualServersContent" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                    <StackPanel Spacing="8" Margin="0,0,6,0">
                                        <ItemsControl ItemsSource="{x:Bind FullProfileUser.MutualGuilds, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:DiscordMutualGuild">
                                                    <Button Background="Transparent" BorderThickness="0" Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                            CornerRadius="8" Margin="0,0,0,4" Tag="{x:Bind}" Click="OnMutualServerClicked">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Icône du serveur arrondi (squircle) avec fallback initiales -->
                                                            <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0">
                                                                <Border Width="40" Height="40" CornerRadius="12" Background="#2B2D31">
                                                                    <Grid>
                                                                        <Border CornerRadius="12" Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <Border.Background>
                                                                                <ImageBrush ImageSource="{x:Bind IconUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                            </Border.Background>
                                                                        </Border>
                                                                        <TextBlock Text="{x:Bind Initials, Mode=OneWay}" FontSize="13" FontWeight="Bold" Foreground="#DBDEE1"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                   Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                                                                    </Grid>
                                                                </Border>
                                                            </Grid>

                                                            <!-- Nom du serveur -->
                                                            <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="#F2F3F5"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- État vide -->
                                        <Border Background="#2B2D31" CornerRadius="10" Padding="28"
                                                Visibility="{x:Bind FullProfileUser.HasMutualGuilds, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE774;" FontSize="32" Foreground="#949BA4" Opacity="0.5" HorizontalAlignment="Center" />
                                                <TextBlock Text="Aucun serveur en commun" FontSize="13" Foreground="#949BA4" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Popout Carte de Clan / Tag de Serveur 100% fidèle à media_1792269408281_3c34b0fe.png -->
        <Grid x:Name="ClanTagPopoutOverlay" Visibility="Collapsed" Background="#33000000" Canvas.ZIndex="920"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              PointerPressed="OnClanTagOverlayBackdropPointerPressed">
            <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border x:Name="ClanTagPopoutCard" Width="344" CornerRadius="18"
                        Background="#232428" BorderBrush="#383A40" BorderThickness="1"
                        PointerPressed="OnClanTagCardPointerPressed">
                    <Grid>
                        <!-- 1. Bannière du serveur (124px de haut, coins arrondis en haut) -->
                        <Border Height="124" VerticalAlignment="Top" CornerRadius="17,17,0,0" Background="#111214">
                            <Grid>
                                <!-- Bannière image si disponible -->
                                <Border CornerRadius="17,17,0,0"
                                        Visibility="{x:Bind ViewModel.ActiveClanCard.HasBanner, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{x:Bind ViewModel.ActiveClanCard.BannerUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                    Stretch="UniformToFill" AlignmentY="Center" AlignmentX="Center" />
                                    </Border.Background>
                                </Border>
                                <!-- Dégradé d'ambiance si pas de bannière -->
                                <Border CornerRadius="17,17,0,0"
                                        Visibility="{x:Bind ViewModel.ActiveClanCard.HasBanner, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#1E3A5F" Offset="0.0" />
                                            <GradientStop Color="#0F172A" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 2. Icône du serveur (Squircle 76x76 qui chevauche la bannière avec bordure épaisse de découpe) -->
                        <Grid Width="76" Height="76" Margin="16,74,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Border Width="76" Height="76" CornerRadius="20" Background="#232428" />
                            <Border Width="70" Height="70" CornerRadius="18" Background="#111214"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid>
                                    <!-- Image de l'icône du serveur / badge de clan -->
                                    <Border CornerRadius="18"
                                            Visibility="{x:Bind ViewModel.ActiveClanCard.HasIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{x:Bind ViewModel.ActiveClanCard.IconUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <!-- Initiales si pas d'icône -->
                                    <TextBlock Text="{x:Bind ViewModel.ActiveClanCard.Tag, Mode=OneWay}"
                                               FontSize="20" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{x:Bind ViewModel.ActiveClanCard.HasIcon, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 3. Contenu du profil du clan/serveur sous la bannière -->
                        <StackPanel Margin="16,156,16,16" Spacing="10">
                            <!-- Nom du serveur + Badge Partenaire/Vérifié (fleur rose) + Tag de Clan -->
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.ActiveClanCard.GuildName, Mode=OneWay}"
                                               FontSize="18" FontWeight="Bold" Foreground="#F2F3F5"
                                               TextTrimming="CharacterEllipsis" MaxWidth="210" />

                                    <!-- Badge Fleur Rose Vérifié / Partenaire / Communauté (comme sur la capture) -->
                                    <Border Width="18" Height="18" CornerRadius="9" Background="#F47B67"
                                            VerticalAlignment="Center" ToolTipService.ToolTip="Communauté / Serveur vérifié"
                                            Visibility="{x:Bind ViewModel.ActiveClanCard.IsVerifiedOrPartner, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Pill Badge du Clan -->
                                    <Border Background="#111214" BorderBrush="#35373C" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Image Width="12" Height="12"
                                                   Source="{x:Bind ViewModel.ActiveClanCard.BadgeUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                   Stretch="Uniform" />
                                            <TextBlock Text="{x:Bind ViewModel.ActiveClanCard.Tag, Mode=OneWay}"
                                                       FontSize="11" FontWeight="Bold" Foreground="#F2F3F5" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Statistiques de membres (En ligne • Membres) -->
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                            Visibility="{x:Bind ViewModel.ActiveClanCard.HasMemberCount, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                                                Visibility="{x:Bind ViewModel.ActiveClanCard.HasOnlineCount, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Ellipse Width="8" Height="8" Fill="#23A55A" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ViewModel.ActiveClanCard.OnlineCountText, Mode=OneWay}"
                                                   FontSize="12" FontWeight="Medium" Foreground="#B5BAC1" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="#80848E" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ViewModel.ActiveClanCard.MemberCountText, Mode=OneWay}"
                                                   FontSize="12" FontWeight="Medium" Foreground="#B5BAC1" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Date de création (Est. Jan 2019) -->
                                <TextBlock Text="{x:Bind ViewModel.ActiveClanCard.EstablishedText, Mode=OneWay}"
                                           FontSize="12" FontWeight="Normal" Foreground="#949BA4"
                                           Visibility="{x:Bind ViewModel.ActiveClanCard.HasEstablished, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>

                            <!-- Description du serveur -->
                            <TextBlock Text="{x:Bind ViewModel.ActiveClanCard.Description, Mode=OneWay}"
                                       FontSize="12" Foreground="#DBDEE1" TextWrapping="Wrap" MaxLines="4"
                                       Visibility="{x:Bind ViewModel.ActiveClanCard.HasDescription, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <!-- Jeu ou activité associée (ex: Grand Theft Auto V Legacy) -->
                            <Border Visibility="{x:Bind ViewModel.ActiveClanCard.HasAssociatedGame, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="#111214" BorderBrush="#35373C" BorderThickness="1" CornerRadius="8" Padding="8,6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Image Width="22" Height="22"
                                           Source="{x:Bind ViewModel.ActiveClanCard.AssociatedGameIconUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                           Stretch="Uniform" />
                                    <TextBlock Text="{x:Bind ViewModel.ActiveClanCard.AssociatedGameName, Mode=OneWay}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#F2F3F5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Bouton Rejoindre (vert Discord #23A55A) -->
                            <Button HorizontalAlignment="Stretch" Height="40" CornerRadius="8"
                                    Background="#23A55A" Foreground="White" FontWeight="Bold" FontSize="13"
                                    Content="{x:Bind ViewModel.ActiveClanCard.ActionButtonText, Mode=OneWay}"
                                    Click="OnClanCardJoinClicked" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Canvas>

            <!-- VUE DÉCOUVERTE DE SERVEURS PUBLICS (SERVER DISCOVERY HUB) -->
            <Grid Grid.Column="1" Grid.ColumnSpan="2"
                  Visibility="{x:Bind ViewModel.DiscoveryViewVisibility, Mode=OneWay}"
                  Background="#313338" Canvas.ZIndex="100">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- En-tête / Bannière Héro de Découverte -->
                <Border Grid.Row="0" Background="#111214" Padding="32,24" BorderBrush="#1F2023" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Ligne de Titre + Bouton Fermer -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Width="36" Height="36" CornerRadius="18" Background="#23A55A">
                                        <FontIcon Glyph="&#xE774;" FontSize="18" Foreground="White" />
                                    </Border>
                                    <TextBlock Text="Découvrir des serveurs publics" FontSize="22" FontWeight="Bold" Foreground="#F2F3F5" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Trouvez des communautés qui partagent vos passions : jeux vidéo, musique, tech, création et plus encore."
                                           FontSize="13" Foreground="#949BA4" Margin="46,0,0,0" />
                            </StackPanel>

                            <Button Grid.Column="1" Width="36" Height="36" Padding="0" CornerRadius="18"
                                    Background="#2B2D31" BorderThickness="0"
                                    Click="OnCloseDiscoveryClicked" ToolTipService.ToolTip="Fermer la découverte (Échap)">
                                <FontIcon Glyph="&#xE8BB;" FontSize="14" Foreground="#DBDEE1" />
                            </Button>
                        </Grid>

                        <!-- Barre de Recherche stylée Discord -->
                        <Grid Grid.Row="1" Margin="0,18,0,14" MaxWidth="640" HorizontalAlignment="Left">
                            <TextBox x:Name="DiscoverySearchInput"
                                     PlaceholderText="Explorer des serveurs (ex: Minecraft, IA, Python...)"
                                     Text="{x:Bind ViewModel.DiscoverySearchQuery, Mode=TwoWay}"
                                     TextChanged="OnDiscoverySearchTextChanged"
                                     KeyDown="OnDiscoverySearchKeyDown"
                                     Height="42" Width="520" CornerRadius="8"
                                     Padding="36,8,12,8"
                                     Background="#1E1F22" Foreground="#F2F3F5" BorderBrush="#35373C" BorderThickness="1"
                                     FontSize="14" />
                            <FontIcon Glyph="&#xE721;" FontSize="15" Foreground="#949BA4"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
                        </Grid>

                        <!-- Pilules de Catégories ("Tous", "Gaming", "Musique", "Tech", "Éducation") -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                            <Button Content="Tous" Tag="Tous" Click="OnDiscoveryCategoryClicked"
                                    Padding="16,6" CornerRadius="16" FontSize="13" FontWeight="SemiBold"
                                    Background="{x:Bind ViewModel.CategoryTousBrush, Mode=OneWay}"
                                    Foreground="{x:Bind ViewModel.CategoryTousTextBrush, Mode=OneWay}"
                                    BorderThickness="0" />
                            <Button Content="Gaming" Tag="Gaming" Click="OnDiscoveryCategoryClicked"
                                    Padding="16,6" CornerRadius="16" FontSize="13" FontWeight="SemiBold"
                                    Background="{x:Bind ViewModel.CategoryGamingBrush, Mode=OneWay}"
                                    Foreground="{x:Bind ViewModel.CategoryGamingTextBrush, Mode=OneWay}"
                                    BorderThickness="0" />
                            <Button Content="Musique" Tag="Musique" Click="OnDiscoveryCategoryClicked"
                                    Padding="16,6" CornerRadius="16" FontSize="13" FontWeight="SemiBold"
                                    Background="{x:Bind ViewModel.CategoryMusiqueBrush, Mode=OneWay}"
                                    Foreground="{x:Bind ViewModel.CategoryMusiqueTextBrush, Mode=OneWay}"
                                    BorderThickness="0" />
                            <Button Content="Tech" Tag="Tech" Click="OnDiscoveryCategoryClicked"
                                    Padding="16,6" CornerRadius="16" FontSize="13" FontWeight="SemiBold"
                                    Background="{x:Bind ViewModel.CategoryTechBrush, Mode=OneWay}"
                                    Foreground="{x:Bind ViewModel.CategoryTechTextBrush, Mode=OneWay}"
                                    BorderThickness="0" />
                            <Button Content="Éducation" Tag="Éducation" Click="OnDiscoveryCategoryClicked"
                                    Padding="16,6" CornerRadius="16" FontSize="13" FontWeight="SemiBold"
                                    Background="{x:Bind ViewModel.CategoryEducationBrush, Mode=OneWay}"
                                    Foreground="{x:Bind ViewModel.CategoryEducationTextBrush, Mode=OneWay}"
                                    BorderThickness="0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Zone de Défilement avec Cartes de Serveurs -->
                <ScrollViewer Grid.Row="1" Padding="32,20">
                    <StackPanel Spacing="16">
                        <!-- En-tête des résultats & Indicateur de chargement -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="{x:Bind ViewModel.DiscoveryResultsCountText, Mode=OneWay}"
                                       FontSize="14" FontWeight="SemiBold" Foreground="#DBDEE1" VerticalAlignment="Center" />
                            <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingDiscovery, Mode=OneWay}"
                                          Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Message si aucun serveur trouvé -->
                        <StackPanel Visibility="{x:Bind ViewModel.HasFilteredDiscoverableGuilds, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0" Spacing="12">
                            <FontIcon Glyph="&#xE721;" FontSize="40" Foreground="#4E5058" HorizontalAlignment="Center" />
                            <TextBlock Text="Aucun serveur public trouvé" FontSize="16" FontWeight="Bold" Foreground="#DBDEE1" HorizontalAlignment="Center" />
                            <TextBlock Text="Essayez un autre mot-clé ou sélectionnez une autre catégorie." FontSize="13" Foreground="#949BA4" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Grille de Cartes de Serveurs Publics -->
                        <GridView ItemsSource="{x:Bind ViewModel.FilteredDiscoverableGuilds, Mode=OneWay}"
                                  SelectionMode="None"
                                  Visibility="{x:Bind ViewModel.HasFilteredDiscoverableGuilds, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Margin" Value="0,0,16,16" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:DiscordDiscoverableGuild">
                                    <Border Width="280" Height="340" Background="#2B2D31" BorderBrush="#1E1F22" BorderThickness="1" CornerRadius="12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="120" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <!-- Bannière en haut -->
                                            <Border Grid.Row="0" CornerRadius="12,12,0,0">
                                                <Grid>
                                                    <!-- Bannière si disponible -->
                                                    <Border CornerRadius="12,12,0,0"
                                                            Visibility="{x:Bind HasBanner, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{x:Bind BannerUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                        </Border.Background>
                                                    </Border>
                                                    <!-- Fond dégradé subtil si aucune bannière -->
                                                    <Border CornerRadius="12,12,0,0"
                                                            Visibility="{x:Bind HasBanner, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#5865F2" Offset="0" />
                                                                <GradientStop Color="#23A55A" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Icône de serveur flottante chevauchant la bannière -->
                                            <Border Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                    Margin="16,0,0,-24" Width="48" Height="48" CornerRadius="16"
                                                    BorderBrush="#2B2D31" BorderThickness="3" Background="#1E1F22" Canvas.ZIndex="10">
                                                <Grid>
                                                    <!-- Image de l'icône si présente -->
                                                    <Border CornerRadius="13" Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{x:Bind IconUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                        </Border.Background>
                                                    </Border>
                                                    <!-- Initiales si pas d'icône -->
                                                    <TextBlock Text="{x:Bind Initials}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               FontWeight="Bold" FontSize="14" Foreground="White"
                                                               Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                                                </Grid>
                                            </Border>

                                            <!-- Corps de la carte -->
                                            <Grid Grid.Row="1" Margin="16,28,16,14">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

