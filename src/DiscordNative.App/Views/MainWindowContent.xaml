                                <ComboBoxItem Content="4 heures" Tag="4h" />
                                <ComboBoxItem Content="1 heure" Tag="1h" />
                                <ComboBoxItem Content="30 minutes" Tag="30m" />
                                <ComboBoxItem Content="Ne pas effacer" Tag="never" />
