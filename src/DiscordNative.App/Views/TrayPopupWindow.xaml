<Window
    x:Class="DiscordNative.App.Views.TrayPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Diswin">

    <Border x:Name="RootBorder"
            Background="#1E1F22"
            BorderBrush="Transparent"
            BorderThickness="0"
            CornerRadius="10"
            Padding="8"
            RequestedTheme="Dark">
        <StackPanel x:Name="MainStackPanel" Spacing="2">
            <!-- 1. En-tête Utilisateur épuré (sans aucun badge technique) -->
            <Border Background="#2B2D31" CornerRadius="8" Padding="10,8" Margin="0,0,0,4">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="34" Height="34">
                        <Ellipse Fill="#5865F2"/>
                        <PersonPicture x:Name="UserAvatar" Width="34" Height="34"/>
                        <Ellipse x:Name="StatusDot" Width="10" Height="10"
                                 Fill="#23A55A" Stroke="#2B2D31" StrokeThickness="2"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock x:Name="UserDisplayNameText" Text="Diswin" FontSize="13" FontWeight="Bold" Foreground="#F2F3F5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="UserStatusText" Text="En ligne" FontSize="11" Foreground="#949BA4" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Actions Principales -->
            <Button Click="OnOpenDiswinClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0" Padding="10,6" CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE8A7;" FontSize="13" Foreground="#5865F2"/>
                    <TextBlock Text="Ouvrir Diswin" FontSize="12.5" FontWeight="SemiBold" Foreground="#F2F3F5"/>
                </StackPanel>
            </Button>

            <Button Click="OnQuickSwitcherClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0" Padding="10,6" CornerRadius="6">
                <Grid Width="220">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE721;" FontSize="13" Foreground="#B5BAC1"/>
                        <TextBlock Text="Recherche rapide" FontSize="12.5" Foreground="#DBDEE1"/>
                    </StackPanel>
                    <TextBlock Text="Ctrl+K" FontSize="10.5" Foreground="#80848E" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <Rectangle Height="1" Fill="#2B2D31" Margin="4,2"/>

            <!-- 3. Sélecteur de Statut Rapide -->
            <Grid ColumnSpacing="4" Margin="2,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Tag="online" Click="OnStatusClicked" ToolTipService.ToolTip="En ligne"
                        HorizontalAlignment="Stretch" Background="#2B2D31" BorderThickness="0" Padding="0,5" CornerRadius="6">
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <Ellipse Width="9" Height="9" Fill="#23A55A" HorizontalAlignment="Center"/>
                        <TextBlock Text="En ligne" FontSize="9.5" Foreground="#DBDEE1"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Tag="idle" Click="OnStatusClicked" ToolTipService.ToolTip="Inactif"
                        HorizontalAlignment="Stretch" Background="#2B2D31" BorderThickness="0" Padding="0,5" CornerRadius="6">
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <Ellipse Width="9" Height="9" Fill="#F0B232" HorizontalAlignment="Center"/>
                        <TextBlock Text="Inactif" FontSize="9.5" Foreground="#DBDEE1"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Tag="dnd" Click="OnStatusClicked" ToolTipService.ToolTip="Ne pas déranger"
                        HorizontalAlignment="Stretch" Background="#2B2D31" BorderThickness="0" Padding="0,5" CornerRadius="6">
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <Ellipse Width="9" Height="9" Fill="#F23F43" HorizontalAlignment="Center"/>
                        <TextBlock Text="Occupé" FontSize="9.5" Foreground="#DBDEE1"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Tag="invisible" Click="OnStatusClicked" ToolTipService.ToolTip="Invisible"
                        HorizontalAlignment="Stretch" Background="#2B2D31" BorderThickness="0" Padding="0,5" CornerRadius="6">
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <Ellipse Width="9" Height="9" Fill="#80848E" HorizontalAlignment="Center"/>
                        <TextBlock Text="Invisible" FontSize="9.5" Foreground="#DBDEE1"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Rectangle Height="1" Fill="#2B2D31" Margin="4,2"/>

            <!-- 4. Contrôles Audio Rapides -->
            <Button Click="OnToggleMuteClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0" Padding="10,6" CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon x:Name="MuteIcon" Glyph="&#xE720;" FontSize="13" Foreground="#B5BAC1"/>
                    <TextBlock x:Name="MuteMenuText" Text="Couper le micro" FontSize="12.5" Foreground="#DBDEE1"/>
                </StackPanel>
            </Button>

            <Button Click="OnToggleDeafenClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0" Padding="10,6" CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon x:Name="DeafenIcon" Glyph="&#xE7F6;" FontSize="13" Foreground="#B5BAC1"/>
                    <TextBlock x:Name="DeafenMenuText" Text="Mettre en sourdine (Casque)" FontSize="12.5" Foreground="#DBDEE1"/>
                </StackPanel>
            </Button>

            <Button x:Name="DisconnectVoiceButton" Click="OnDisconnectVoiceClicked" Visibility="Collapsed"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0" Padding="10,6" CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE778;" FontSize="13" Foreground="#F23F43"/>
                    <TextBlock Text="Déconnecter du salon vocal" FontSize="12.5" Foreground="#F23F43"/>
                </StackPanel>
            </Button>

            <Rectangle Height="1" Fill="#2B2D31" Margin="4,2"/>

            <!-- 5. Mises à jour & Paramètres -->
            <Button Click="OnCheckUpdatesClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0" Padding="10,6" CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE895;" FontSize="13" Foreground="#B5BAC1"/>
                    <TextBlock Text="Vérifier les mises à jour..." FontSize="12.5" Foreground="#DBDEE1"/>
                </StackPanel>
            </Button>

            <Button Click="OnOpenSettingsClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0" Padding="10,6" CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE713;" FontSize="13" Foreground="#B5BAC1"/>
                    <TextBlock Text="Paramètres..." FontSize="12.5" Foreground="#DBDEE1"/>
                </StackPanel>
            </Button>

            <Rectangle Height="1" Fill="#2B2D31" Margin="4,2"/>

            <!-- 6. QUITTER DISWIN (Garantie 100% visible, bouton rouge bien dégagé) -->
            <Button Click="OnQuitDiswinClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="#20F23F43" BorderThickness="0" Padding="10,7" CornerRadius="6" Margin="0,2,0,2">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE7E8;" FontSize="13" Foreground="#F23F43"/>
                    <TextBlock Text="Quitter Diswin" FontSize="12.5" FontWeight="SemiBold" Foreground="#F23F43"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
