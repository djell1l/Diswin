<Window
    x:Class="DiscordNative.App.Views.TrayPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Menu Diswin">

    <Border Background="#1E1F22"
            BorderBrush="#313338"
            BorderThickness="1"
            CornerRadius="12"
            Padding="10"
            RequestedTheme="Dark">
        <StackPanel Spacing="4">
            <!-- En-tête Utilisateur -->
            <Border Background="#2B2D31" CornerRadius="8" Padding="10,8" Margin="0,0,0,4">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="34" Height="34">
                        <Ellipse Fill="#5865F2"/>
                        <PersonPicture x:Name="UserAvatar" Width="34" Height="34"/>
                        <Ellipse x:Name="StatusDot" Width="11" Height="11"
                                 Fill="#23A55A" Stroke="#2B2D31" StrokeThickness="2"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock x:Name="UserDisplayNameText" Text="Diswin" FontSize="13" FontWeight="SemiBold" Foreground="#F2F3F5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="UserStatusText" Text="En ligne" FontSize="11" Foreground="#949BA4" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="#205865F2" BorderBrush="#405865F2" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="WinUI 3" FontSize="10" FontWeight="SemiBold" Foreground="#949CF7"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Action Principale : Ouvrir / Restaurer -->
            <Button Click="OnOpenDiswinClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0" Padding="10,7" CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE8A7;" FontSize="14" Foreground="#5865F2"/>
                    <TextBlock Text="Ouvrir Diswin" FontSize="13" FontWeight="SemiBold" Foreground="#F2F3F5"/>
                </StackPanel>
            </Button>

            <Button Click="OnQuickSwitcherClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0" Padding="10,7" CornerRadius="6">
                <Grid Width="232">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="#B5BAC1"/>
                        <TextBlock Text="Recherche rapide" FontSize="13" Foreground="#DBDEE1"/>
                    </StackPanel>
                    <TextBlock Text="Ctrl+K" FontSize="11" Foreground="#80848E" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <Rectangle Height="1" Fill="#2B2D31" Margin="4,3"/>

            <!-- Sélecteur de Statut Rapide -->
            <TextBlock Text="STATUT EN LIGNE" FontSize="10" FontWeight="Bold" Foreground="#80848E" Margin="10,2,0,2"/>
            <Grid ColumnSpacing="4" Margin="4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Tag="online" Click="OnStatusClicked" ToolTipService.ToolTip="En ligne"
                        HorizontalAlignment="Stretch" Background="#2B2D31" BorderThickness="0" Padding="0,6" CornerRadius="6">
                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="#23A55A" HorizontalAlignment="Center"/>
                        <TextBlock Text="En ligne" FontSize="10" Foreground="#DBDEE1"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Tag="idle" Click="OnStatusClicked" ToolTipService.ToolTip="Inactif"
                        HorizontalAlignment="Stretch" Background="#2B2D31" BorderThickness="0" Padding="0,6" CornerRadius="6">
                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="#F0B232" HorizontalAlignment="Center"/>
                        <TextBlock Text="Inactif" FontSize="10" Foreground="#DBDEE1"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Tag="dnd" Click="OnStatusClicked" ToolTipService.ToolTip="Ne pas déranger"
                        HorizontalAlignment="Stretch" Background="#2B2D31" BorderThickness="0" Padding="0,6" CornerRadius="6">
                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="#F23F43" HorizontalAlignment="Center"/>
                        <TextBlock Text="Occupé" FontSize="10" Foreground="#DBDEE1"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Tag="invisible" Click="OnStatusClicked" ToolTipService.ToolTip="Invisible"
                        HorizontalAlignment="Stretch" Background="#2B2D31" BorderThickness="0" Padding="0,6" CornerRadius="6">
                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="#80848E" HorizontalAlignment="Center"/>
                        <TextBlock Text="Invisible" FontSize="10" Foreground="#DBDEE1"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Rectangle Height="1" Fill="#2B2D31" Margin="4,3"/>

            <!-- Contrôles Vocaux Rapides -->
            <Button Click="OnToggleMuteClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0" Padding="10,7" CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon x:Name="MuteIcon" Glyph="&#xE720;" FontSize="14" Foreground="#B5BAC1"/>
                    <TextBlock x:Name="MuteMenuText" Text="Couper / Activer le micro" FontSize="13" Foreground="#DBDEE1"/>
                </StackPanel>
            </Button>

            <Button Click="OnToggleDeafenClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0" Padding="10,7" CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon x:Name="DeafenIcon" Glyph="&#xE7F6;" FontSize="14" Foreground="#B5BAC1"/>
                    <TextBlock x:Name="DeafenMenuText" Text="Mettre en sourdine (Casque)" FontSize="13" Foreground="#DBDEE1"/>
                </StackPanel>
            </Button>

            <Button x:Name="DisconnectVoiceButton" Click="OnDisconnectVoiceClicked" Visibility="Collapsed"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0" Padding="10,7" CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE778;" FontSize="14" Foreground="#F23F43"/>
                    <TextBlock Text="Déconnecter du salon vocal" FontSize="13" Foreground="#F23F43"/>
                </StackPanel>
            </Button>

            <Rectangle Height="1" Fill="#2B2D31" Margin="4,3"/>

            <!-- Paramètres & Quitter -->
            <Button Click="OnOpenSettingsClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0" Padding="10,7" CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="#B5BAC1"/>
                    <TextBlock Text="Paramètres de Diswin..." FontSize="13" Foreground="#DBDEE1"/>
                </StackPanel>
            </Button>

            <Button Click="OnQuitDiswinClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="#18F23F43" BorderThickness="0" Padding="10,8" CornerRadius="6" Margin="0,2,0,0">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE7E8;" FontSize="14" Foreground="#F23F43"/>
                    <TextBlock Text="Quitter Diswin" FontSize="13" FontWeight="SemiBold" Foreground="#F23F43"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
