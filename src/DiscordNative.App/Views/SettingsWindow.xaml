<Window
    x:Class="DiscordNative.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="AppTitleBar" Background="Transparent" Padding="14,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE713;" FontSize="13" Foreground="#5865F2" />
                <TextBlock Text="Diswin — Paramètres Utilisateur (WinUI 3)" FontSize="12" FontWeight="SemiBold" Opacity="0.85" />
            </StackPanel>
        </Grid>

        <NavigationView Grid.Row="1"
                        x:Name="SettingsNavView"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="240"
                        SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="PARAMÈTRES DE L'APPLI" />
                <NavigationViewItem Content="Apparence &amp; Thème" Tag="Appearance" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Profils &amp; Bannières" Tag="Profiles">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Voix &amp; Audio (Krisp)" Tag="Voice">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE720;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Messagerie &amp; Notifications" Tag="Messaging">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8BD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Raccourcis Clavier" Tag="Keybinds">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE765;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItemHeader Content="SYSTÈME &amp; COMPTE" />
                <NavigationViewItem Content="Mises à jour &amp; Journaux" Tag="Updates">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Compte &amp; Session" Tag="Account">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <ScrollViewer Padding="28,20,28,32">
                <StackPanel Spacing="24" MaxWidth="720" HorizontalAlignment="Left">

                    <!-- SECTION : Apparence & Fond d'écran -->
                    <StackPanel x:Name="AppearanceSection" Spacing="20">
                        <TextBlock Text="Apparence &amp; Interface" FontSize="24" FontWeight="SemiBold" />

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel Spacing="14">
                                <ComboBox x:Name="ThemeCombo" Header="Thème de l'application"
                                          SelectionChanged="OnThemeChanged" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Système (Par défaut Windows)" Tag="Default" />
                                    <ComboBoxItem Content="Clair" Tag="Light" />
                                    <ComboBoxItem Content="Sombre" Tag="Dark" />
                                </ComboBox>

                                <ComboBox x:Name="LanguageCombo" Header="Langue de l'application"
                                          SelectionChanged="OnLanguageChanged" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Système (Par défaut Windows)" Tag="Default" />
                                    <ComboBoxItem Content="Français (France)" Tag="fr-FR" />
                                    <ComboBoxItem Content="English (US)" Tag="en-US" />
                                    <ComboBoxItem Content="Deutsch (Allemand)" Tag="de-DE" />
                                    <ComboBoxItem Content="Español (Espagnol)" Tag="es-ES" />
                                    <ComboBoxItem Content="Italiano (Italien)" Tag="it-IT" />
                                    <ComboBoxItem Content="日本語 (Japonais)" Tag="ja-JP" />
                                    <ComboBoxItem Content="Português (Brésil)" Tag="pt-BR" />
                                    <ComboBoxItem Content="Русский (Russe)" Tag="ru-RU" />
                                </ComboBox>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Échelle de l'interface (85% — 125%)" />
                                    <Slider x:Name="ScaleSlider" Minimum="0.85" Maximum="1.25" StepFrequency="0.05"
                                            ValueChanged="OnScaleChanged" />
                                </StackPanel>

                                <ToggleSwitch x:Name="BubbleStyleToggle" Header="Style de messages en bulles (façon SakuraCord)"
                                              Toggled="OnBubbleStyleToggled" />

                                <ToggleSwitch x:Name="CompactModeToggle" Header="Mode compact"
                                              Toggled="OnCompactModeToggled" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Fond d'écran personnalisé (Mica / Files)" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Choisissez une image qui s'affichera derrière l'interface WinUI 3, comme dans Files."
                                           Opacity="0.7" TextWrapping="Wrap" />

                                <Border Height="160" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Image x:Name="BackgroundPreview" Stretch="UniformToFill" />
                                </Border>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Choisir une image..." Click="OnChooseBackgroundClicked" />
                                    <Button Content="Réinitialiser" Click="OnResetBackgroundClicked" />
                                </StackPanel>

                                <TextBlock Text="Opacité du voile" />
                                <Slider x:Name="OpacitySlider" Minimum="0" Maximum="1" StepFrequency="0.05"
                                        ValueChanged="OnOpacityChanged" />

                                <TextBlock Text="Flou" />
                                <Slider x:Name="BlurSlider" Minimum="0" Maximum="40" StepFrequency="1"
                                        ValueChanged="OnBlurChanged" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- SECTION : Profils & Bannières -->
                    <StackPanel x:Name="ProfilesSection" Spacing="20" Visibility="Collapsed">
                        <TextBlock Text="Profils utilisateur &amp; Thèmes" FontSize="24" FontWeight="SemiBold" />

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE77B;" FontSize="18" Foreground="#5865F2" VerticalAlignment="Center" />
                                    <TextBlock Text="Restitution des Cartes de Profil Discord" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Configurez la restitution visuelle des bannières et des fiches de profil Discord."
                                           Opacity="0.75" TextWrapping="Wrap" FontSize="13" />

                                <ToggleSwitch x:Name="ForceAccentColorOnProfilesToggle"
                                              Header="Étendre la couleur de bannière à toute la carte de profil (Sans Nitro)"
                                              OnContent="Activé (Coloration complète de la carte)"
                                              OffContent="Désactivé (Standard Discord : bannière uniquement, corps Mica sombre)"
                                              Toggled="OnForceAccentColorOnProfilesToggled" />
                                <TextBlock Text="Par défaut sur Discord, la couleur personnalisée couvre uniquement la bannière pour les profils classiques, et le corps de la carte reste en surface Mica sombre. Activez cette option pour étendre la couleur à l'ensemble de la fiche."
                                           Opacity="0.6" TextWrapping="Wrap" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- SECTION : Voix & Audio (Krisp) -->
                    <StackPanel x:Name="VoiceSection" Spacing="20" Visibility="Collapsed">
                        <TextBlock Text="Voix &amp; Audio (Krisp)" FontSize="24" FontWeight="SemiBold" />

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel Spacing="14">
                                <Grid ColumnSpacing="16" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Column="0" Grid.Row="0" Spacing="4">
                                        <TextBlock Text="PÉRIPHÉRIQUE D'ENTRÉE" FontSize="11" FontWeight="Bold" Opacity="0.7" />
                                        <ComboBox x:Name="InputDeviceCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
                                            <ComboBoxItem Content="Par défaut (Microphone système)" Tag="default" />
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Grid.Row="0" Spacing="4">
                                        <TextBlock Text="PÉRIPHÉRIQUE DE SORTIE" FontSize="11" FontWeight="Bold" Opacity="0.7" />
                                        <ComboBox x:Name="OutputDeviceCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
                                            <ComboBoxItem Content="Par défaut (Casque / Haut-parleurs)" Tag="default" />
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="0" Grid.Row="1" Spacing="4">
                                        <Grid>
                                            <TextBlock Text="VOLUME D'ENTRÉE" FontSize="11" FontWeight="Bold" Opacity="0.7" />
                                            <TextBlock x:Name="InputVolumeLabel" Text="100%" FontSize="11" HorizontalAlignment="Right" Opacity="0.7" />
                                        </Grid>
                                        <Slider x:Name="InputVolumeSlider" Minimum="0" Maximum="100" Value="100" StepFrequency="1"
                                                ValueChanged="OnInputVolumeChanged" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Grid.Row="1" Spacing="4">
                                        <Grid>
                                            <TextBlock Text="VOLUME DE SORTIE" FontSize="11" FontWeight="Bold" Opacity="0.7" />
                                            <TextBlock x:Name="OutputVolumeLabel" Text="100%" FontSize="11" HorizontalAlignment="Right" Opacity="0.7" />
                                        </Grid>
                                        <Slider x:Name="OutputVolumeSlider" Minimum="0" Maximum="200" Value="100" StepFrequency="1"
                                                ValueChanged="OnOutputVolumeChanged" />
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,4" />

                                <StackPanel Spacing="6">
                                    <TextBlock Text="MODE D'ENTRÉE" FontSize="11" FontWeight="Bold" Opacity="0.7" />
                                    <ComboBox x:Name="InputModeCombo" HorizontalAlignment="Stretch" SelectionChanged="OnInputModeChanged">
                                        <ComboBoxItem Content="Détection de la voix (VAD automatique)" Tag="VoiceActivity" />
                                        <ComboBoxItem Content="Appuyer pour parler (Push-To-Talk)" Tag="PushToTalk" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel x:Name="VoiceSensitivityPanel" Spacing="6">
                                    <ToggleSwitch x:Name="AutoSensitivityToggle"
                                                  Header="Déterminer automatiquement la sensibilité d'entrée"
                                                  Toggled="OnAutoSensitivityToggled" />
                                    <StackPanel x:Name="ManualSensitivitySliderPanel" Spacing="4" Visibility="Collapsed">
                                        <Grid>
                                            <TextBlock Text="SEUIL DE SENSIBILITÉ DU MICRO" FontSize="11" FontWeight="Bold" Opacity="0.7" />
                                            <TextBlock x:Name="SensitivityLabel" Text="-50 dB" FontSize="11" HorizontalAlignment="Right" Opacity="0.7" />
                                        </Grid>
                                        <Slider x:Name="SensitivitySlider" Minimum="0" Maximum="100" Value="50" StepFrequency="1"
                                                ValueChanged="OnSensitivityChanged" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,4" />

                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE9F5;" FontSize="16" Foreground="#23A55A" VerticalAlignment="Center" />
                                        <TextBlock Text="Suppression de bruit Krisp (Neural Noise Cancellation)" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Border Background="#23A55A" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="100% GRATUIT" FontSize="9" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="Supprime les bruits de fond (clavier, ventilateur, souffle) en temps réel dans vos appels vocaux en utilisant directement le moteur neuronal officiel Krisp de Discord."
                                               Opacity="0.75" TextWrapping="Wrap" FontSize="12" />

                                    <ToggleSwitch x:Name="KrispToggle"
                                                  OnContent="Activé"
                                                  OffContent="Désactivé"
                                                  Toggled="OnKrispToggled" />

                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon x:Name="KrispEngineStatusIcon" Glyph="&#xE73E;" FontSize="12" Foreground="#23A55A" VerticalAlignment="Center" Visibility="Collapsed" />
                                        <TextBlock x:Name="KrispEngineStatusText" FontSize="12" Foreground="#23A55A" FontWeight="SemiBold" Opacity="0.9" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,4" />

                                <StackPanel Spacing="8">
                                    <TextBlock Text="TRAITEMENT AUDIO AVANCÉ" FontSize="11" FontWeight="Bold" Opacity="0.7" />
                                    <ToggleSwitch x:Name="EchoCancellationToggle"
                                                  Header="Annulation de l'écho"
                                                  Toggled="OnEchoCancellationToggled" />
                                    <ToggleSwitch x:Name="AdvancedNoiseReductionToggle"
                                                  Header="Réduction du bruit avancée"
                                                  Toggled="OnAdvancedNoiseReductionToggled" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- SECTION : Messagerie, Barre des tâches & Confidentialité -->
                    <StackPanel x:Name="MessagingSection" Spacing="20" Visibility="Collapsed">
                        <TextBlock Text="Messagerie, Notifications &amp; Barre système" FontSize="24" FontWeight="SemiBold" />

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel Spacing="14">
                                <ToggleSwitch x:Name="MinimizeToTrayToggle"
                                              Header="Minimiser dans la zone de notification (System Tray) lors de la fermeture (X)"
                                              OnContent="Minimiser dans la barre des tâches"
                                              OffContent="Fermer complètement Diswin"
                                              Toggled="OnMinimizeToTrayToggled" />

                                <ToggleSwitch x:Name="ShowNotificationsToggle"
                                              Header="Afficher les notifications de bureau pour les mentions et messages privés"
                                              Toggled="OnShowNotificationsToggled" />

                                <ToggleSwitch x:Name="AnonymizeUploadsToggle"
                                              Header="Anonymiser automatiquement le nom des fichiers et images envoyés"
                                              Toggled="OnAnonymizeUploadsToggled" />

                                <ToggleSwitch x:Name="ConvertLongMessagesToggle"
                                              Header="Convertir automatiquement les messages &gt; 4000 caractères en fichier message.txt"
                                              Toggled="OnConvertLongMessagesToggled" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- SECTION : Raccourcis Clavier -->
                    <StackPanel x:Name="KeybindsSection" Spacing="20" Visibility="Collapsed">
                        <TextBlock Text="Raccourcis Clavier Natifs" FontSize="24" FontWeight="SemiBold" />

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel Spacing="12">
                                <Grid Padding="8,6" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="6">
                                    <TextBlock Text="Recherche rapide (Serveurs, Salons, MP, Amis)" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <Border Background="#2B2D31" CornerRadius="4" Padding="8,4" HorizontalAlignment="Right">
                                        <TextBlock Text="Ctrl + K" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#F2F3F5" />
                                    </Border>
                                </Grid>
                                <Grid Padding="8,6" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="6">
                                    <TextBlock Text="Rechercher dans le salon actuel" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <Border Background="#2B2D31" CornerRadius="4" Padding="8,4" HorizontalAlignment="Right">
                                        <TextBlock Text="Ctrl + F" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#F2F3F5" />
                                    </Border>
                                </Grid>
                                <Grid Padding="8,6" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="6">
                                    <TextBlock Text="Modifier votre dernier message envoyé" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <Border Background="#2B2D31" CornerRadius="4" Padding="8,4" HorizontalAlignment="Right">
                                        <TextBlock Text="Flèche Haut (↑)" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#F2F3F5" />
                                    </Border>
                                </Grid>
                                <Grid Padding="8,6" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="6">
                                    <TextBlock Text="Fermer la fenêtre modale / Annuler la réponse" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <Border Background="#2B2D31" CornerRadius="4" Padding="8,4" HorizontalAlignment="Right">
                                        <TextBlock Text="Échap (Esc)" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#F2F3F5" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- SECTION : Mises à jour & Journaux -->
                    <StackPanel x:Name="UpdatesSection" Spacing="20" Visibility="Collapsed">
                        <TextBlock Text="Mises à jour &amp; Journaux de Diagnostic" FontSize="24" FontWeight="SemiBold" />

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel Spacing="14">
                                <ComboBox x:Name="UpdateChannelCombo" Header="Canal de mise à jour"
                                          SelectionChanged="OnUpdateChannelChanged" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Stable (Recommandé - Versions stables et testées)" Tag="Stable" />
                                    <ComboBoxItem Content="Edge (Pré-versions - Nouveautés et révisions rapides)" Tag="Edge" />
                                </ComboBox>

                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Button x:Name="CheckUpdatesButton" Content="Vérifier les mises à jour" Style="{StaticResource AccentButtonStyle}" Click="OnCheckUpdatesClicked" />
                                    <TextBlock x:Name="UpdateCheckStatusText" FontSize="12" Opacity="0.8" VerticalAlignment="Center" />
                                </StackPanel>

                                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,4" />

                                <TextBlock Text="Sauvegarde &amp; Diagnostics WinUI 3" FontSize="15" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Exporter les paramètres..." Click="OnExportSettingsClicked" />
                                    <Button Content="Importer des paramètres..." Click="OnImportSettingsClicked" />
                                    <Button Content="Consulter les journaux (WinUI 3)" Click="OnOpenLogsClicked" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- SECTION : Compte & Session -->
                    <StackPanel x:Name="AccountSection" Spacing="20" Visibility="Collapsed">
                        <TextBlock Text="Compte &amp; Session" FontSize="24" FontWeight="SemiBold" />

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Actions de session Diswin" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Vous pouvez vous déconnecter de votre compte Discord ou fermer complètement l'application Diswin (y compris l'icône de la barre des tâches)."
                                           Opacity="0.75" TextWrapping="Wrap" FontSize="13" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Content="Se déconnecter du compte" Background="{ThemeResource SystemFillColorCriticalBrush}"
                                            Foreground="White" Click="OnLogoutClicked" />
                                    <Button Content="Quitter complètement Diswin" Click="OnQuitDiswinClicked" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Diswin — Client WinUI 3 natif 100% C# non officiel, non affilié à Discord Inc." Opacity="0.5" FontSize="11" Margin="0,12,0,0" />
                </StackPanel>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
